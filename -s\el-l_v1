local function renderInventoryGrid(catId)
    gActiveCategory = catId
    
    -- Highlight nút danh mục tương ứng
    for _, item in ipairs(gCatButtons) do
        if item.id == catId then
            item.btn.BackgroundColor3 = Color3.fromRGB(0, 170, 127)
            item.btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            item.btn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
            item.btn.TextColor3 = Color3.fromRGB(150, 150, 150)
        end
    end
    
    -- Xóa lưới cũ
    for _, child in ipairs(GItemScroll:GetChildren()) do
        if child:IsA("ImageButton") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end
    
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local Library = ReplicatedStorage:FindFirstChild("Library")
    if not Library then return end
    
    local Save = require(Library:WaitForChild("Client"):WaitForChild("Save"))
    local Types = require(Library:WaitForChild("Items"):WaitForChild("Types"))
    local RAPCmds = require(Library:WaitForChild("Client"):WaitForChild("RAPCmds"))
    
    -- Xác định nguồn dữ liệu thô từ raw inventory
    local rawCat = catId
    if catId == "Huge" or catId == "Titanic" or catId == "Gargantuan" then
        rawCat = "Pet"
    end
    
    local invData = Save.Get()
    if not invData or not invData.Inventory or not invData.Inventory[rawCat] then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, 0, 0, 40)
        empty.BackgroundTransparency = 1
        empty.Text = "Hòm đồ mục này đang trống."
        empty.TextColor3 = Color3.fromRGB(100, 100, 100)
        empty.TextSize = 11
        empty.Font = Enum.Font.SourceSansItalic
        empty.Parent = GItemScroll
        return
    end
    
    local list = {}
    for uid, itemData in pairs(invData.Inventory[rawCat]) do
        local success, itemObj = pcall(function()
            return Types.From(rawCat, itemData)
        end)
        if success and itemObj then
            local keep = false
            
            -- Phân loại bộ lọc pet nếu rawCat là "Pet"
            if rawCat == "Pet" then
                local isHuge = itemObj.IsHuge and itemObj:IsHuge()
                local isTitanic = itemObj.IsTitanic and itemObj:IsTitanic()
                
                -- Check Gargantuan (thông qua hàm hoặc tên chứa "Gargantuan")
                local isGargantuan = (itemObj.IsGargantuan and itemObj:IsGargantuan()) or 
                                     (itemObj.Gargantuan and itemObj:Gargantuan()) or 
                                     (itemObj:GetName() and tostring(itemObj:GetName()):find("Gargantuan"))
                
                if catId == "Pet" then
                    -- Normal pet: không phải huge, titanic, hay gargantuan
                    if not isHuge and not isTitanic and not isGargantuan then
                        keep = true
                    end
                elseif catId == "Huge" then
                    if isHuge then keep = true end
                elseif catId == "Titanic" then
                    if isTitanic then keep = true end
                elseif catId == "Gargantuan" then
                    if isGargantuan then keep = true end
                end
            else
                -- Các mục Enchant, Potion, Egg...
                keep = true
            end
            
            if keep then
                local iconId = itemObj:GetIcon()
                if iconId then
                    iconId = string.match(iconId, "%d+")
                end
                
                local rapVal = 0
                local getRapSuccess, rapResult = pcall(function()
                    return RAPCmds.Get(itemObj)
                end)
                if getRapSuccess and rapResult then
                    rapVal = rapResult
                end
                
                table.insert(list, {
                    uid = uid,
                    name = itemObj:GetName(),
                    amount = itemObj:GetAmount() or 1,
                    icon = iconId and ("https://www.roblox.com/asset-thumbnail/image?assetId=" .. iconId .. "&width=150&height=150&format=png") or "",
                    rap = rapVal,
                    data = itemData
                })
            end
        end
    end
    
    table.sort(list, function(a, b) return a.rap > b.rap end)
    
    if #list == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, 0, 0, 40)
        empty.BackgroundTransparency = 1
        empty.Text = "Không có vật phẩm tương ứng."
        empty.TextColor3 = Color3.fromRGB(100, 100, 100)
        empty.TextSize = 11
        empty.Font = Enum.Font.SourceSansItalic
        empty.Parent = GItemScroll
        return
    end
    
    local activeBtnStroke = nil
    for idx, item in ipairs(list) do
        local btn = Instance.new("ImageButton")
        btn.Size = UDim2.fromOffset(56, 56)
        btn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
        btn.Image = item.icon
        btn.Parent = GItemScroll
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = btn
        
        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(25, 25, 25)
        stroke.Thickness = 1
        stroke.Parent = btn
        
        if item.amount > 1 then
            local amtText = Instance.new("TextLabel")
            amtText.Size = UDim2.new(0.5, 0, 0.4, 0)
            amtText.Position = UDim2.new(0.5, 0, 0.6, 0)
            amtText.BackgroundTransparency = 1
            amtText.Text = "x" .. item.amount
            amtText.TextColor3 = Color3.fromRGB(255, 255, 255)
            amtText.TextSize = 10
            amtText.Font = Enum.Font.SourceSansBold
            amtText.TextXAlignment = Enum.TextXAlignment.Right
            amtText.TextYAlignment = Enum.TextYAlignment.Bottom
            amtText.Parent = btn
        end
        
        btn.MouseButton1Click:Connect(function()
            if activeBtnStroke then
                activeBtnStroke.Color = Color3.fromRGB(25, 25, 25)
                activeBtnStroke.Thickness = 1
            end
            stroke.Color = Color3.fromRGB(0, 170, 127)
            stroke.Thickness = 2
            activeBtnStroke = stroke
            
            selectedItem = item
            GSelIcon.Image = item.icon
            GSelName.Text = item.name
            local isEng = getgenv().PlazaSellConfig.Language == "English"
            local slText = isEng and "Qty" or "SL"
            GSelRap.Text = "RAP: " .. (item.rap > 0 and formatNumber(item.rap) or "N/A") .. " | " .. slText .. ": " .. formatNumber(item.amount)
            
            local existing = getgenv().PlazaSellConfig.CustomPrices[item.name]
            local existingAmt = getgenv().PlazaSellConfig.CustomQuantities and getgenv().PlazaSellConfig.CustomQuantities[item.name]
            
            if existing then
                GPriceBox.Text = formatNumber(existing)
                if item.rap > 0 then
                    local scale = math.clamp((existing / item.rap - 0.5) / 1.5, 0, 1)
                    GSliderHandle.Position = UDim2.new(scale, -8, 0.5, -8)
                    GSliderValText.Text = string.format("%d%% RAP", math.floor(50 + scale * 150))
                end
            else
                GPriceBox.Text = item.rap > 0 and formatNumber(item.rap) or ""
                GSliderHandle.Position = UDim2.new(0.333, -8, 0.5, -8)
                GSliderValText.Text = "100% RAP"
            end
            
            if existingAmt then
                GAmtBox.Text = tostring(existingAmt)
            else
                GAmtBox.Text = "All"
            end
            
            local existingLimit = getgenv().PlazaSellConfig.CustomListingsLimit and getgenv().PlazaSellConfig.CustomListingsLimit[item.name]
            if existingLimit then
                GLimitBox.Text = tostring(existingLimit)
            else
                GLimitBox.Text = "All"
            end
        end)
    end
    applyTranslations(GItemScroll)
end

