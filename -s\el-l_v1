-- Helper tạo Slider phần trăm
local function createSlider(parent, title, description, minVal, maxVal, configKey, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 56)
    frame.BackgroundTransparency = 1
    frame.Parent = parent
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(0.5, 0, 0, 24)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = title
    textLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
    textLabel.TextSize = 13.5
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.Parent = frame
    
    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0.5, 0, 0, 24)
    valueLabel.Position = UDim2.new(0.5, 0, 0, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.TextColor3 = Color3.fromRGB(0, 170, 127)
    valueLabel.TextSize = 13.5
    valueLabel.Font = Enum.Font.SourceSansBold
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = frame
    
    local descLabel = Instance.new("TextLabel")
    descLabel.Size = UDim2.new(1, 0, 0, 20)
    descLabel.Position = UDim2.new(0, 0, 0, 20)
    descLabel.BackgroundTransparency = 1
    descLabel.Text = description
    descLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
    descLabel.TextSize = 11
    descLabel.Font = Enum.Font.SourceSans
    descLabel.TextXAlignment = Enum.TextXAlignment.Left
    descLabel.Parent = frame
    
    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 6)
    track.Position = UDim2.new(0, 0, 0, 44)
    track.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    track.BorderSizePixel = 0
    track.Parent = frame
    
    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(0.5, 0)
    trackCorner.Parent = track
    
    local handle = Instance.new("TextButton")
    handle.Size = UDim2.new(0, 16, 0, 16)
    handle.BackgroundColor3 = Color3.fromRGB(0, 170, 127)
    handle.Text = ""
    handle.BorderSizePixel = 0
    handle.Parent = track
    
    local handleCorner = Instance.new("UICorner")
    handleCorner.CornerRadius = UDim.new(0.5, 0)
    handleCorner.Parent = handle
    
    local isPercent = (configKey == "RapMultiplier")
    local initialVal = getgenv().PlazaSellConfig[configKey]
    if isPercent then
        initialVal = math.floor(initialVal * 100)
    end
    
    local initialScale = math.clamp((initialVal - minVal) / (maxVal - minVal), 0, 1)
    handle.Position = UDim2.new(initialScale, -8, 0.5, -8)
    valueLabel.Text = isPercent and (tostring(initialVal) .. "%") or tostring(initialVal)
    
    local sliderActive = false
    local function drag(input)
        local relativeX = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        handle.Position = UDim2.new(relativeX, -8, 0.5, -8)
        
        local val = math.floor(minVal + relativeX * (maxVal - minVal))
        valueLabel.Text = isPercent and (tostring(val) .. "%") or tostring(val)
        
        local saveVal = val
        if isPercent then
            saveVal = val / 100
        end
        getgenv().PlazaSellConfig[configKey] = saveVal
        saveConfig()
        if callback then callback(saveVal) end
    end
    
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliderActive = true
        end
    end)
    
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliderActive = true
            drag(input)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliderActive = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if sliderActive and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            drag(input)
        end
    end)
end

