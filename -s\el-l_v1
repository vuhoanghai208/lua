-- Hàm lấy số lượng Kim cương hiện tại của người chơi
-- LUU Y: Diamonds la currency GOC nam o stats.Currency.Diamonds (KHONG nam trong Inventory,
-- va KHONG phai field data.Diamonds truc tiep). Uu tien dung CurrencyCmds.Get("Diamonds").
local function getPlayerDiamonds()
    local success, count = pcall(function()
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local Library = ReplicatedStorage:FindFirstChild("Library")
        if Library then
            local Client = Library:WaitForChild("Client")
            local okCmds, CurrencyCmds = pcall(require, Client:WaitForChild("CurrencyCmds"))
            if okCmds and CurrencyCmds and CurrencyCmds.Get then
                local amt = CurrencyCmds.Get("Diamonds")
                if type(amt) == "number" then return amt end
            end

            local Save = require(Client:WaitForChild("Save"))
            local data = Save.Get()
            if data then
                if data.Currency and type(data.Currency.Diamonds) == "number" then
                    return data.Currency.Diamonds
                elseif data.Diamonds then
                    return data.Diamonds
                end
            end
        end
    end)
    if success and count then return count end
    
    -- Check leaderstats làm phương án dự phòng
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    local diamonds = leaderstats and (leaderstats:FindFirstChild("Diamonds") or leaderstats:FindFirstChild("💎 Diamonds") or leaderstats:FindFirstChild("Gems"))
    if diamonds then
        local val = tostring(diamonds.Value):gsub(",", ""):match("%d+")
        return tonumber(val) or 0
    end
    return 0
end
getgenv().GetPlayerDiamonds = getPlayerDiamonds

-- Hệ thống gom nhóm giao dịch gửi Webhook (Batch Webhook Notification)
local pendingWebhookSales = {}
local isWebhookBatchScheduled = false

local function processBatchWebhook()
    local salesToProcess = pendingWebhookSales
    pendingWebhookSales = {}
    isWebhookBatchScheduled = false
    
    if #salesToProcess == 0 then return end
    
    local config = getgenv().PlazaSellConfig
    if not config then return end
    local webhookURL = config.WebhookURL
    if not webhookURL or webhookURL == "" or not webhookURL:find("https://discord.com/api/webhooks") then return end
    
    pcall(function()
        -- Tổng hợp danh sách vật phẩm & tổng tiền trong đợt này
        local itemSummary = {}
        local grandTotalPrice = 0
        local lastIconUrl = nil
        
        for _, sale in ipairs(salesToProcess) do
            grandTotalPrice = grandTotalPrice + (sale.price or 0)
            if sale.iconUrl and sale.iconUrl ~= "" then
                lastIconUrl = sale.iconUrl
            end
            
            if not itemSummary[sale.itemName] then
                itemSummary[sale.itemName] = {
                    amount = sale.amount or 1,
                    price = sale.price or 0
                }
            else
                itemSummary[sale.itemName].amount = itemSummary[sale.itemName].amount + (sale.amount or 1)
                itemSummary[sale.itemName].price = itemSummary[sale.itemName].price + (sale.price or 0)
            end
        end
        
        local itemListLines = {}
        for name, info in pairs(itemSummary) do
            table.insert(itemListLines, string.format("%s x%d", name, info.amount))
        end
        local nameValueText = table.concat(itemListLines, "\n")
        
        local curDiamonds = getPlayerDiamonds()
        local sold1H = getSalesCount1H()
        local sold24H = getSalesCount24H()
        local gems1H = getGems1H()
        local gems24H = getGems24H()
        
        local isEng = config.Language == "English"
        local titleText = isEng and "Item sold successfully!" or "Vật phẩm đã bán thành công!"
        local nameField = isEng and "Item Name" or "Tên vật phẩm"
        local priceField = isEng and "Sell Price" or "Giá bán"
        local playerField = isEng and "Player" or "Người chơi"
        local gemsOwnedField = isEng and "Gems Owned" or "Kim cương hiện có"
        local amountSoldField = isEng and "Amount Sold" or "Số lượng bán được"
        local gemsEarnedField = isEng and "Gems Earned" or "Kim cương kiếm được"
        
        local gemsValue = isEng and "💎" or "💎"
        local soldSpeed = tostring(sold1H) .. (isEng and " items / hour\n" or " cái / giờ\n") .. tostring(sold24H) .. (isEng and " items / day" or " cái / ngày")
        local gemsSpeed = "+" .. formatNumber(gems1H) .. (isEng and " / hour\n+" or " / giờ\n+") .. formatNumber(gems24H) .. (isEng and " / day" or " / ngày")
        
        local payload = HttpService:JSONEncode({
            embeds = {
                {
                    title = titleText,
                    color = 5814783,
                    fields = {
                        { name = nameField, value = nameValueText, inline = true },
                        { name = priceField, value = formatNumber(grandTotalPrice) .. " " .. (isEng and "Gems" or "Kim cương"), inline = true },
                        { name = playerField, value = LocalPlayer.Name .. " (" .. LocalPlayer.DisplayName .. ")", inline = false },
                        { name = gemsOwnedField, value = formatNumber(curDiamonds) .. " " .. gemsValue, inline = true },
                        { name = amountSoldField, value = soldSpeed, inline = true },
                        { name = gemsEarnedField, value = gemsSpeed, inline = true }
                    },
                    thumbnail = {
                        url = lastIconUrl or getAssetThumbnailUrl(14293722239)
                    },
                    footer = {
                        text = "Auto Sell Plaza Hub | Time: " .. os.date("%H:%M:%S")
                    }
                }
            }
        })
        
        local req = syn and syn.request or http and http.request or http_request or request
        if req then
            req({
                Url = webhookURL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = payload
            })
            print("[WEBHOOK DEBUG] Batched Webhook notification sent successfully!")
        else
            print("[WEBHOOK DEBUG] Executor does not support HTTP requests!")
        end
    end)
end

local function queueSaleForWebhook(itemName, amount, price, iconUrl)
    table.insert(pendingWebhookSales, {
        itemName = itemName,
        amount = amount,
        price = price,
        iconUrl = iconUrl
    })
    
    if not isWebhookBatchScheduled then
        isWebhookBatchScheduled = true
        task.spawn(function()
            task.wait(3) -- Chờ 3 giây gom tất cả các giao dịch bán cùng lúc
            processBatchWebhook()
        end)
    end
end

-- Lắng nghe sự kiện "Booths: Add History" từ game để bắn Discord Webhook
Network.Fired("Booths: Add History"):Connect(function(saleLog)
    print("[WEBHOOK DEBUG] Received Booths: Add History event!")
    local success, err = pcall(function()
        if not saleLog or not getgenv().PlazaSellConfig then 
            print("[WEBHOOK DEBUG] Skipped: saleLog or configuration is empty")
            return 
        end
        
        local Types = require(Library:WaitForChild("Items"):WaitForChild("Types"))
        local received = Types.DecodeUnpacked(saleLog.Received)
        local given = Types.DecodeUnpacked(saleLog.Given)
        
        local price = 0
        local soldItem = nil
        local isSale = true
        
        for _, item in ipairs(received) do
            if item:IsA("Currency") then
                price = math.max(price, item:GetAmount() or 0)
            else
                soldItem = item
                isSale = false -- Chúng ta NHẬN được vật phẩm => Đây là mua (Bought), không phải bán (Sold)!
            end
        end
        
        for _, item in ipairs(given) do
            if item:IsA("Currency") then
                price = math.max(price, item:GetAmount() or 0)
            else
                soldItem = item
                -- isSale giữ nguyên là true vì vật phẩm ở bên GIVEN (Đã cho đi / Đã bán)
            end
        end
        
        if not soldItem then 
            print("[WEBHOOK DEBUG] No sold item found in Given/Received payload")
            return 
        end
        
        if not isSale then
            print("[WEBHOOK DEBUG] Skipped: Transaction is a Purchase, not a Sale")
            return
        end
        
        local itemName = soldItem:GetName()
        local amount = soldItem:GetAmount() or 1
        
        print(string.format("[WEBHOOK DEBUG] Sold: %s x%d for %s Gems", itemName, amount, formatNumber(price)))
        
        -- Cập nhật số lượng quota còn lại khi có giao dịch bán
        -- CHỈ cập nhật CustomQuantities, KHÔNG bao giờ xóa CustomPrices (cấu hình giá vĩnh viễn)
        local config = getgenv().PlazaSellConfig
        if config.CustomQuantities and config.CustomQuantities[itemName] then
            local qty = config.CustomQuantities[itemName]
            if type(qty) == "number" or tonumber(qty) then
                local num = tonumber(qty)
                local newQty = math.max(0, num - amount)
                if newQty <= 0 then
                    -- Đã bán đủ số lượng quota → reset về "All" để lần treo tiếp theo tự động dùng hết
                    config.CustomQuantities[itemName] = "All"
                else
                    config.CustomQuantities[itemName] = newQty
                end
                saveConfig()
            end
        end
        
        -- Ghi nhận giao dịch
        recordSale(itemName, price, amount)
        saveConfig()
        
        -- Invalidate listing cache để bot quét ngay slot vừa trống
        getgenv().PlazaSellListedCache = nil
        if getgenv().PlazaSellSlotCache and getgenv().PlazaSellSlotCache > 0 then
            getgenv().PlazaSellSlotCache = math.max(0, getgenv().PlazaSellSlotCache - 1)
        end
        
        -- Đưa vào hàng đợi gom Webhook
        local iconUrl = nil
        local iconAsset = soldItem:GetIcon()
        if iconAsset then
            iconUrl = getAssetThumbnailUrl(iconAsset)
        end
        if not iconUrl or iconUrl == "" then
            iconUrl = getAssetThumbnailUrl(14293722239)
        end
        
        queueSaleForWebhook(itemName, amount, price, iconUrl)
    end)
    if not success then
        warn("[WEBHOOK ERROR] Error in Booths: Add History listener connection:", err)
    end
end)



-- Hàm lấy ảnh của vật phẩm từ rương đồ hoặc Directory toàn cục bằng tên
local function getItemIconByName(itemName)
    local iconId = nil
    pcall(function()
        local Save = require(Library:WaitForChild("Client"):WaitForChild("Save"))
        local data = Save.Get()
        local Types = require(Library:WaitForChild("Items"):WaitForChild("Types"))
        
        -- 1. Tìm trong rương đồ hiện tại
        if data and data.Inventory then
            for catName, catData in pairs(data.Inventory) do
                for _, itemData in pairs(catData) do
                    local success, itemObj = pcall(function() return Types.From(catName, itemData) end)
                    if success and itemObj then
                        if itemObj:GetName() == itemName then
                            local icon = itemObj:GetIcon()
                            if icon then
                                iconId = string.match(icon, "%d+")
                                if iconId then return end
                            end
                        end
                    end
                end
            end
        end
        
        -- 2. Tìm trong Directory toàn cục
        local Directory = require(Library:WaitForChild("Directory"))
        
        -- Phân tích mã La Mã từ tên vật phẩm để đoán Level/Tier
        local romanToNum = {I=1, II=2, III=3, IV=4, V=5, VI=6, VII=7, VIII=8, IX=9, X=10}
        local parts = string.split(itemName, " ")
        local lastPart = parts[#parts]
        local baseId = itemName
        local tierVal = nil
        if romanToNum[lastPart] then
            tierVal = romanToNum[lastPart]
            table.remove(parts, #parts)
            baseId = table.concat(parts, " ")
        end
        
        for dirName, dirData in pairs(Directory) do
            if type(dirData) == "table" then
                for key, info in pairs(dirData) do
                    if key == baseId or (type(info) == "table" and (info.Name == baseId or info.id == baseId or info.Name == itemName or info.id == itemName)) then
                        local catGuess = dirName
                        if catGuess:sub(-1) == "s" then catGuess = catGuess:sub(1, -2) end
                        
                        local success, itemObj = pcall(function() 
                            return Types.From(catGuess, { id = key, _tier = tierVal, tn = tierVal, tier = tierVal }) 
                        end)
                        if success and itemObj then
                            local icon = itemObj:GetIcon()
                            if icon then
                                iconId = string.match(icon, "%d+")
                                if iconId then return end
                            end
                        end
                    end
                end
            end
        end
    end)
    
    if iconId then
        return "https://www.roblox.com/asset-thumbnail/image?assetId=" .. iconId .. "&width=150&height=150&format=png"
    end
    return ""
end

