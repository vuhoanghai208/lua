local function recordSale(itemName, price, amount)
    local stats = getgenv().PlazaSellStats
    table.insert(stats.SalesLog, {
        timestamp = os.time(),
        name = itemName,
        price = price,
        amount = amount or 1
    })
    
    -- Dọn dẹp log cũ hơn 24 giờ (86400 giây)
    local now = os.time()
    local activeLog = {}
    for _, sale in ipairs(stats.SalesLog) do
        if now - sale.timestamp <= 86400 then
            table.insert(activeLog, sale)
        end
    end
    stats.SalesLog = activeLog
end
getgenv().RecordSale = recordSale

