local function applyTranslations(parent)
    if not parent or not getgenv().PlazaSellConfig then return end
    local isEng = getgenv().PlazaSellConfig.Language == "English"
    local map = isEng and StringMap or ReverseStringMap
    
    local function traverse(obj)
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            local current = obj.Text
            if map[current] then
                obj.Text = map[current]
            else
                for sourceStr, destStr in pairs(map) do
                    if current == sourceStr then
                        obj.Text = destStr
                        break
                    elseif current:find(sourceStr, 1, true) then
                        current = current:gsub(sourceStr, destStr)
                    end
                end
                obj.Text = current
            end
            if obj:IsA("TextBox") and obj.PlaceholderText then
                local ph = obj.PlaceholderText
                if map[ph] then
                    obj.PlaceholderText = map[ph]
                end
            end
        end
        for _, child in ipairs(obj:GetChildren()) do
            traverse(child)
        end
    end
    traverse(parent)
end

