-- 9. VÒNG LẶP AUTO SELL TREO BÁN TỰ ĐỘNG (BACKGROUND AUTO-SELL EXECUTION LOOP)
-- --------------------------------------------------------------------------
local mySession = math.random(100000, 999999)
getgenv().AutoSellSession = mySession
getgenv().PlazaSellItemCooldowns = getgenv().PlazaSellItemCooldowns or {}

local function runAutoSellProcess()
    while true do
        task.wait(10) -- Chạy kiểm tra mỗi 10 giây
        
        -- Dừng luồng cũ nếu phát hiện session mới (khi re-execute script)
        if getgenv().AutoSellSession ~= mySession then
            print("[DEBUG] New script session detected. Stopping previous Auto Sell thread.")
            break
        end
        
        local config = getgenv().PlazaSellConfig
        if config and config.Enabled then
            pcall(function()
                -- 1. Đảm bảo đang ở Trading Plaza
                local isOnPlaza = false
                local ReplicatedStorage = game:GetService("ReplicatedStorage")
                local LibraryInstance = ReplicatedStorage:FindFirstChild("Library")
                if not LibraryInstance then return end
                
                local Client = LibraryInstance:FindFirstChild("Client")
                local TradingPlazaCmds
                local cmdModule = Client and Client:FindFirstChild("TradingPlazaCmds")
                if cmdModule then
                    pcall(function() TradingPlazaCmds = require(cmdModule) end)
                end
                
                if TradingPlazaCmds and TradingPlazaCmds.IsOnTradingPlaza then
                    isOnPlaza = TradingPlazaCmds.IsOnTradingPlaza()
                else
                    isOnPlaza = game.PlaceId == 15502339080 or game.PlaceId == 15588442388 or workspace:FindFirstChild("TradingPlaza") ~= nil
                end
                if not isOnPlaza then return end
                
                -- [1] Kiểm tra Global Player Cooldown TRƯỚC khi làm gì khác (di chuyển lên đầu để tránh spam claim booth)
                local globalCooldown = getgenv().PlazaSellGlobalCooldown
                local globalCooldownDur = getgenv().PlazaSellGlobalCooldownDur or 120
                if globalCooldown then
                    local elapsed = os.time() - globalCooldown
                    if elapsed < globalCooldownDur then
                        -- Không in log mỗi tick để tránh rác console, chỉ khi cooldown kết thúc mới in
                        if elapsed % 30 == 0 or elapsed == 0 then
                            print(string.format("[AUTO SELL] Player cooldown active. Waiting... (%ds / %ds)", elapsed, globalCooldownDur))
                        end
                        return
                    else
                        getgenv().PlazaSellGlobalCooldown = nil
                        getgenv().PlazaSellGlobalCooldownDur = nil
                        getgenv().PlazaSellItemCooldowns = {}
                        getgenv().PlazaSellListedCache = nil
                        print("[AUTO SELL] Player cooldown expired. Resuming operation...")
                    end
                end
                
                -- Hàm tìm và chiếm booth trống tốt nhất (từ ID nhỏ nhất/hàng đầu tiên)
                local function claimBestBooth()
                    local TradingPlaza = workspace:FindFirstChild("TradingPlaza")
                    local BoothSpawns = TradingPlaza and TradingPlaza:FindFirstChild("BoothSpawns")
                    if not BoothSpawns then 
                        print("[DEBUG] Folder BoothSpawns not found in Workspace!")
                        return false, nil 
                    end
                    
                    local candidates = {}
                    for _, child in ipairs(BoothSpawns:GetChildren()) do
                        local idAttr = child:GetAttribute("ID")
                        if idAttr then
                            table.insert(candidates, {
                                model = child,
                                id = idAttr,
                                numId = tonumber(idAttr) or 999
                            })
                        end
                    end
                    
                    print(string.format("[DEBUG] Found %d empty booths on the map.", #candidates))
                    
                    table.sort(candidates, function(a, b)
                        return a.numId < b.numId
                    end)
                    
                    for _, candidate in ipairs(candidates) do
                        if candidate.model.Parent == BoothSpawns then
                            print(string.format("[DEBUG] Attempting to claim Booth ID: %s (Priority: %d)", tostring(candidate.id), candidate.numId))
                            pcall(function()
                                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                                    LocalPlayer.Character:PivotTo(candidate.model:GetPivot() * CFrame.new(0, 2, 0))
                                end
                            end)
                            task.wait(0.2)
                            
                            local success = Network.Invoke("Booths_ClaimBooth", candidate.id)
                            if success then
                                print(string.format("[DEBUG] Successfully claimed Booth ID: %s", tostring(candidate.id)))
                                return true, candidate.id
                            end
                            print(string.format("[DEBUG] Failed to claim Booth ID: %s. Trying next...", tostring(candidate.id)))
                            task.wait(0.1)
                        end
                    end
                    return false, nil
                end

                -- Hàm lấy tất cả UID vật phẩm đang được treo bán tại Booth của mình
                -- forceRefresh = true: buộc fetch từ server dù có cache hay không
                local function getListedUIDs(forceRefresh)
                    local CACHE_TTL = 10 -- số giây giữ cache trước khi refresh (giảm xuống 10s để phát hiện slot bán nhanh hơn)
                    local cache = getgenv().PlazaSellListedCache
                    
                    -- Trả cache nếu còn hạn và không buộc refresh
                    if not forceRefresh and cache and cache.ts and (os.time() - cache.ts) < CACHE_TTL then
                        return cache.listed, cache.count
                    end
                    
                    local listed = {}
                    local states = nil
                    
                    -- Ưu tiên: getsenv (không tốn rate limit)
                    pcall(function()
                        local ReplicatedStorage = game:GetService("ReplicatedStorage")
                        local Library = ReplicatedStorage:FindFirstChild("Library")
                        local Client = Library and Library:FindFirstChild("Client")
                        local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
                        
                        local BoothCmds = (Client and Client:FindFirstChild("BoothCmds")) 
                            or (playerScripts and (playerScripts:FindFirstChild("Booths Frontend", true) or playerScripts:FindFirstChild("BoothCmds", true)))
                            
                        if BoothCmds and getsenv then
                            local env = getsenv(BoothCmds)
                            if env then
                                local getStateFunc = env.getState or env.GetState
                                if type(getStateFunc) == "function" then
                                    local myState = getStateFunc(LocalPlayer)
                                    if not myState and getupvalues then
                                        local upvs = getupvalues(getStateFunc)
                                        if upvs and upvs[1] and type(upvs[1]) == "table" then
                                            myState = upvs[1][LocalPlayer] or upvs[1][LocalPlayer.UserId]
                                        end
                                    end
                                    if myState and myState.Listings then
                                        states = { [LocalPlayer] = myState }
                                    end
                                end
                            end
                        end
                    end)
                    
                    if states and states[LocalPlayer] then
                        local myState = states[LocalPlayer]
                        local count = 0
                        for _, listing in pairs(myState.Listings) do
                            local itemUID = nil
                            if listing.Item then
                                pcall(function() itemUID = listing.Item:GetUID() end)
                                if not itemUID and listing.Item._uid then itemUID = listing.Item._uid end
                                if not itemUID and listing.Item.uid then itemUID = listing.Item.uid end
                            end
                            if not itemUID and listing.ItemData and listing.ItemData.uid then
                                itemUID = listing.ItemData.uid
                            end
                            
                            if itemUID then
                                local amt = 1
                                if listing.Item then
                                    pcall(function() amt = listing.Item:GetAmount() or 1 end)
                                elseif listing.ItemData then
                                    amt = listing.ItemData._am or listing.ItemData.am or 1
                                end
                                listed[itemUID] = (listed[itemUID] or 0) + amt
                                count = count + 1
                            end
                        end
                        -- Cập nhật cache
                        getgenv().PlazaSellListedCache = { listed = listed, count = count, ts = os.time() }
                        return listed, count
                    end
                    
                    -- Fallback: Server Remote (chỉ gọi khi getsenv thất bại)
                    local success, serverStates = pcall(function()
                        return Network.Invoke("Booths_GetInitialState")
                    end)
                    if success and type(serverStates) == "table" then
                        for k, state in pairs(serverStates) do
                            if type(state) == "table" then
                                local isMine = false
                                if tostring(k) == tostring(LocalPlayer.UserId) then isMine = true end
                                
                                local pObj = state.Player or state.Owner or state.player or state.owner
                                if typeof(pObj) == "Instance" and pObj:IsA("Player") and pObj.UserId == LocalPlayer.UserId then
                                    isMine = true
                                end
                                
                                local pId = state.PlayerID or state.PlayerId or state.UserId or state.OwnerId or state.PlayerUserId
                                if pId and tostring(pId) == tostring(LocalPlayer.UserId) then
                                    isMine = true
                                end
                                
                                if isMine and state.Listings then
                                    local count = 0
                                    for _, listing in pairs(state.Listings) do
                                        if listing.ItemData and listing.ItemData.uid then
                                            local amt = listing.ItemData._am or listing.ItemData.am or 1
                                            listed[listing.ItemData.uid] = (listed[listing.ItemData.uid] or 0) + amt
                                            count = count + 1
                                        end
                                    end
                                    getgenv().PlazaSellListedCache = { listed = listed, count = count, ts = os.time() }
                                    getgenv().PlazaSellLastStateCall = os.time()
                                    return listed, count
                                end
                            end
                        end
                    end
                    return listed, 0
                end

                -- 2. Đảm bảo đã chiếm booth
                local myBooth = nil
                pcall(function()
                    local activeModel = Signal.Invoke("Booths_GetActiveModel")
                    if activeModel then
                        myBooth = activeModel
                    end
                end)
                
                -- Kiểm tra trực tiếp workspace.__THINGS.Booths (Model quầy đã claim của nhân vật) - 0% tốn Network
                if not myBooth then
                    pcall(function()
                        local things = workspace:FindFirstChild("__THINGS")
                        local boothsFolder = things and things:FindFirstChild("Booths")
                        if boothsFolder then
                            for _, boothModel in ipairs(boothsFolder:GetChildren()) do
                                local ownerId = boothModel:GetAttribute("Owner")
                                if ownerId and tostring(ownerId) == tostring(LocalPlayer.UserId) then
                                    myBooth = boothModel
                                    print("[DEBUG] Found existing booth ownership via workspace.__THINGS.Booths.")
                                    break
                                end
                            end
                        end
                    end)
                end
                
                if not myBooth then
                    print("[AUTO SELL] Finding and claiming the best empty booth...")
                    local claimed, boothId = claimBestBooth()
                    if claimed then
                        print("[AUTO SELL] Successfully claimed Booth ID:", boothId)
                        getgenv().PlazaSellFreshClaimTime = os.time()
                        getgenv().PlazaSellGlobalCooldown = nil
                        getgenv().PlazaSellGlobalCooldownDur = nil -- Reset backoff
                        getgenv().PlazaSellItemCooldowns = {}
                        getgenv().PlazaSellListedCache = { listed = {}, count = 0, ts = os.time() }
                        getgenv().PlazaSellSlotCache = 0
                        task.wait(3.0) -- Chờ server settle sau claim
                    else
                        print("[AUTO SELL] Could not claim a booth (Server cooldown or rate limit active). Retrying in 30s...")
                        getgenv().PlazaSellGlobalCooldown = os.time()
                        getgenv().PlazaSellGlobalCooldownDur = 30
                        return -- DỪNG LẠI, KHÔNG tiếp tục treo đồ khi chưa có quầy!
                    end
                end
                
                -- 3. Quét rương đồ và tự động treo bán các vật phẩm trong cấu hình
                local tickQuotas = {}
                for name, qty in pairs(config.CustomQuantities) do
                    tickQuotas[name] = qty
                end
                
                local Save = require(LibraryInstance:WaitForChild("Client"):WaitForChild("Save"))
                local Types = require(LibraryInstance:WaitForChild("Items"):WaitForChild("Types"))
                local RAPCmds = nil
                pcall(function() RAPCmds = require(LibraryInstance:WaitForChild("Client"):WaitForChild("RAPCmds")) end)
                local data = Save.Get()
                if not data or not data.Inventory then return end
                
                -- Lấy danh sách vật phẩm đã treo bán (dùng cache, tránh spam Booths_GetInitialState mỗi tick)
                local listedUIDs, listedCount = getListedUIDs(false)
                -- Cập nhật SlotCache trực tiếp theo thực tế
                getgenv().PlazaSellSlotCache = listedCount
                
                -- Booth đã đầy → skip toàn bộ scan, không in summary table
                local maxSlots = config.MaxSlots or 25
                if listedCount >= maxSlots then
                    -- In 1 dòng mỗi 60s thay vì mỗi 10s
                    local lastFullLog = getgenv().PlazaSellLastFullLog or 0
                    if os.time() - lastFullLog >= 60 then
                        print(string.format("[AUTO SELL] Booth full (%d/%d). Monitoring for sold slots...", listedCount, maxSlots))
                        getgenv().PlazaSellLastFullLog = os.time()
                    end
                    return
                end
                
                local qualifiedQueue = {}
                local scanStats = { total = 0, locked = 0, noPrice = 0, cooldown = 0, alreadyListed = 0, limitReached = 0 }
                
                for catName, catData in pairs(data.Inventory) do
                    for uid, itemData in pairs(catData) do
                        if not getgenv().PlazaSellConfig.Enabled then return end
                        
                        local success, itemObj = pcall(function() return Types.From(catName, itemData) end)
                        if success and itemObj then
                            local isLocked = false
                            pcall(function() isLocked = itemObj:IsLocked() end)
                            
                            if isLocked then
                                scanStats.locked = scanStats.locked + 1
                            else
                                local itemName = itemObj:GetName()
                                local priceSource = "Custom"
                                scanStats.total = scanStats.total + 1
                                
                                local sellPrice = config.CustomPrices[itemName]
                                if not sellPrice or sellPrice <= 0 then
                                    local noShiny = itemName:gsub("^Shiny%s+", "")
                                    sellPrice = config.CustomPrices[noShiny]
                                end
                                if not sellPrice or sellPrice <= 0 then
                                    local baseName = nil
                                    pcall(function() baseName = itemObj:Directory().name end)
                                    if baseName then 
                                        sellPrice = config.CustomPrices[baseName]
                                        if not sellPrice or sellPrice <= 0 then
                                            local isGold = false
                                            local isRb = false
                                            pcall(function() isGold = itemObj:IsGolden() end)
                                            pcall(function() isRb = itemObj:IsRainbow() end)
                                            if isGold then
                                                sellPrice = config.CustomPrices["Golden " .. baseName]
                                            elseif isRb then
                                                sellPrice = config.CustomPrices["Rainbow " .. baseName]
                                            end
                                        end
                                    end
                                end
                                
                                local limitVal = config.CustomListingsLimit and (config.CustomListingsLimit[itemName] or config.CustomListingsLimit[itemName:gsub("^Shiny%s+", "")]) or "All"
                                local targetQty = tickQuotas[itemName] or tickQuotas[itemName:gsub("^Shiny%s+", "")] or "All"
                                local isStackableItem = not (catName == "Pet" or catName == "Hoverboard" or catName == "Booth")
                                -- maxSlots: targetQty=All → fill toàn bộ slot còn trống (burst mode)
                                --           targetQty=N   → ceil(N/50000) slots
                                local maxSlotsForItem
                                if not isStackableItem then
                                    maxSlotsForItem = 1 -- pet/hoverboard luôn 1 slot
                                elseif targetQty == "All" then
                                    maxSlotsForItem = (config.MaxSlots or 25) - listedCount -- tất cả slot còn lại
                                else
                                    local qtyNum = tonumber(targetQty) or 0
                                    maxSlotsForItem = math.max(1, math.ceil(qtyNum / 50000))
                                end
                                
                                if not sellPrice or sellPrice <= 0 then
                                    local itemCategory = catName
                                    if catName == "Pet" then
                                        if itemObj.IsHuge and itemObj:IsHuge() then itemCategory = "Huge"
                                        elseif itemObj.IsTitanic and itemObj:IsTitanic() then itemCategory = "Titanic"
                                        elseif (itemObj.IsGargantuan and itemObj:IsGargantuan()) or (itemObj.Gargantuan and itemObj:Gargantuan()) or (itemName and tostring(itemName):find("Gargantuan")) then itemCategory = "Gargantuan"
                                        end
                                    end
                                    local rule = config.CategoryRules and config.CategoryRules[itemCategory]
                                    if rule and rule.Mode ~= "Disabled" then
                                        if rule.Mode == "Fixed" then
                                            sellPrice = tonumber(rule.Price) or 0
                                            priceSource = "Category (Fixed)"
                                        elseif rule.Mode == "RAP" then
                                            local RAPCmds = require(LibraryInstance:WaitForChild("Client"):WaitForChild("RAPCmds"))
                                            local rapSuccess, rapResult = pcall(function() return RAPCmds.Get(itemObj) end)
                                            if rapSuccess and type(rapResult) == "number" and rapResult > 0 then
                                                local pct = tonumber(rule.Percent) or 0
                                                sellPrice = math.floor(rapResult * (1 + pct / 100))
                                                priceSource = string.format("RAP (%+d%%)", pct)
                                            end
                                        end
                                    end
                                end
                                
                                if sellPrice and sellPrice > 0 then
                                    local totalAmtInInv = itemObj:GetAmount() or 1
                                    local alreadyListedAmt = listedUIDs[uid] or 0
                                    local itemCooldowns = getgenv().PlazaSellItemCooldowns
                                    local isCoolingDown = itemCooldowns[uid] and (os.time() - itemCooldowns[uid]) < 60
                                    local isLimitReached = limitVal ~= "All" and (tonumber(limitVal) or 0) <= 0
                                    local isAlreadyListed = (not isStackableItem and alreadyListedAmt > 0) or (isStackableItem and alreadyListedAmt >= totalAmtInInv)
                                    
                                    if not isCoolingDown and not isLimitReached and not isAlreadyListed then
                                        local remInv = totalAmtInInv - alreadyListedAmt
                                        table.insert(qualifiedQueue, {
                                            cat = catName,
                                            name = itemName,
                                            price = sellPrice,
                                            priceSource = priceSource,
                                            amt = remInv,
                                            uid = uid,
                                            limitVal = limitVal,
                                            targetQty = targetQty,
                                            maxSlots = maxSlotsForItem,
                                            isStackable = isStackableItem
                                        })
                                    elseif isCoolingDown then
                                        scanStats.cooldown = scanStats.cooldown + 1
                                    elseif isLimitReached then
                                        scanStats.limitReached = scanStats.limitReached + 1
                                    elseif isAlreadyListed then
                                        scanStats.alreadyListed = scanStats.alreadyListed + 1
                                    end
                                else
                                    scanStats.noPrice = scanStats.noPrice + 1
                                end
                            end
                        end
                    end
                end
                
                -- Cooldown check moved to the top of the loop
                
                -- [2] In Bảng Thống Kê Debug (chỉ khi không trong cooldown)
                if #qualifiedQueue > 0 then
                    print("\n======================================== [AUTO SELL SUMMARY] ========================================")
                    print(string.format("Booth Slots Used: %d/%d | Qualified Items to List: %d", listedCount, config.MaxSlots or 25, #qualifiedQueue))
                    print("--------------------------------------------------------------------------------------------------------------------------------------")
                    print(string.format("%-4s | %-12s | %-30s | %-10s | %-14s | %-10s | %-9s | %-15s",
                        "STT", "Loại", "Tên Vật Phẩm", "Giá Bán", "Tổng Kho", "Qty/Slot", "MaxSlots", "Nguồn Giá"))
                    print("--------------------------------------------------------------------------------------------------------------------------------------")
                    for idx, item in ipairs(qualifiedQueue) do
                        local qtyPerSlot = item.amt
                        if item.targetQty ~= "All" then
                            qtyPerSlot = math.min(item.amt, tonumber(item.targetQty) or item.amt)
                        end
                        qtyPerSlot = math.min(qtyPerSlot, 50000)
                        local maxSlotsStr = item.isStackable and tostring(item.maxSlots or 1) or "1 (pet)"
                        local targetQtyStr = item.targetQty == "All" and "All" or tostring(item.targetQty)
                        print(string.format("%-4d | %-12s | %-30s | %-10s | %-14s | %-10s | %-9s | %-15s",
                            idx, tostring(item.cat):sub(1, 12), tostring(item.name):sub(1, 30),
                            formatNumber(item.price),
                            string.format("%s (quota:%s)", formatNumber(item.amt), targetQtyStr),
                            formatNumber(qtyPerSlot), maxSlotsStr, tostring(item.priceSource)))
                    end
                    print("============================================================================================================\n")
                else
                    print(string.format(
                        "[AUTO SELL] Tick scan: 0 qualify | Scanned=%d | NoPrice=%d | Locked=%d | Cooldown=%d | AlreadyListed=%d | LimitReached=%d | Booth=%d/%d",
                        scanStats.total, scanStats.noPrice, scanStats.locked,
                        scanStats.cooldown, scanStats.alreadyListed, scanStats.limitReached,
                        listedCount, config.MaxSlots or 25
                    ))
                end
                
                -- Enforce gap tối thiểu 4s giữa Booths_GetInitialState và Booths_CreateListing
                local lastStateCall = getgenv().PlazaSellLastStateCall
                if lastStateCall then
                    local gap = os.time() - lastStateCall
                    if gap < 4 then
                        print(string.format("[AUTO SELL] Waiting %ds after GetInitialState before listing...", 4 - gap))
                        task.wait(4 - gap)
                    end
                    getgenv().PlazaSellLastStateCall = nil -- xóa sau khi đã enforce
                end
                
                -- Thực hiện đăng bán lần lượt các item trong Queue
                local globalCooldownTriggered = false
                local listedCountBeforeTick = listedCount -- Snapshot trước tick để detect "chưa list được gì"
                for _, item in ipairs(qualifiedQueue) do
                    if not getgenv().PlazaSellConfig.Enabled then break end
                    if listedCount >= (config.MaxSlots or 25) then
                        print(string.format("[DEBUG] Booth slots filled up (%d/%d). Stopping execution.", listedCount, config.MaxSlots or 25))
                        break
                    end
                    
                    local remainingInventory = item.amt
                    local uid = item.uid
                    local itemName = item.name
                    local sellPrice = item.price
                    local limitVal = item.limitVal
                    local targetQty = item.targetQty
                    
                    local slotsUsedForItem = 0
                    while remainingInventory > 0 and getgenv().PlazaSellConfig.Enabled do
                        if listedCount >= (config.MaxSlots or 25) then break end
                        if targetQty ~= "All" and (tonumber(targetQty) or 0) <= 0 then break end
                        -- Giới hạn số slot cho stackable item (tránh spam slot)
                        if item.isStackable and slotsUsedForItem >= (item.maxSlots or 1) then break end
                        
                        local sellAmt = remainingInventory
                        if targetQty ~= "All" then
                            sellAmt = math.min(remainingInventory, tonumber(targetQty) or 1)
                        end
                        sellAmt = math.min(sellAmt, 50000)
                        if sellAmt <= 0 then break end
                        
                        local listSuccess, errMsg = Network.Invoke("Booths_CreateListing", uid, sellPrice, sellAmt)
                        if listSuccess then
                            print(string.format("[AUTO SELL SUCCESS] Listed: %s x%d for %s Gems (%s)", itemName, sellAmt, formatNumber(sellPrice), item.priceSource))
                            remainingInventory = remainingInventory - sellAmt
                            listedCount = listedCount + 1
                            slotsUsedForItem = slotsUsedForItem + 1
                            getgenv().PlazaSellSlotCache = listedCount -- Sync cache tick
                            listedUIDs[uid] = (listedUIDs[uid] or 0) + sellAmt
                            
                            if limitVal ~= "All" then
                                local curLimit = tonumber(limitVal) or 1
                                local newLimit = math.max(0, curLimit - 1)
                                config.CustomListingsLimit[itemName] = newLimit
                                saveConfig()
                                limitVal = newLimit
                            end
                            if limitVal ~= "All" and limitVal <= 0 then break end
                            
                            if targetQty ~= "All" then
                                local curLimit = tonumber(targetQty) or 1
                                local newLimit = math.max(0, curLimit - sellAmt)
                                if newLimit <= 0 then
                                    tickQuotas[itemName] = nil
                                    config.CustomQuantities[itemName] = "All"
                                    saveConfig()
                                    break
                                else
                                    tickQuotas[itemName] = newLimit
                                    config.CustomQuantities[itemName] = newLimit
                                    saveConfig()
                                end
                            end
                            task.wait(2.5) -- 2.5s giữa các listing (an toàn hơn 2s, rate limit ~17 calls/36s)
                        else
                            print(string.format("[AUTO SELL ERROR] Listing failed for %s: %s", itemName, tostring(errMsg)))
                            local errStr = tostring(errMsg):lower()
                            if errStr:find("slot") or errStr:find("full") or errStr:find("limit") or errStr:find("no empty") then
                                listedCount = config.MaxSlots or 25
                                break
                            elseif errStr:find("fast") or errStr:find("too") then
                                -- "too fast" = rate limit tạm thời trong burst → chờ 8s rồi tiếp tục (không set global cooldown)
                                print(string.format("[AUTO SELL] Rate limit hit after %d listings. Pausing 8s...", listedCount - listedCountBeforeTick))
                                task.wait(8.0)
                                break -- kết thúc tick này, tick tiếp thử lại
                            elseif errStr:find("cooldown") or errStr:find("wait") then
                                -- "cooldown" = server block dài → chỉ global cooldown nếu chưa list được gì
                                if listedCount == listedCountBeforeTick then
                                    -- Backoff: 120 → 240 → 300s max
                                    local prevDur = getgenv().PlazaSellGlobalCooldownDur or 60
                                    local nextDur = math.min(prevDur * 2, 300)
                                    getgenv().PlazaSellGlobalCooldown = os.time()
                                    getgenv().PlazaSellGlobalCooldownDur = nextDur
                                    print(string.format("[AUTO SELL] Server cooldown! Waiting %ds (backoff)...", nextDur))
                                    globalCooldownTriggered = true
                                    break
                                else
                                    -- Đã list được item khác → per-UID cache
                                    getgenv().PlazaSellItemCooldowns[uid] = os.time()
                                    print(string.format("[AUTO SELL] Per-item cooldown for %s.", itemName))
                                    task.wait(3.0)
                                end
                                break
                            end
                            getgenv().PlazaSellItemCooldowns[uid] = os.time()
                            break
                        end
                    end
                    if globalCooldownTriggered then break end
                end
            end)
        end
    end
end

task.spawn(runAutoSellProcess)

-- 10. THÔNG BÁO HOÀN TẤT
showNotification("Giao Diện Hoạt Động", "Click nút giỏ hàng hoặc nhấn Left Control để ẩn/hiện.")
