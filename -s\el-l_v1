local CONFIG_FILE = "PlazaSellConfig.json"

local function saveConfig()
    local success, err = pcall(function()
        if writefile then
            local data = HttpService:JSONEncode(getgenv().PlazaSellConfig)
            writefile(CONFIG_FILE, data)
            print("[CONFIG] Configuration successfully saved to " .. CONFIG_FILE)
        end
    end)
    if not success then
        warn("[CONFIG] Error saving configuration:", err)
    end
end

local function loadConfig()
    local success, data = pcall(function()
        if isfile and readfile and isfile(CONFIG_FILE) then
            return readfile(CONFIG_FILE)
        end
    end)
    if success and data then
        local decoded = HttpService:JSONDecode(data)
        if decoded then
            for k, v in pairs(decoded) do
                getgenv().PlazaSellConfig[k] = v
            end
            print("[CONFIG] Configuration loaded successfully from " .. CONFIG_FILE)
        end
    end
end

