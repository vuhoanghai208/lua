-- 3. Các hàm bổ trợ xử lý số
local function parseNumber(str)
    if not str or str == "" then return nil end
    str = str:lower():gsub("%s+", ""):gsub(",", "")
    local multiplier = 1
    if str:find("k$") then
        multiplier = 1e3
        str = str:sub(1, -2)
    elseif str:find("m$") then
        multiplier = 1e6
        str = str:sub(1, -2)
    elseif str:find("b$") then
        multiplier = 1e9
        str = str:sub(1, -2)
    elseif str:find("t$") then
        multiplier = 1e12
        str = str:sub(1, -2)
    end
    local num = tonumber(str)
    return num and math.floor(num * multiplier) or nil
end

local function formatNumber(num)
    if not num then return "" end
    if num >= 1e12 then
        return string.format("%.2ft", num / 1e12):gsub("%.00t", "t"):gsub("%.([0-9])0t", ".%1t")
    elseif num >= 1e9 then
        return string.format("%.2fb", num / 1e9):gsub("%.00b", "b"):gsub("%.([0-9])0b", ".%1b")
    elseif num >= 1e6 then
        return string.format("%.2fm", num / 1e6):gsub("%.00m", "m"):gsub("%.([0-9])0m", ".%1m")
    elseif num >= 1e3 then
        return string.format("%.2fk", num / 1e3):gsub("%.00k", "k"):gsub("%.([0-9])0k", ".%1k")
    end
    return tostring(num)
end

