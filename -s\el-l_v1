local function checkAndTeleport()
    local config = getgenv().PlazaSellConfig
    if not config or not config.Enabled or not config.AutoTeleport then return end
    
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local LibraryInstance = ReplicatedStorage:FindFirstChild("Library")
    if not LibraryInstance then return end
    
    local TradingPlazaCmds, PlaceFile
    
    -- Nạp TradingPlazaCmds
    local client = LibraryInstance:FindFirstChild("Client")
    local cmdModule = client and client:FindFirstChild("TradingPlazaCmds")
    if cmdModule then
        pcall(function() TradingPlazaCmds = require(cmdModule) end)
    end
    
    -- Nạp PlaceFile
    local modules = LibraryInstance:FindFirstChild("Modules")
    local fileModule = modules and modules:FindFirstChild("PlaceFile")
    if fileModule then
        pcall(function() PlaceFile = require(fileModule) end)
    end
    
    -- Kiểm tra trạng thái hiện tại
    local isOnPlaza = false
    if TradingPlazaCmds and TradingPlazaCmds.IsOnTradingPlaza then
        isOnPlaza = TradingPlazaCmds.IsOnTradingPlaza()
    else
        isOnPlaza = game.PlaceId == 15502339080 or game.PlaceId == 15588442388 or workspace:FindFirstChild("TradingPlaza") ~= nil
    end
    
    if not isOnPlaza then
        print("[TELEPORT] Main world detected. Proceeding to teleport...")
        local targetPlaceId
        local selection = config.PlazaType
        
        local normalId = 15502339080
        local proId = 15588442388
        
        if PlaceFile and PlaceFile.LocalPlaces then
            normalId = PlaceFile.LocalPlaces.Trading or normalId
            proId = PlaceFile.LocalPlaces.ProTrading or proId
        end
        
        if selection == "Normal Plaza" then
            targetPlaceId = normalId
        elseif selection == "Pro Plaza" then
            targetPlaceId = proId
        else -- Auto Select
            if TradingPlazaCmds and TradingPlazaCmds.GetAvailable then
                local av = TradingPlazaCmds.GetAvailable()
                if av and #av > 0 then
                    targetPlaceId = av[1].PlaceId
                end
            end
            if not targetPlaceId then targetPlaceId = normalId end
        end
        
        if targetPlaceId then
            task.wait(1)
            if TradingPlazaCmds and TradingPlazaCmds.RequestTradingPlaza then
                TradingPlazaCmds.RequestTradingPlaza(targetPlaceId)
            else
                pcall(function()
                    game:GetService("TeleportService"):Teleport(targetPlaceId, LocalPlayer)
                end)
            end
        end
    end
end

local function serverHop()
    local config = getgenv().PlazaSellConfig
    if not config or not config.AutoHop then return end
    print("[SYSTEM] Attempting to Auto Server Hop...")
    
    local targetPlaceId = game.PlaceId
    if config.PlazaType == "Normal Plaza" then targetPlaceId = 15502339080
    elseif config.PlazaType == "Pro Plaza" then targetPlaceId = 15588442388 end
    
    local servers = {}
    local req = syn and syn.request or http and http.request or http_request or request
    if req then
        local success, res = pcall(function()
            return req({
                Url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100", targetPlaceId),
                Method = "GET"
            })
        end)
        if success and res.Body then
            local decoded = HttpService:JSONDecode(res.Body)
            if decoded and decoded.data then
                for _, srv in ipairs(decoded.data) do
                    if srv.playing and srv.maxPlayers and srv.playing < srv.maxPlayers - 2 and srv.id ~= game.JobId then
                        table.insert(servers, srv)
                    end
                end
            end
        end
    end
    
    if #servers > 0 then
        local target = servers[math.random(1, #servers)]
        print("[SYSTEM] Hopping to server:", target.id)
        game:GetService("TeleportService"):TeleportToPlaceInstance(targetPlaceId, target.id, LocalPlayer)
    else
        print("[SYSTEM] No suitable servers found. Rejoining random server...")
        game:GetService("TeleportService"):Teleport(targetPlaceId, LocalPlayer)
    end
end
getgenv().ServerHop = serverHop

local function checkRAM()
    local config = getgenv().PlazaSellConfig
    if not config then return end
    
    local ramMB = math.floor(game:GetService("Stats"):GetTotalMemoryUsageMb())
    local threshold = tonumber(config.AutoRejoinRAM) or 4000
    if ramMB >= threshold then
        print(string.format("[SYSTEM] RAM Warning: %d MB exceeded threshold %d MB. Hopping server...", ramMB, threshold))
        serverHop()
        task.wait(10)
    end
end

-- Lưu thời gian bắt đầu script
getgenv().PlazaSellScriptStartTime = getgenv().PlazaSellScriptStartTime or os.time()

local function checkRejoinTimer()
    local config = getgenv().PlazaSellConfig
    if not config then return end
    
    local maxTime = tonumber(config.AutoRejoinTime) or 0
    if maxTime > 0 then
        local elapsed = os.time() - getgenv().PlazaSellScriptStartTime
        if elapsed >= maxTime then
            print(string.format("[SYSTEM] Time Warning: %d seconds elapsed, reached threshold %d seconds. Hopping server...", elapsed, maxTime))
            -- Đặt lại timer để tránh kẹt nếu hop lỗi
            getgenv().PlazaSellScriptStartTime = os.time()
            serverHop()
            task.wait(10)
        end
    end
end

local function checkServerPop()
    local config = getgenv().PlazaSellConfig
    if not config or not config.AutoHop then return end
    
    local minPlayers = tonumber(config.MinPlayers) or 5
    if #Players:GetPlayers() <= minPlayers then
        print("[SYSTEM] Server population too low. Hopping server...")
        serverHop()
        task.wait(10)
    end
end

