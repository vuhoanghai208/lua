-- Kéo thả Slider tỷ lệ RAP
local gSliderActive = false
local function updateGSlider(input)
    local relativeX = math.clamp((input.Position.X - GSliderTrack.AbsolutePosition.X) / GSliderTrack.AbsoluteSize.X, 0, 1)
    GSliderHandle.Position = UDim2.new(relativeX, -6, 0.5, -6)
    
    local pct = math.floor(50 + relativeX * 150)
    GSliderValText.Text = string.format("%d%% RAP", pct)
    
    if selectedItem and selectedItem.rap and selectedItem.rap > 0 then
        local calc = math.floor(selectedItem.rap * (pct / 100))
        GPriceBox.Text = formatNumber(calc)
    end
end

GSliderHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        gSliderActive = true
    end
end)

GSliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        gSliderActive = true
        updateGSlider(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        gSliderActive = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if gSliderActive and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateGSlider(input)
    end
end)

