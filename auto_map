            end
        end)
        if kaitunLabels.Zone then
            kaitunLabels.Zone.Text = "Current Zone: " .. tostring(currentZone)
        end

        -- 5. Status
        if kaitunLabels.Status then
            kaitunLabels.Status.Text = "Status: " .. tostring(currentStatusText)
        end
    end)
end

