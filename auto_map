        -- 1. Gather registered upgrades from UpgradeCmds.All()
        if successUpg and UpgradeCmds and UpgradeCmds.All then
            local allUpgrades = UpgradeCmds.All()
            if type(allUpgrades) == "table" then
                for _, info in pairs(allUpgrades) do
                    if type(info) == "table" and info.UpgradeID and info.ZoneID then
                        table.insert(upgradeMap, { upgID = info.UpgradeID, zoneID = info.ZoneID, model = info.Model })
                    end
                end
            end
        end

        -- 2. Gather physical machine models from workspace Map folders (Map, Map2, Map3, Map4, etc.)
        for _, mapFolder in ipairs(workspace:GetChildren()) do
            if mapFolder.Name == "Map" or string.find(mapFolder.Name, "Map", 1, true) then
                for _, zoneFolder in ipairs(mapFolder:GetChildren()) do
                    local interact = zoneFolder:FindFirstChild("INTERACT")
                    if interact then
                        for _, child in ipairs(interact:GetChildren()) do
                            local isValid = false
                            pcall(function()
                                if Directory and Directory.Upgrades and Directory.Upgrades[child.Name] ~= nil then
                                    isValid = true
                                end
                            end)
                            if isValid then
                                table.insert(upgradeMap, { upgID = child.Name, zoneID = zoneFolder.Name, model = child })
                            end
                        end
                    end
                end
            end
        end

        local purchasedAny = false

        for _, upgData in ipairs(upgradeMap) do
            local upgID = upgData.upgID
            local zoneID = upgData.zoneID
            local model = upgData.model

            local isOwned = false
            pcall(function() isOwned = UpgradeCmds.Owns(upgID, zoneID) end)

            if not isOwned then
                pcall(function()
                    local attempt = 0
                    while attempt < 10 do
                        attempt = attempt + 1
                        local isNowOwned = false
                        pcall(function() isNowOwned = UpgradeCmds.Owns(upgID, zoneID) end)
                        if isNowOwned then break end

                        local res = false
                        pcall(function() res = UpgradeCmds.Purchase(upgID, zoneID) end)
                        if not res then
                            pcall(function() res = Network.Invoke("Upgrades_Purchase", upgID, zoneID) end)
                        end

                        if res then
                            purchasedAny = true
                            print(string.format("[MapAuto::Upgrades] Purchased tier %d upgrade '%s' at zone '%s'.", attempt, tostring(upgID), tostring(zoneID)))
                            task.wait(0.2)
                        else
                            break
                        end
                    end
                end)
            end
        end
    end)
end

