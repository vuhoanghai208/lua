-- 10D. Auto Shiny Relic Collector (Auto Claim All Uncollected Shiny Relics)
-- ----------------------------------------------------------------------------
local ShinyRelicManager = {}
local lastRelicCheckTime = 0

function ShinyRelicManager.Step()
    if getgenv().MapAutoConfig.AutoShinyRelics == false then return end
    if os.clock() - lastRelicCheckTime < 60 then return end
    lastRelicCheckTime = os.clock()

    task.spawn(function()
        pcall(function()
            -- Relics_Request trả về array: { { Id = <number>, Position = CFrame, ... }, ... }
            local allRelics = nil
            pcall(function() allRelics = Network.Invoke("Relics_Request") end)
            if not allRelics or type(allRelics) ~= "table" then return end

            local saveData = Save.Get()
            -- saveData.ShinyRelics = array of numbers (integer relic IDs already owned)
            local ownedSet = {}
            for _, id in ipairs((saveData and saveData.ShinyRelics) or {}) do
                ownedSet[id] = true -- key là số nguyên
            end

            local uncollectedList = {}
            for _, relicData in pairs(allRelics) do
