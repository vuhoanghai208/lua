local FarmManager = {}
local lastFarmDebugTime = 0

-- [FIX-2] Cache modules một lần thay vì LoadModule (30s WaitForChild) mỗi 0.3s.
-- Module game không bị destroy khi teleport cùng place → cache an toàn.
local farmModules = { ZoneCmds = nil, PlayerPet = nil }
local farmModulesLoaded = false
local function FarmEnsureModules()
    if farmModulesLoaded then return end
    farmModules.ZoneCmds = LoadModule(Client, "ZoneCmds")
    farmModules.PlayerPet = LoadModule(Client, "PlayerPet")
    farmModulesLoaded = true
end

-- [FIX-3] Signature ổn định của bãi đào: chỉ fire Breakables_JoinPetBulk khi
-- target set thay đổi (hoặc refresh định kỳ 2.5s để bắt pet mới hatch).
local lastPetBulkSignature = ""
local lastPetBulkFire = 0
local function BreakablesSignature(list)
    local parts = {}
    for _, b in ipairs(list) do
        if b and b.uid then table.insert(parts, tostring(b.uid)) end
    end
    table.sort(parts)
    return table.concat(parts, ",")
end

function FarmManager.Step()
    if not getgenv().MapAutoConfig.AutoFarmBestZone then return end

    FarmEnsureModules()
    if not farmModules.ZoneCmds then return end

    local zoneName = GetBestFarmingZone()
    if not zoneName then return end

    -- [FIX-1] Tự canh vị trí mỗi step (giống test_farm.lua:468).
    -- Không còn phụ thuộc Tether (>35 studs) → không bao giờ farm sai zone / đứng im.
    -- FastTeleportToZoneCenter tự guard: bỏ qua nếu đang teleport, không snap nếu dist <= 20,
    -- chỉ gọi Teleports_RequestTeleport khi zone chưa stream (rồi cache lastStreamedZone).
    FastTeleportToZoneCenter(zoneName)

    local breakables = GetBreakableList(zoneName)
    if not breakables or #breakables == 0 then return end

    -- [FIX-5] Sắp xếp deterministic theo uid: thứ tự pairs() không ổn định
    -- → target "đầu tiên" cố định giữa các step, damage/pet dồn đúng chỗ.
    table.sort(breakables, function(a, b) return tostring(a.uid) < tostring(b.uid) end)

    -- [FIX-6] Range guard: không bắn damage khi char chưa tới bãi đào
    -- (FastTeleportToZoneCenter đã snap nếu dist>20; nếu vẫn lệch >40 thì chờ thêm)
    local root = LocalPlayer.Character and LocalPlayer.Character.PrimaryPart
    local targetPos = zoneFieldPositionCache[zoneName]
    if root and targetPos and (root.Position - targetPos).Magnitude > 40 then return end

    local now = os.clock()

    if _G.SetMapAutoStatus then
        _G.SetMapAutoStatus(string.format("[Farm] Engaging %d breakables in '%s'...", #breakables, tostring(zoneName)), Color3.fromRGB(0, 255, 170))
    end

    -- 1. Active Pet Swarm Dispatcher (chỉ fire khi target set thay đổi / refresh định kỳ)
    local sig = BreakablesSignature(breakables)
    if sig ~= lastPetBulkSignature or (now - lastPetBulkFire) > 2.5 then
        pcall(function()
            local PlayerPetMod = farmModules.PlayerPet
            local pets = (PlayerPetMod and PlayerPetMod.GetByPlayer and PlayerPetMod.GetByPlayer(LocalPlayer))
            if pets and #pets > 0 and #breakables > 0 then
                local petBulk = {}
                for i, pet in ipairs(pets) do
                    local targetBreakable = breakables[((i - 1) % #breakables) + 1]
                    if targetBreakable and targetBreakable.uid and pet.euid then
                        petBulk[pet.euid] = tostring(targetBreakable.uid)
                    end
                end
                if next(petBulk) then
                    Network.Fire("Breakables_JoinPetBulk", petBulk)
                    lastPetBulkSignature = sig
                    lastPetBulkFire = now
                end
            end
        end)
    end

    -- 2. Fast Multi-Target Auto Tap Damage (Batch limit: max 15)
    -- [FIX-4] Skip breakable đã bị destroy (model.Parent == nil); fire riêng từng
    -- target để một UID lỗi không chặn cả batch.
    pcall(function()
        local maxTaps = math.min(#breakables, 15)
        for idx = 1, maxTaps do
            local b = breakables[idx]
            if b and b.uid then
                local okAlive, alive = pcall(function()
                    local model = b.model
                    return (not model) or (model.Parent ~= nil)
                end)
                if okAlive and alive then
                    Network.UnreliableFire("Breakables_PlayerDealDamage", b.uid)
                end
            end
        end
    end)

    -- Debug Log mỗi 5 giây để theo dõi target và tọa độ
    if now - lastFarmDebugTime > 5 then
        lastFarmDebugTime = now
        local charPos = (root and root.Position) or Vector3.new(0, 0, 0)
        local targetUid = breakables[1] and breakables[1].uid or "none"
        print(string.format("[MapAuto::Farm Debug] Zone: '%s' | Breakables: %d | Target UID: %s | Char Pos: (%.1f, %.1f, %.1f)", tostring(zoneName), #breakables, tostring(targetUid), charPos.X, charPos.Y, charPos.Z))
    end
end

