-- ----------------------------------------------------------------------------
-- 10B. Auto Daycare Manager (Auto Claim & Auto Enroll Pets in Daycare)
-- ----------------------------------------------------------------------------
local DaycareManager = {}
local lastDaycareCheckTime = 0

function DaycareManager.Step()
    if getgenv().MapAutoConfig.AutoDaycare == false then return end
    if os.clock() - lastDaycareCheckTime < 15 then return end
    lastDaycareCheckTime = os.clock()

    pcall(function()
        local saveData = Save.Get()
        local myRank = (saveData and saveData.Rank) or 1
        if myRank < 3 then return end

        local successDaycareCmd, DaycareCmds = pcall(function() return LoadModule(Client, "DaycareCmds") end)
        if not successDaycareCmd or not DaycareCmds then return end

        -- 1. Auto Claim Completed Daycare Rewards
        local activeList = nil
        pcall(function() activeList = DaycareCmds.GetActive() end)
        local hasClaimable = false
        if activeList then
            for uid, info in pairs(activeList) do
                local remTime = (1 / 0)
                pcall(function() remTime = DaycareCmds.ComputeRemainingTime(uid) end)
                if remTime <= 0 then
                    hasClaimable = true
                    break
                end
            end
        end

        if hasClaimable then
            print("[MapAuto::Daycare] Claiming available daycare rewards...")
            local ok, rewards, bonus = pcall(function() return Network.Invoke("Daycare: Claim") end)
            if ok then
                print("[MapAuto::Daycare] Claimed daycare rewards successfully.")
            end
        end

        -- 2. Auto Enroll Available Pets into Daycare
        local maxSlots = 10
        local usedSlots = 0
        pcall(function() maxSlots = DaycareCmds.GetMaxSlots() end)
        pcall(function() usedSlots = DaycareCmds.GetUsedSlots() end)

        local availableSlots = math.max(0, maxSlots - usedSlots)
        if availableSlots > 0 then
            local successContainer, container = pcall(function() return InventoryCmds.Container() end)
            if successContainer and container then
                local enrollTable = {}
                local countAdded = 0

                local allItems = nil
                pcall(function()
                    if type(container.All) == "function" then
                        allItems = container:All()
                    elseif container._byUID then
                        allItems = container._byUID
                    end
                end)

                if allItems then
                    for _, item in pairs(allItems) do
                        if countAdded >= availableSlots then break end
                        if item and type(item.GetClass) == "function" and item:GetClass() == "Pet" then
                            local isEquipped = false
                            local isLocked = false
                            local exclusiveLvl = 0
                            local isUgc = false

                            pcall(function() if item.IsEquipped then isEquipped = item:IsEquipped() end end)
                            pcall(function() if item.IsLocked then isLocked = item:IsLocked() end end)
                            pcall(function() if item.GetExclusiveLevel then exclusiveLvl = item:GetExclusiveLevel() end end)
                            pcall(function() if item.Directory and item:Directory().ugc then isUgc = item:Directory().ugc end end)

                            -- Daycare ONLY accepts non-equipped, non-locked, non-exclusive/ugc pets!
                            if not isEquipped and not isLocked and (not exclusiveLvl or exclusiveLvl == 0) and not isUgc then
                                local uidStr = nil
                                pcall(function() uidStr = item:GetUID() or item:GetOptionalUID() end)
                                local petAmount = 1
                                pcall(function() petAmount = item:GetAmount() end)

                                if uidStr and petAmount > 0 then
                                    local amountToSend = math.min(petAmount, availableSlots - countAdded)
                                    enrollTable[tostring(uidStr)] = amountToSend
                                    countAdded = countAdded + amountToSend
                                end
                            end
                        end
                    end
                end

                -- Fallback to Save.Get() if container items iteration returned nothing
                if countAdded == 0 then
                    local saveData = Save.Get()
                    if saveData and saveData.Inventory and saveData.Inventory.Pet then
                        for uid, itemData in pairs(saveData.Inventory.Pet) do
                            if countAdded >= availableSlots then break end
                            if itemData and type(itemData) == "table" then
                                local isEquipped = itemData.eq or false
                                local isLocked = itemData.l or false
                                if not isEquipped and not isLocked then
                                    local petAmount = itemData._am or 1
                                    local amountToSend = math.min(petAmount, availableSlots - countAdded)
                                    enrollTable[tostring(uid)] = amountToSend
                                    countAdded = countAdded + amountToSend
                                end
                            end
                        end
                    end
                end

                if countAdded > 0 then
                    print(string.format("[MapAuto::Daycare] Enrolling %d pets into daycare...", countAdded))
                    local ok, res, errMsg = pcall(function() return DaycareCmds.Enroll(enrollTable) end)
                    if not ok or res == false then
                        pcall(function() ok, res, errMsg = Network.Invoke("Daycare: Enroll", enrollTable) end)
                    end

                    if ok and res ~= false then
                        print(string.format("[MapAuto::Daycare] Enrolled %d pets into daycare successfully.", countAdded))
                    else
                        warn(string.format("[MapAuto::Daycare Error] Enroll failed: %s", tostring(errMsg)))
                    end
                end
            end
        end
    end)
end

-- ----------------------------------------------------------------------------
-- 10C. Smart Auto Flag Manager (Smart Flag Placement based on Zone Status)
-- ----------------------------------------------------------------------------
local AutoFlagManager = {}
local lastFlagCheckTime = 0

local function GetAvailableFlag(isAtMaxContent)
    -- isAtMaxContent = true khi không còn zone nào để mở (GetNextZone = nil)
    -- => tiết kiệm Fortune/Diamonds Flag khi còn đang farm mở zone
    local ownedFlags = {}
    local saveData = Save.Get()
    if saveData and saveData.Inventory then
        for catName, catTable in pairs(saveData.Inventory) do
            if type(catTable) == "table" then
                for uid, itemData in pairs(catTable) do
                    if type(itemData) == "table" then
                        local id = tostring(itemData.id or itemData._id or "")
                        if string.find(id, "Flag", 1, true) then
                            ownedFlags[id] = true
                        end
                    end
                end
            end
        end
    end

    local priorityList
    if isAtMaxContent then
        -- Đã max zone của game -> dùng flag tốt nhất
        priorityList = { "Fortune Flag", "Diamonds Flag", "Coins Flag", "Strength Flag", "Magnet Flag", "Hasty Flag" }
    else
        -- Còn đang farm mở zone -> tiết kiệm, dùng flag thường trước
        priorityList = { "Coins Flag", "Strength Flag", "Magnet Flag", "Hasty Flag", "Fortune Flag", "Diamonds Flag" }
    end

    for _, flagName in ipairs(priorityList) do
        if ownedFlags[flagName] then
            return flagName
        end
    end

    -- Fallback: return top priority flag if inventory scanning is unpopulated
    return priorityList[1]
end

function AutoFlagManager.Step()
    if getgenv().MapAutoConfig.AutoFlags == false then return end
    if os.clock() - lastFlagCheckTime < 8 then return end
    lastFlagCheckTime = os.clock()

    pcall(function()
        local successZone, ZoneCmds = pcall(function() return LoadModule(Client, "ZoneCmds") end)
        local successMap, MapCmds = pcall(function() return LoadModule(Client, "MapCmds") end)
        local successFlex, FlexibleFlagCmds = pcall(function() return LoadModule(Client, "FlexibleFlagCmds") end)
        local successFlag, ZoneFlagCmds = pcall(function() return LoadModule(Client, "ZoneFlagCmds") end)
        if not successZone or not ZoneCmds then return end

        local maxZoneName, maxZoneData = ZoneCmds.GetMaxOwnedZone()
        local maxZoneID = (maxZoneData and maxZoneData._id) or maxZoneName

        -- Dùng GetCurrentZoneNoVerification() làm primary để tránh stale data từ GetMaxOwnedZone()
        -- (maxZoneID có thể là zone cũ nếu GetMaxOwnedZone() chưa update sau khi mở zone mới)
        local currentZoneNoVerif = nil
        pcall(function()
            if successMap and MapCmds and MapCmds.GetCurrentZoneNoVerification then
                currentZoneNoVerif = MapCmds.GetCurrentZoneNoVerification()
            end
        end)

        local currentZoneName = currentZoneNoVerif
            or (successMap and MapCmds and MapCmds.GetCurrentZone())
            or maxZoneID
        if not currentZoneName then currentZoneName = maxZoneID end

        local isBestZone = (maxZoneID and (currentZoneName == maxZoneID or currentZoneName == maxZoneName))

        -- Prioritize exact Zone Instance GUID and Zone Name variants
        local zoneVariants = {}
        if maxZoneData and maxZoneData._id then table.insert(zoneVariants, maxZoneData._id) end
        if currentZoneName then table.insert(zoneVariants, currentZoneName) end
        if maxZoneName then table.insert(zoneVariants, maxZoneName) end

        -- isAtMaxContent: true khi GetNextZone() = nil (không còn zone mới để mua)
        -- Game xác định max zone bằng ZonesUtil.GetMaximumZoneNumber() (quét toàn bộ Zones Directory)
        local isAtMaxContent = false
        pcall(function()
            local nextZoneName, nextZoneData = ZoneCmds.GetNextZone()
            isAtMaxContent = (nextZoneName == nil and nextZoneData == nil)
        end)

        local targetFlagName = GetAvailableFlag(isAtMaxContent)
        if not targetFlagName then return end

        -- Spawn zones (e.g. "Fantasy Spawn", "Void Spawn", "Tech Spawn", "Spawn") do not have breakable fields for flags
        if string.find(tostring(currentZoneName), "Spawn", 1, true) or string.find(tostring(maxZoneID), "Spawn", 1, true) then
            return
        end

        -- 1. Quét trực tiếp cờ đang cắm trong workspace.__THINGS.Flags gần nhân vật (< 120 studs)
        local physicalFlagActive = false
        local physicalFlagName = nil
        pcall(function()
            local char = LocalPlayer.Character
            local root = char and char.PrimaryPart
            if not root then return end
            local things = workspace:FindFirstChild("__THINGS")
            local flagsFolder = things and things:FindFirstChild("Flags")
            if flagsFolder then
                for _, flagModel in ipairs(flagsFolder:GetChildren()) do
                    if flagModel:IsA("Model") then
                        local pivot = flagModel:GetPivot()
                        local dist = (pivot.Position - root.Position).Magnitude
                        if dist <= 120 then
                            physicalFlagActive = true
                            local pole = flagModel:FindFirstChild("FlagPole")
                            local attach = pole and pole:FindFirstChild("Attachment")
                            local billboard = attach and attach:FindFirstChild("ZoneFlag")
                            local title = billboard and billboard:FindFirstChild("Title")
                            if title and title.Text ~= "" then
                                physicalFlagName = title.Text
                            end
                            break
                        end
                    end
                end
            end
        end)

        if physicalFlagActive then
            -- Bãi đã có cờ đang cắm, không cắm đè cờ khác để tránh server từ chối
            return
        end

        -- 2. Check active flag status using FlexibleFlagCmds.getPlayerFlag()
        local activeFlagInfo = nil
        pcall(function()
            if successFlex and FlexibleFlagCmds and FlexibleFlagCmds.getPlayerFlag then
                activeFlagInfo = FlexibleFlagCmds.getPlayerFlag()
            end
            if not activeFlagInfo and successFlag and ZoneFlagCmds then
                for _, z in ipairs(zoneVariants) do
                    if ZoneFlagCmds.GetActiveFlag then
                        local info = ZoneFlagCmds.GetActiveFlag(z)
                        if info then
                            activeFlagInfo = info
                            break
                        end
                    end
                end
            end
        end)

        local needsPlacement = false
        if not activeFlagInfo then
            needsPlacement = true
        else
            local remTime = 0
            pcall(function()
                if activeFlagInfo.EndTime then
                    remTime = activeFlagInfo.EndTime - workspace:GetServerTimeNow()
                end
            end)
            if remTime <= 30 then
                needsPlacement = true
            else
                return
            end
        end

        -- 3. Server yêu cầu nhân vật phải đứng bên trong bãi đào (Dotted Box) mới cho phép cắm cờ
        local isInDottedBox = false
        pcall(function()
            if successMap and MapCmds and MapCmds.IsInDottedBox then
                isInDottedBox = MapCmds.IsInDottedBox()
            end
        end)
        if not isInDottedBox then
            -- Chưa ở trong Dotted Box, bỏ qua lần này đợi nhân vật vào bãi farm
            return
        end

        if needsPlacement then
            -- Lấy UID của flag item trong inventory (server cần itemUID, không phải zoneId)
            local targetFlagUID = GetInventoryItemUID("Misc", targetFlagName)
            if not targetFlagUID then
                return
            end

            print(string.format("[MapAuto::Flags] Placing flag '%s' at zone '%s'...", targetFlagName, tostring(currentZoneName)))

            local res = false
            local errMsg = nil

            -- 1. Try FlexibleFlagCmds.Consume
            pcall(function()
                if successFlex and FlexibleFlagCmds and FlexibleFlagCmds.Consume then
                    res, errMsg = FlexibleFlagCmds.Consume(targetFlagName, targetFlagUID, 1)
                end
            end)

            -- 2. Fallback: Direct Remote Invoke (chính xác 2 args theo Network Spy)
            if not res or res == false then
                pcall(function() res, errMsg = Network.Invoke("FlexibleFlags_Consume", targetFlagName, targetFlagUID, 1) end)
            end

            if res and res ~= false then
                print(string.format("[MapAuto::Flags] Placed flag '%s' successfully.", targetFlagName))
            else
                -- Nếu bị từ chối (có thể do zone vừa cắm cờ hoặc max stacks), delay 20s trước khi thử lại
                lastFlagCheckTime = os.clock() + 15
            end
        end

    end)
end

