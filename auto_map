-- ----------------------------------------------------------------------------
-- 9. Smart Auto Equip Best Enchants Manager (DO NOT touch if equipped; Upgrade if higher tier available)
-- ----------------------------------------------------------------------------
local AutoEnchantManager = {}
local lastEnchantCheck = 0

function AutoEnchantManager.Step()
    if not getgenv().MapAutoConfig.AutoEquipEnchants then return end
    if os.clock() - lastEnchantCheck < 10 then return end
    lastEnchantCheck = os.clock()

    pcall(function()
        local saveData = Save.Get()
        local EnchantCmds = LoadModule(Client, "EnchantCmds")
        if not EnchantCmds then return end
        local maxSlots = EnchantCmds.GetMaxEquippedEnchants() or 1
        local equippedMap = EnchantCmds.GetEquipped() or {}
        local priorityList = getgenv().MapAutoConfig.EnchantPriorityList or {}

        -- Determine max usable enchant tier based on Enchant Mastery level
        -- Game invariant: Tiers I-VII are always equip-able (no Rebirth limit).
        -- Tier VIII requires Mastery 50, Tier IX requires Mastery 60, Tier X requires Mastery 70.
        local maxUsableTier = 7
        pcall(function()
            local MasteryCmds = LoadModule(Client, "MasteryCmds")
            if MasteryCmds and MasteryCmds.HasPerk then
                if MasteryCmds.HasPerk("Enchants", "TierTenEquip") then
                    maxUsableTier = 10
                elseif MasteryCmds.HasPerk("Enchants", "TierNineEquip") then
                    maxUsableTier = 9
                elseif MasteryCmds.HasPerk("Enchants", "TierEightEquip") then
                    maxUsableTier = 8
                end
            elseif MasteryCmds and MasteryCmds.GetLevel then
                local enchMasteryLevel = MasteryCmds.GetLevel("Enchants") or 0
                if enchMasteryLevel >= 70 then
                    maxUsableTier = 10
                elseif enchMasteryLevel >= 60 then
                    maxUsableTier = 9
                elseif enchMasteryLevel >= 50 then
                    maxUsableTier = 8
                end
            end
        end)

        -- Gather all enchants in inventory
        local allEnchants = {}
        local processedUIDs = {}

        -- 1. Prepopulate currently equipped enchants (as they are hidden/removed from container:All())
        pcall(function()
            local EnchantItem = LoadModule(Library:WaitForChild("Items"), "EnchantItem")
            for _, itemUID in pairs(equippedMap) do
                local uidStr = tostring(itemUID)
                local enchData = saveData and saveData.Inventory and saveData.Inventory.Enchant and (saveData.Inventory.Enchant[uidStr] or saveData.Inventory.Enchant[itemUID])
                local eType, eTier
                if enchData then
                    eType = enchData.id or enchData._id
                    eTier = enchData.tn or enchData.tier or enchData.t or 1
                elseif EnchantItem then
                    local itemObj = nil
                    pcall(function() itemObj = EnchantItem:Get(uidStr) end)
                    if itemObj then
                        eType = (type(itemObj.GetId) == "function" and itemObj:GetId()) or itemObj._id
                        eTier = itemObj._data and (itemObj._data.tn or itemObj._data.tier or itemObj._data.t or 1) or 1
                    end
                end

                if eType then
                    table.insert(allEnchants, { uid = itemUID, uidStr = uidStr, id = tostring(eType), tier = tonumber(eTier) or 1 })
                    processedUIDs[uidStr] = true
                end
            end
        end)

        -- 2. Add unequipped enchants from live container (safe against raw tables)
        pcall(function()
            local successContainer, container = pcall(function() return InventoryCmds.Container() end)
            if successContainer and container then
                local allItems = (type(container.All) == "function" and container:All()) or container._byUID or (container._store and container._store._byUID)
                if allItems then
                    local Directory = LoadModule(Library, "Directory")
                    for uid, item in pairs(allItems) do
                        if item then
                            local uidStr = tostring(uid)
                            if not processedUIDs[uidStr] then
                                -- Safe extraction of ID
                                local id = nil
                                pcall(function()
                                    id = (type(item.GetId) == "function" and item:GetId()) or item._id or item.id
                                    if not id and item._data then
                                        id = item._data.id or item._data._id
                                    end
                                end)

                                -- Validate item type via Directory with pcall protection
                                local isEnchant = false
                                if id and Directory and Directory.Enchants then
                                    pcall(function()
                                        if Directory.Enchants[tostring(id)] then
                                            isEnchant = true
                                        end
                                    end)
                                end

                                if isEnchant then
                                    -- Safe extraction of Tier
                                    local tier = 1
                                    pcall(function()
                                        tier = (type(item.GetTier) == "function" and item:GetTier()) or item.tn or item.tier or 1
                                        if (not tier or tier == 1) and item._data then
                                            tier = item._data.tn or item._data.tier or item._data.t or 1
                                        end
                                    end)

                                    if tonumber(tier) <= maxUsableTier then
                                        -- Only equip uids the server actually owns: ghost copies left by
                                        -- rank-up consumption exist in the container but not in saveData,
                                        -- and equipping them is rejected forever (stuck swap loop).
                                        local inSaveData = false
                                        pcall(function()
                                            inSaveData = saveData.Inventory.Enchant[uidStr] ~= nil
                                        end)
                                        if inSaveData then
                                            table.insert(allEnchants, { uid = uid, uidStr = uidStr, id = tostring(id), tier = tonumber(tier) or 1 })
                                            processedUIDs[uidStr] = true
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)

        -- 3. Fallback: Add from saveData if container was empty/failed
        if #allEnchants == 0 and saveData and saveData.Inventory and saveData.Inventory.Enchant then
            for uid, itemData in pairs(saveData.Inventory.Enchant) do
                local uidStr = tostring(uid)
                if not processedUIDs[uidStr] then
                    local eType = itemData.id or itemData._id
                    local eTier = itemData.tn or itemData.tier or itemData.t or 1
                    if eType and eTier <= maxUsableTier then
                        table.insert(allEnchants, { uid = uid, uidStr = uidStr, id = eType, tier = eTier })
                    end
                end
            end
        end

        -- Group enchants by ID and sort descending by tier
        local enchantsByType = {}
        for _, item in ipairs(allEnchants) do
            if not enchantsByType[item.id] then enchantsByType[item.id] = {} end
            table.insert(enchantsByType[item.id], item)
        end
        for eType, list in pairs(enchantsByType) do
            table.sort(list, function(a, b) return a.tier > b.tier end)
        end

        local optimalSet = {} -- { [uidStr] = originalUID }
        local countSelected = 0

        -- Step A: Pick highest-tier for priority list enchants (1 book per type max)
        for _, targetName in ipairs(priorityList) do
            if countSelected >= maxSlots then break end
            local list = enchantsByType[targetName]
            if list and #list > 0 then
                local bestItem = table.remove(list, 1)
                optimalSet[bestItem.uidStr] = bestItem.uid
                countSelected = countSelected + 1
            end
        end

        -- Compare current equipped layout against optimal set.
        -- No force-fill: only the priority list decides what gets equipped.
        local slotsToClear = {}
        local currentEquippedSet = {}
        local equippedSlotByUid = {}
        for slotKey, itemUID in pairs(equippedMap) do
            local uidStr = tostring(itemUID)
            currentEquippedSet[uidStr] = true
            if not optimalSet[uidStr] then
                -- Equipped enchant is not wanted: remove it
                table.insert(slotsToClear, slotKey)
            elseif equippedSlotByUid[uidStr] then
                -- Same book occupying more than one slot (ghost duplicate): remove the extra copy
                table.insert(slotsToClear, slotKey)
            else
                equippedSlotByUid[uidStr] = slotKey
            end
        end

        local uidsToEquip = {}
        for uidStr, origUid in pairs(optimalSet) do
            if not currentEquippedSet[uidStr] then
                table.insert(uidsToEquip, origUid)
            end
        end

        -- Execute swap actions with safe spacing
        if #slotsToClear > 0 or #uidsToEquip > 0 then
            print(string.format("[MapAuto::Enchants] Auto-swapping enchants. Clearing %d slots, equipping %d optimal books.", #slotsToClear, #uidsToEquip))
            for _, slotKey in ipairs(slotsToClear) do
                pcall(function() Network.Fire("Enchants_ClearSlot", tonumber(slotKey) or slotKey) end)
                task.wait(0.25)
            end
            for _, uid in ipairs(uidsToEquip) do
                pcall(function() Network.Fire("Enchants_Equip", uid) end)
                task.wait(0.25)
            end
        end
    end)
end

