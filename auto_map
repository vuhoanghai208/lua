local FastTeleportToZoneCenter = nil
local AutoUpgradeManager = {}
local lastUpgradeAttempt = 0

function AutoUpgradeManager.Step()
    if not getgenv().MapAutoConfig.AutoUpgrades then return end
    if os.clock() - lastUpgradeAttempt < 10 then return end
    lastUpgradeAttempt = os.clock()

    pcall(function()
        local successUpg, UpgradeCmds = pcall(function() return LoadModule(Client, "UpgradeCmds") end)
        local successZone, ZoneCmds = pcall(function() return LoadModule(Client, "ZoneCmds") end)

