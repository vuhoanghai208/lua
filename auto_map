-- 8. Smart Auto Fruits Manager (ONLY consume when fruit buff EXPIRES)
-- ----------------------------------------------------------------------------
local AutoFruitsManager = {}
local lastFruitCheck = 0

local function IsFruitActive(FruitCmds, fId)
    if not FruitCmds or not fId then return false end
    local active = false
    pcall(function()
        if FruitCmds.GetFruitData then
            local data = FruitCmds.GetFruitData(fId)
            if data and type(data) == "table" then
                local shinyCount = data.Shiny and #data.Shiny or 0
                local normalCount = data.Normal and #data.Normal or 0
                if (shinyCount + normalCount) > 0 then
                    active = true
                end
            end
        elseif FruitCmds.Has then
            local has = FruitCmds.Has(fId)
            if has then active = true end
        end
    end)
    return active
end

function AutoFruitsManager.Step()
    if not getgenv().MapAutoConfig.AutoFruits then return end
    if os.clock() - lastFruitCheck < 60 then return end
    lastFruitCheck = os.clock()

    local saveData = Save.Get()
    if not saveData or not saveData.Inventory or not saveData.Inventory.Fruit then return end

    local successFruit, FruitCmds = pcall(function() return LoadModule(Client, "FruitCmds") end)

    local consumedTypes = {}
    for uid, fruitData in pairs(saveData.Inventory.Fruit) do
        local fId = fruitData.id or fruitData._id
        if fId and not consumedTypes[fId] then
            local active = successFruit and IsFruitActive(FruitCmds, fId)

            -- Smart Check: ONLY consume if fruit buff is NOT active!
            if not active then
                consumedTypes[fId] = true
                pcall(function()
                    Network.Fire("Fruits: Consume", tostring(uid), 1)
                    print(string.format("[MapAuto::Fruits] Consumed fruit '%s'.", tostring(fId)))
                end)
                task.wait(0.1)
            end
        end
    end
end

