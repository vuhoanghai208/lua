local RebirthManager = {}
local lastRebirthAttempt = 0

function RebirthManager.Step()
    if not getgenv().MapAutoConfig.AutoRebirth then return end
    if os.clock() - lastRebirthAttempt < 5 then return end

    local nextRebirth = RebirthCmds.GetNextRebirth()
    if not nextRebirth then return end

    local reqZoneNumber = nextRebirth.ZoneNumberRequired
    if not reqZoneNumber then return end

    local _, maxZoneData = ZoneCmds.GetMaxOwnedZone()
    if not maxZoneData or not maxZoneData.ZoneNumber then return end

    if maxZoneData.ZoneNumber >= reqZoneNumber then
        local rebirthId = tostring(nextRebirth.RebirthNumber or nextRebirth._id)
        print(string.format("[MapAuto] Rebirth #%s ready! (Current Zone: %d, Required: %d)", rebirthId, maxZoneData.ZoneNumber, reqZoneNumber))
        
        lastRebirthAttempt = os.clock()
        
        NetworkQueue:enqueue(function()
