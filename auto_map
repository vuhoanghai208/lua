-- 10F. Auto Mastery XP Potion Manager (Smart Ultra Mastery XP Potion Auto-Use)
-- ----------------------------------------------------------------------------
local AutoMasteryManager = {}
local lastMasteryCheckTime = 0

function AutoMasteryManager.Step()
    local targetMasteryList = getgenv().MapAutoConfig.auto_mas or getgenv().MapAutoConfig.AutoMasteryList
    if not targetMasteryList or type(targetMasteryList) ~= "table" or #targetMasteryList == 0 then
        return -- Mảng rỗng -> Không tự động dùng bất cứ gì!
    end

    local now = os.clock()
    if now - lastMasteryCheckTime < 10 then return end
    lastMasteryCheckTime = now

    pcall(function()
        local successMastery, MasteryCmds = pcall(function() return LoadModule(Client, "MasteryCmds") end)
        if not successMastery or not MasteryCmds then return end

        if MasteryCmds.MasteryUnlocked and not MasteryCmds.MasteryUnlocked() then
            return
        end

        -- Kiểm tra xem trong Inventory có Ultra Mastery XP Potion không
        local ultraPotionUID = GetInventoryItemUID("XPPotion", "Ultra Mastery")
            or GetInventoryItemUID("Potion", "Ultra Mastery")
            or GetInventoryItemUID("Misc", "Ultra Mastery")
        
        -- Fallback tìm qua Save Data
        if not ultraPotionUID then
            local saveData = Save.Get()
            if saveData and saveData.Inventory then
                for _, catTable in pairs(saveData.Inventory) do
                    if type(catTable) == "table" then
                        for uid, itemData in pairs(catTable) do
                            if type(itemData) == "table" then
                                local id = tostring(itemData.id or itemData._id or "")
                                if string.find(id:lower(), "ultra mastery", 1, true) then
                                    ultraPotionUID = tostring(uid)
                                    break
                                end
                            end
                        end
                    end
                    if ultraPotionUID then break end
                end
            end
        end

        if not ultraPotionUID then return end

        -- Duyệt qua danh sách user muốn nâng cấp (theo thứ tự ưu tiên)
        for _, masName in ipairs(targetMasteryList) do
            local currentLvl = 99
            pcall(function()
                currentLvl = MasteryCmds.GetLevel(masName)
            end)

            if currentLvl < 99 then
                print(string.format("[MapAuto::Mastery] 🧪 Found Ultra Mastery XP Potion! Using for '%s' Mastery (Current Level: %d)...", tostring(masName), currentLvl))
                
                local success, res = pcall(function()
                    return Network.Invoke("XPPotions: Consume", "Ultra Mastery", 1, masName)
                end)

                if success and res ~= false then
                    print(string.format("[MapAuto::Mastery] ✅ Successfully upgraded '%s' Mastery to Level 99 with Ultra Mastery Potion!", tostring(masName)))
                    task.wait(1)
                    break
                else
                    warn(string.format("[MapAuto::Mastery] ⚠️ Failed to consume Ultra Mastery Potion for '%s': %s", tostring(masName), tostring(res)))
                end
            end
        end
    end)
end

