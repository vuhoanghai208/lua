                if model then
                    -- Lọc bỏ breakables thuộc khu VIP hoặc ngoài phạm vi bãi đào chính (bán kính 150 studs)
                    local inRange = true
                    if cachedPos and model:IsA("Model") then
                        local okP, p = pcall(function() return model:GetPivot().Position end)
                        if okP and p and (p - cachedPos).Magnitude > 150 then
                            inRange = false
                        end
                    end

                    if inRange then
                        if IsBossBreakable(model, uidStr) then
                            table.insert(bossList, { uid = uidStr, model = model })
                        else
                            table.insert(normalList, { uid = uidStr, model = model })
                        end
                    end
                end
            end
        end
    end)

    -- Ưu tiên 100% farm breakables thường (Coins, Diamonds, Piles, Safes)
    if #normalList > 0 then
        return normalList
    end
    return bossList
end

local lastStreamedZone = ""

local function GetMapRoot()
    return workspace:FindFirstChild("Map3")
        or workspace:FindFirstChild("Map2")
        or workspace:FindFirstChild("Map")
        or workspace:FindFirstChild("Map4")
        or (function()
            for _, c in ipairs(workspace:GetChildren()) do
                if string.sub(c.Name, 1, 3) == "Map" then
                    return c
                end
            end
            return nil
        end)()
end

local function GetExactZoneFolder(zoneName, zoneNumber)
    if not zoneName or zoneName == "" then return nil end
    local mapRoot = GetMapRoot()
    if not mapRoot then return nil end

    -- 1. Ưu tiên tìm trực tiếp dạng "[ZoneNumber] | [ZoneName]"
    if zoneNumber then
        local direct = mapRoot:FindFirstChild(tostring(zoneNumber) .. " | " .. zoneName)
        if direct then return direct end
    end

    -- 2. Quét children của mapRoot
    for _, f in ipairs(mapRoot:GetChildren()) do
        if not string.find(f.Name, "VIP", 1, true) then
            local numStr, nameStr = string.match(f.Name, "^(%d+)%s*|%s*(.+)$")
            if nameStr and string.lower(nameStr) == string.lower(zoneName) then
                return f
            elseif string.lower(f.Name) == string.lower(zoneName) then
                return f
            end
        end
    end

    return nil
end

-- [FIX-4] pendingFarmZone: bridge gap giữa lúc mua zone xong và GetMaxOwnedZone() sync
local pendingFarmZone = nil
local pendingFarmZoneTime = 0
local PENDING_ZONE_TTL = 3.0 -- giây tối đa giữ pending trước khi drop

local function GetBestFarmingZone()
    -- Nếu đang có zone pending (vừa mua xong, save chưa sync)
    if pendingFarmZone and (os.clock() - pendingFarmZoneTime) < PENDING_ZONE_TTL then
        local maxZoneName, _ = ZoneCmds.GetMaxOwnedZone()
        if maxZoneName == pendingFarmZone then
            pendingFarmZone = nil -- save đã sync, clear pending
        else
            return pendingFarmZone -- dùng zone pending thay vì zone cũ
        end
    else
        pendingFarmZone = nil -- hết TTL, drop
    end
    local maxZoneName, maxZoneData = ZoneCmds.GetMaxOwnedZone()
    local bestId = (maxZoneData and maxZoneData._id) or maxZoneName
    return bestId
end

-- [FIX-1] Thay boolean isMachineTeleporting bằng timestamp lock để tránh race condition
-- Hai goroutine (Tether + FastTeleport) không thể conflict khi cùng đọc/ghi boolean
local lastMachineTeleportTime = 0
local MACHINE_TELEPORT_LOCK_MS = 0.55 -- giây
local function IsMachineTeleporting()
    return (os.clock() - lastMachineTeleportTime) < MACHINE_TELEPORT_LOCK_MS
end
local function SetMachineTeleporting()
    lastMachineTeleportTime = os.clock()
end

local lastSnapTime = 0
local lastVoidRecovery = 0
local lastNativeTeleportTime = 0

-- [FIX-3] Stream state per-zone: snap vào PERSISTENT.Teleport pad để kích stream INTERACT
-- (proximity-based, giống map1.txt), remote Teleports_RequestTeleport chỉ làm fallback cuối.
local TELEPORT_PAD_RESNAP_S = 3      -- tối thiểu giữa 2 lần snap vào pad (tránh spam)
local TELEPORT_REMOTE_BACKOFF_S = 8  -- tối thiểu giữa 2 lần invoke remote (tránh rate-limit)
local zoneStreamState = {}           -- zoneName -> { padSnap = os.clock(), remote = os.clock() }

FastTeleportToZoneCenter = function(zoneName)
    if IsMachineTeleporting() then return end
    if not zoneName then return end
    local char = LocalPlayer.Character
    local root = char and char.PrimaryPart
    if not root then return end

    local maxZoneName, maxZoneData = ZoneCmds.GetMaxOwnedZone()
    local zoneNumber = (maxZoneData and maxZoneData.ZoneNumber)
    if zoneName ~= maxZoneName and Directory and Directory.Zones and Directory.Zones[zoneName] then
        zoneNumber = Directory.Zones[zoneName].ZoneNumber
    end

    local zoneFolder = GetExactZoneFolder(zoneName, zoneNumber)
    local targetPos = zoneFieldPositionCache[zoneName]

    -- 1. Kiểm tra zone đã stream vào workspace chưa
    local zoneAlreadyLoaded = zoneFolder
        and zoneFolder:FindFirstChild("INTERACT")
        and (zoneFolder.INTERACT:FindFirstChild("BREAK_ZONES") or zoneFolder.INTERACT:FindFirstChild("BREAKABLE_SPAWNS"))
        and #zoneFolder:GetChildren() > 0

    if not targetPos or not zoneAlreadyLoaded or (lastStreamedZone ~= zoneName) then
        lastStreamedZone = zoneName

        if not zoneAlreadyLoaded then
            -- [FIX-3] Pad-proximity streaming (map1.txt): mọi zone folder luôn có sẵn PERSISTENT.Teleport,
            -- snap nhân vật vào pad để game tự stream INTERACT/BREAK_ZONES theo proximity.
            -- KHÔNG gọi remote ngay (bị server throttle -> loop); remote chỉ là fallback cuối.
            local nowT = os.clock()
            local state = zoneStreamState[zoneName]
            local persistent = zoneFolder and zoneFolder:FindFirstChild("PERSISTENT")
            local tpPart = persistent and persistent:FindFirstChild("Teleport")

            -- 1) Snap vào pad (tối đa 1 lần / TELEPORT_PAD_RESNAP_S) để kích stream
            if tpPart and (not state or (nowT - state.padSnap) >= TELEPORT_PAD_RESNAP_S) then
                state = { padSnap = nowT, remote = nowT } -- reset remote: vừa thử pad, đợi 8s mới fallback remote
                zoneStreamState[zoneName] = state
                SetMachineTeleporting()
                pcall(function()
                    char:PivotTo(tpPart.CFrame + Vector3.new(0, 10, 0))
                    root.CFrame = tpPart.CFrame + Vector3.new(0, 10, 0)
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end)
                print(string.format("[MapAuto::Teleport] 🧲 Zone '%s' chưa stream — snap vào teleport pad để kích stream.", tostring(zoneName)))
            end

            -- 2) Chờ proximity stream INTERACT/BREAK_ZONES (ngắn: FarmManager gọi lại 0.3s + Tether 0.25s re-check)
            local waited = 0
            while waited < 2.5 do
                zoneFolder = GetExactZoneFolder(zoneName, zoneNumber)
                if zoneFolder then
                    local interact = zoneFolder:FindFirstChild("INTERACT")
                    local hasField = interact and (interact:FindFirstChild("BREAK_ZONES") or interact:FindFirstChild("BREAKABLE_SPAWNS"))
                    if hasField then
                        break
                    end
                end
                task.wait(0.2)
                waited = waited + 0.2
            end

            -- 3) Fallback: remote chỉ khi pad-proximity vẫn chưa stream và đã qua backoff
            local interact = zoneFolder and zoneFolder:FindFirstChild("INTERACT")
            local hasField = interact and (interact:FindFirstChild("BREAK_ZONES") or interact:FindFirstChild("BREAKABLE_SPAWNS"))
            if not hasField and (not state or (nowT - state.remote) >= TELEPORT_REMOTE_BACKOFF_S) then
                if not state then state = { padSnap = nowT, remote = nowT } end
                state.remote = nowT
                zoneStreamState[zoneName] = state
                SetMachineTeleporting()
                pcall(function()
                    local Variables = LoadModule(Library, "Variables")
                    if Variables then Variables.IsUsingCannon = false end
                    Network.Invoke("Teleports_RequestTeleport", zoneName)
                    if Variables then Variables.IsUsingCannon = false end
                end)
            end
        end
    end

    -- 2. Tìm vị trí bãi đào chính xác từ zoneFolder
    local isFallback = false
    if zoneFolder then
        local interact = zoneFolder:FindFirstChild("INTERACT")
        local persistent = zoneFolder:FindFirstChild("PERSISTENT")
        local tpPart = persistent and persistent:FindFirstChild("Teleport")
        local tpPos = tpPart and tpPart.Position

        -- A. Ưu tiên cao nhất: BREAKABLE_SPAWNS.Main (bãi farm chính thức chuẩn của game)
        local bSpawns = interact and (interact:FindFirstChild("BREAKABLE_SPAWNS") or interact:FindFirstChild("BreakableSpawns"))
        if bSpawns then
            local mainSpawn = bSpawns:FindFirstChild("Main") or bSpawns:FindFirstChild("main") or bSpawns:FindFirstChild("MAIN")
            if mainSpawn then
                local p = (mainSpawn:IsA("BasePart") and mainSpawn.Position) or (mainSpawn:IsA("Model") and mainSpawn:GetPivot().Position)
                if p then
                    targetPos = p + Vector3.new(0, 3.5, 0)
                end
            end
        end

        -- B. Quét các cụm trong BREAK_ZONES (loại bỏ VIP, ưu tiên cụm gần Teleport pad/cổng vào)
        if not targetPos and interact then
            local bZones = interact:FindFirstChild("BREAK_ZONES") or interact:FindFirstChild("BreakZones") or bSpawns
            if bZones then
                local bestCluster = nil
                local bestScore = -1
                local bestDist = math.huge
                local refPos = tpPos or (interact:FindFirstChild("Gate") and interact.Gate.Position) or root.Position

                for _, child in ipairs(bZones:GetChildren()) do
                    -- Bỏ qua các spawn/zone có tên VIP
                    if not string.find(string.upper(child.Name), "VIP", 1, true) then
                        local parts = {}
                        if child:IsA("BasePart") then
                            parts[#parts + 1] = child
                        elseif child:IsA("Folder") or child:IsA("Model") then
                            for _, p in ipairs(child:GetDescendants()) do
                                if p:IsA("BasePart") then parts[#parts + 1] = p end
                            end
                        end
                        if #parts > 0 then
                            local cx, cz, n = 0, 0, 0
                            for _, p in ipairs(parts) do
                                cx = cx + p.Position.X
                                cz = cz + p.Position.Z
                                n = n + 1
                            end
                            cx = cx / n
                            cz = cz / n
                            local d = (Vector3.new(cx, 0, cz) - Vector3.new(refPos.X, 0, refPos.Z)).Magnitude
                            if #parts > bestScore or (#parts == bestScore and d < bestDist) then
                                bestScore = #parts
                                bestDist = d
                                bestCluster = parts
                            end
                        end
                    end
                end

                if bestCluster then
                    -- [FIX-7] Trong cụm đã chọn, tính centroid giống game (ZoneAnchor.breakZoneCenterTop):
                    -- X/Z = trung bình các BasePart, Y = top surface cao nhất.
                    local partCount = 0
                    local sumX, sumZ = 0, 0
                    local maxTop = -math.huge
                    for _, part in ipairs(bestCluster) do
                        partCount = partCount + 1
                        sumX = sumX + part.Position.X
                        sumZ = sumZ + part.Position.Z
                        local top = part.Position.Y + (part.CFrame.UpVector * (part.Size.Y / 2)).Y
                        if top > maxTop then maxTop = top end
                    end
                    if partCount > 0 then
                        targetPos = Vector3.new(sumX / partCount, maxTop, sumZ / partCount)
                    end
                end
            end
        end

        -- C. PERSISTENT.Teleport fallback (không cache làm vị trí bãi đào chính thức)
        if not targetPos and tpPart then
            targetPos = tpPart.Position + Vector3.new(0, 3.5, 0)
            isFallback = true
        end

        -- D. Gate / ZoneQuest fallback (không cache làm vị trí bãi đào chính thức)
        if not targetPos and interact then
            local gate = interact:FindFirstChild("Gate") or interact:FindFirstChild("ZoneQuest")
            if gate and gate:IsA("BasePart") then
                targetPos = gate.Position + Vector3.new(0, 3.5, 0)
                isFallback = true
            end
        end
    end

    -- 3. Fallback: Centroid từ BreakableCmds
    if not targetPos then
        pcall(function()
            local rawMap = BreakableCmds.AllByZoneAndClass(zoneName, "Normal")
            if rawMap then
                local totalPos = Vector3.new(0, 0, 0)
                local count = 0
                for uid, item in pairs(rawMap) do
                    local model = (typeof(item) == "Instance" and item) or (type(item) == "table" and item.model)
                    if model and model:IsA("Model") then
                        local okP, pivot = pcall(function() return model:GetPivot() end)
                        if okP and pivot then
                            totalPos = totalPos + pivot.Position
                            count = count + 1
                        end
                    end
                end
                if count >= 1 then
                    targetPos = (totalPos / count) + Vector3.new(0, 3.5, 0)
                end
            end
        end)
    end

    if targetPos then
        if not isFallback then
            zoneFieldPositionCache[zoneName] = targetPos
        end

        local dist = (root.Position - targetPos).Magnitude
        if dist > 20 then
            local safeFloor = workspace:FindFirstChild("MapAuto_SafeFloor")
            if not safeFloor then
                safeFloor = Instance.new("Part")
                safeFloor.Name = "MapAuto_SafeFloor"
                safeFloor.Size = Vector3.new(160, 6, 160)
                safeFloor.Anchored = true
                safeFloor.CanCollide = true
                safeFloor.Transparency = 1
                safeFloor.Parent = workspace
            end
            safeFloor.Size = Vector3.new(160, 6, 160)
            safeFloor.CFrame = CFrame.new(targetPos - Vector3.new(0, 4, 0))

            SetMachineTeleporting()
            pcall(function()
                char:PivotTo(CFrame.new(targetPos))
                root.CFrame = CFrame.new(targetPos)
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end)
            task.defer(function()
                pcall(function()
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end)
                -- timestamp lock tự hết hạn sau MACHINE_TELEPORT_LOCK_MS, không cần reset
            end)
            print(string.format("[MapAuto::Teleport] 📍 Snapped to Zone '%s' (%.1f, %.1f, %.1f | dist: %.1f studs).", tostring(zoneName), targetPos.X, targetPos.Y, targetPos.Z, dist))
        end
    end
end

local ZoneManager = {}
local lastZoneDebugTime = 0

-- [FIX-1] Backoff per-zone sau khi purchase bị từ chối: không spam remote
local ZONE_PURCHASE_COOLDOWN_S = 60
local zonePurchaseCooldown = {} -- zoneKey (zoneData._id) -> os.clock() khi hết hạn chờ

local function IsEligibleToPurchaseZone(zoneNumber)
    local ok, res = pcall(function()
        local requireRebirth = true
        if FFlags and FFlags.Get and FFlags.Keys and FFlags.Keys.Zones_RequireRebirth then
            requireRebirth = FFlags.Get(FFlags.Keys.Zones_RequireRebirth)
        end
        if not requireRebirth then return true end
        local nextRebirth = RebirthCmds and RebirthCmds.GetNextRebirth and RebirthCmds.GetNextRebirth()
        if not nextRebirth then return true end
        if nextRebirth.ZoneNumberRequired and zoneNumber and nextRebirth.ZoneNumberRequired < zoneNumber then
            return false
        end
        return true
    end)
    return ok and res ~= false
end

function ZoneManager.Step()
    if not getgenv().MapAutoConfig.AutoMap then return end

    -- NOTE: Vị trí character được xử lý bởi Tether Thread riêng biệt (bên dưới)
    -- KHÔNG gọi FastTeleportToZoneCenter ở đây để tránh conflict cache

    local zoneName, zoneData = ZoneCmds.GetNextZone()
    if not zoneData then
        return -- Đã mở hết map cuối
    end

    local zoneKey = tostring(zoneData._id or zoneName)

    local hasQuestsDone = true
    pcall(function()
        if ZoneCmds.HasCompletedNextZoneQuests then
            hasQuestsDone = ZoneCmds.HasCompletedNextZoneQuests()
        end
    end)

    local currency = zoneData.Currency or "Coins"
    local price = 0
    pcall(function()
        price = Balancing.CalcGatePrice(zoneData) or 0
    end)

    local myCoins = 0
    pcall(function()
        myCoins = CurrencyCmds.Get(currency) or 0
    end)

    local canAfford = true
    if price > 0 then
        pcall(function()
            canAfford = CurrencyCmds.CanAfford(currency, price)
        end)
    end

    local now = os.clock()
    if now - lastZoneDebugTime > 8 then
        lastZoneDebugTime = now
        local pct = (price > 0 and math.floor((myCoins / price) * 100)) or 100
        print(string.format("[MapAuto::Zone Debug] Next Zone: '%s' | Cost: %s %s | Balance: %s (%d%%) | QuestsDone: %s", tostring(zoneData._id), tostring(price), tostring(currency), tostring(myCoins), pct, tostring(hasQuestsDone)))
    end

    if not hasQuestsDone then return end

    -- [FIX-1] Skip nếu đang trong thời gian backoff sau lần bị từ chối
    local cooldownUntil = zonePurchaseCooldown[zoneKey]
    if cooldownUntil and now < cooldownUntil then
        return
    end

    -- [FIX-1] Không mua bừa khi không tính được giá (tránh spam remote trên zone lạ)
    if price <= 0 then
        zonePurchaseCooldown[zoneKey] = now + ZONE_PURCHASE_COOLDOWN_S
        warn(string.format("[MapAuto::Zone] ⚠ Không tính được giá zone '%s' (price=%s) — bỏ qua mua %ds.", zoneKey, tostring(price), ZONE_PURCHASE_COOLDOWN_S))
        return
    end

    -- [FIX-1] Check eligibility giống game: cần Rebirth nếu flag Zones_RequireRebirth bật
    if not IsEligibleToPurchaseZone(zoneData.ZoneNumber) then
        zonePurchaseCooldown[zoneKey] = now + ZONE_PURCHASE_COOLDOWN_S
        warn(string.format("[MapAuto::Zone] ⚠ Zone '%s' yêu cầu Rebirth cao hơn — chờ %ds trước khi thử lại.", zoneKey, ZONE_PURCHASE_COOLDOWN_S))
        return
    end

    if canAfford then
        print(string.format("[MapAuto] Buying Zone: %s (Cost: %s %s)", tostring(zoneData._id), tostring(price), tostring(currency)))
        
        NetworkQueue:enqueue(function()
            local ok, msg = Network.Invoke("Zones_RequestPurchase", zoneData._id)
            return { ok = ok, msg = msg }
        end, function(success, res)
            local purchased = success and type(res) == "table" and res.ok
            if purchased then
                print("[MapAuto] Successfully unlocked Zone: " .. tostring(zoneData._id))
                -- [FIX-3] Set pending zone + invalidate cache ngay sau khi mua thành công
                -- Tether sẽ dùng pendingFarmZone thay vì zone cũ trong khi GetMaxOwnedZone() sync
                pendingFarmZone = zoneData._id
                pendingFarmZoneTime = os.clock()
                for k in pairs(zoneFieldPositionCache) do zoneFieldPositionCache[k] = nil end  -- xóa cache vị trí cũ (giữ ref genv hợp lệ)
                lastStreamedZone = ""       -- force re-stream zone mới
                zonePurchaseCooldown[zoneKey] = nil
                task.spawn(function()
                    task.wait(0.1)
                    FastTeleportToZoneCenter(zoneData._id)
                end)
            else
                -- [FIX-1] Purchase bị từ chối (server): backoff, không spam
                zonePurchaseCooldown[zoneKey] = os.clock() + ZONE_PURCHASE_COOLDOWN_S
                local reason = type(res) == "table" and tostring(res.msg) or tostring(res)
                warn(string.format("[MapAuto::Zone] ⚠ Purchase '%s' bị từ chối: %s — chờ %ds.", zoneKey, reason, ZONE_PURCHASE_COOLDOWN_S))
            end
        end)
    end
end

-- THREAD: Tether - Giữ nhân vật 100% tại tâm bãi đào, tự động hồi phục khi rơi void hoặc lệch quá 35 studs
local lastTetherSnap = 0
task.spawn(function()
    -- [FIX-4] Pre-cache Variables 1 lần ngoài vòng lặp, không gọi LoadModule mỗi 0.25s
    local Variables = LoadModule(Library, "Variables")

    while Running() do
        task.wait(0.25)
        local ok, err = pcall(function()
            -- Safe guard: Respect game's internal transition states
            if Variables then
                if Variables.IsUsingCannon or Variables.IsRebirthing or
                   Variables.IsTeleportingWorld2 or Variables.IsTeleportingWorld3 or Variables.IsTeleportingWorld4 then
                    return
                end
            end

            if IsMachineTeleporting() then return end
            local targetZone = GetBestFarmingZone()
            if not targetZone then return end

            local char = LocalPlayer.Character
            local root = char and char.PrimaryPart
            if not root then return end

            local charY = root.Position.Y
            local targetPos = zoneFieldPositionCache[targetZone]

            -- Can thiệp khi:
            -- A) Char đang rơi void sâu dưới tâm bãi (> 25 studs dưới targetPos.Y) hoặc bị hất lên trời (> 500 studs)
            -- B) Char bị đẩy lệch khỏi tâm bãi (> 35 studs)
            local isInVoid = (targetPos and (charY < targetPos.Y - 25 or charY > targetPos.Y + 500)) or (not targetPos and charY < -500)
            local isTooFar = not targetPos or ((root.Position - targetPos).Magnitude > 35)

            if not isInVoid and not isTooFar then return end
            if os.clock() - lastTetherSnap < 0.6 then return end

            -- Lấy targetPos nếu chưa có trong cache hoặc đang trong void / quá xa
            if not targetPos or isInVoid or isTooFar then
                FastTeleportToZoneCenter(targetZone)
                targetPos = zoneFieldPositionCache[targetZone]
            end

            if not targetPos then return end

            lastTetherSnap = os.clock()
            print(string.format("[MapAuto::Tether] ⚓ %s (Y=%.1f) -> lock to zone '%s' (%.1f, %.1f, %.1f)",
                isInVoid and "VOID RECOVERY" or "ANTI-OUT-OF-BOUNDS",
                charY, tostring(targetZone), targetPos.X, targetPos.Y, targetPos.Z))

            local safeFloor = workspace:FindFirstChild("MapAuto_SafeFloor")
            if not safeFloor then
                safeFloor = Instance.new("Part")
                safeFloor.Name = "MapAuto_SafeFloor"
                safeFloor.Size = Vector3.new(160, 6, 160)
                safeFloor.Anchored = true
                safeFloor.CanCollide = true
                safeFloor.Transparency = 1
                safeFloor.Parent = workspace
            end
            safeFloor.Size = Vector3.new(160, 6, 160)
            safeFloor.CFrame = CFrame.new(targetPos - Vector3.new(0, 4, 0))

            local snapPos = targetPos + Vector3.new(0, 3, 0)
            SetMachineTeleporting() -- [FIX-1] timestamp lock thay vì boolean
            pcall(function()
                char:PivotTo(CFrame.new(snapPos))
                root.CFrame = CFrame.new(snapPos)
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end)

            task.defer(function()
                pcall(function()
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end)
                -- timestamp lock tự hết hạn, không cần reset
            end)
        end)
        if not ok and err then
            warn("[MapAuto Tether Error]: " .. tostring(err))
        end
    end
end)

