local SmartRankManager = {}
local lastItemSpawnTime = {}
local lastSpawnRetryAt = {}
local lastSpawnFailLog = {}

-- Spawn một event item (Coin Jar / Comet / Pinata / Lucky Block) có kiểm tra kết quả.
-- Chỉ tính cooldown 45s khi spawn THÀNH CÔNG; nếu server từ chối (khu đang có event item khác
-- -> "There is already something in this area!") thì retry lại sau 10s thay vì đốt hết 45s.
-- Vì jar/comet dùng chung quy tắc "một event item mỗi khu", cần retry nhanh để không kẹt quest.
local function TrySpawnEventItem(key, remoteName, uid, label)
    if not uid then return false end
    local now = os.clock()
    local successWindow = 45
    local failCooldown = 10
    if now - (lastItemSpawnTime[key] or 0) <= successWindow and now < (lastSpawnRetryAt[key] or 0) then
        return false
    end
    local ok, v1, v2 = pcall(function()
        return Network.Invoke(remoteName, uid)
    end)
    if ok and v1 then
        lastItemSpawnTime[key] = now
        lastSpawnRetryAt[key] = 0
        print(string.format("[MapAuto] 🎯 Active Rank Goal: %s -> spawned OK.", tostring(label)))
        return true
    end
    lastSpawnRetryAt[key] = now + failCooldown
    if now - (lastSpawnFailLog[key] or 0) > 30 then
        lastSpawnFailLog[key] = now
        print(string.format("[MapAuto] ⚠ %s spawn rejected (retry in %ds): %s", tostring(label), failCooldown, tostring(v2 or "(no reason)")))
    end
    return false
end

-- UID blacklist: khi server liên tục reject 1 UID -> skip nó 120s
-- structure: { [uid] = { failCount, blacklistedAt } }
local machineUIDFailTracker = {}

local function isBlacklisted(uid)
    if not uid then return false end
    local key = tostring(uid)
    local entry = machineUIDFailTracker[key]
    if not entry or entry.failCount < 2 then return false end
    -- Lần đầu chạm ngưỡng (failCount >= 2): bắt đầu đếm 120s tại thời điểm này
    if not entry.blacklistedAt then
        entry.blacklistedAt = os.clock()
    end
    if os.clock() - entry.blacklistedAt < 120 then
        return true
    else
        -- Hết 120s -> reset để cho thử lại 1 lần
        machineUIDFailTracker[key] = nil
        return false
    end
end

local currentlyCraftingPetUIDs = {}

local function FindPetUIDForMachine(machineType, isBestEggOnly)
    -- machineType: "Gold" or "Rainbow"
    local costPerPet = 10
    pcall(function()
        local MasteryCmds = LoadModule(Client, "MasteryCmds")
        if MasteryCmds and MasteryCmds.HasPerk and MasteryCmds.GetPerkPower then
            local perkName = (machineType == "Gold" and "GoldReduction") or "RainbowReduction"
            if MasteryCmds.HasPerk("Pets", perkName) then
                costPerPet = math.max(1, 10 - (MasteryCmds.GetPerkPower("Pets", perkName) or 0))
            end
        end
    end)

    -- Nếu quest yêu cầu Best Egg pet: build danh sách pet IDs từ Best Egg
    local bestEggPetSet = nil
    if isBestEggOnly then
        bestEggPetSet = {}
        pcall(function()
            local maxZoneName, maxZoneData = ZoneCmds.GetMaxOwnedZone()
            local zoneDef = Directory and Directory.Zones
                and (Directory.Zones[maxZoneName] or (maxZoneData and maxZoneData._id and Directory.Zones[maxZoneData._id]))
            local maxEggNum = (zoneDef and (zoneDef.MaximumAvailableEgg or zoneDef.maximumAvailableEgg)) or 1

            if Directory and Directory.Eggs then
                for eggID, eggData in pairs(Directory.Eggs) do
                    if eggData.eggNumber == maxEggNum and eggData.pets then
                        for _, petDrop in ipairs(eggData.pets) do
                            if petDrop and petDrop[1] then
                                bestEggPetSet[tostring(petDrop[1])] = true
                            end
                        end
                        break
                    end
                end
            end
        end)
    end

    -- Build set of pet UIDs currently in daycare
    local daycareUIDs = {}
    local saveDataForDaycare = Save.Get()
    if saveDataForDaycare then
        for _, slot in pairs(saveDataForDaycare.DaycareActive or {}) do
            local petUID = slot.Pet and (slot.Pet._id or slot.Pet._uid or slot.Pet.uid)
            if petUID then daycareUIDs[tostring(petUID)] = true end
        end
        for _, slot in pairs(saveDataForDaycare.ExclusiveDaycareActive or {}) do
            local petUID = slot.Pet and (slot.Pet._id or slot.Pet._uid or slot.Pet.uid)
            if petUID then daycareUIDs[tostring(petUID)] = true end
        end
    end

    local successContainer, container = pcall(function() return InventoryCmds.Container() end)
    if successContainer and container then
        for _, item in pairs(container:All()) do
            if item and type(item.GetClass) == "function" and item:GetClass() == "Pet" then
                local isGold = false
                local isRainbow = false
                local canCraft = true
                local isEquipped = false
                local isLocked = false

                pcall(function() isGold = item:IsGolden() end)
                pcall(function() isRainbow = item:IsRainbow() end)
                pcall(function() if item.CanGoldMachine then canCraft = item:CanGoldMachine() end end)
                pcall(function() if item.IsEquipped then isEquipped = item:IsEquipped() end end)
                pcall(function() if item.IsLocked then isLocked = item:IsLocked() end end)

                local uidStr = nil
                pcall(function() uidStr = item:GetUID() end)

                local petId = nil
                pcall(function() petId = item:GetId() end)

                local count = 1
                pcall(function() count = item:GetAmount() end)

                -- Exclude non-best-egg pets if required
                if isBestEggOnly and bestEggPetSet and petId and not bestEggPetSet[tostring(petId)] then
                    canCraft = false
                end
                -- Exclude daycare pets
                if uidStr and daycareUIDs[tostring(uidStr)] then canCraft = false end
                -- Exclude blacklisted UIDs
                if uidStr and isBlacklisted(tostring(uidStr)) then canCraft = false end
                -- Exclude currently crafting UIDs (prevent race condition between GOLD_PET and RAINBOW_PET)
                if uidStr and currentlyCraftingPetUIDs[tostring(uidStr)] then canCraft = false end

                if canCraft and not isEquipped and not isLocked and uidStr then
                    if machineType == "Gold" then
                        if not isGold and not isRainbow and count >= costPerPet then
                            local expectedCrafts = math.floor(count / costPerPet)
                            local petsToUse = expectedCrafts * costPerPet
                            return uidStr, petsToUse, expectedCrafts
                        end
                    elseif machineType == "Rainbow" then
                        if isGold and not isRainbow and count >= costPerPet then
                            local expectedCrafts = math.floor(count / costPerPet)
                            local petsToUse = expectedCrafts * costPerPet
                            return uidStr, petsToUse, expectedCrafts
                        end
                    end
                end
            end
        end
    end

    local saveData = Save.Get()
    if saveData and saveData.Inventory and saveData.Inventory.Pet then
        for uid, petData in pairs(saveData.Inventory.Pet) do
            -- skip: equipped (eq), locked (l), in daycare (check daycareUIDs set)
            local uidStr = tostring(uid)
            if type(petData) == "table" and not petData.eq and not petData.e and not petData.l
                and not daycareUIDs[uidStr] and not isBlacklisted(uidStr) and not currentlyCraftingPetUIDs[uidStr] then
                local petId = petData.id or petData._id
                local isAllowed = not (isBestEggOnly and bestEggPetSet and petId and not bestEggPetSet[tostring(petId)])
                if isAllowed then
                    local pt = petData.pt or 0
                    local count = petData._am or 1
                    if machineType == "Gold" and pt == 0 and count >= costPerPet then
                        local expectedCrafts = math.floor(count / costPerPet)
                        local petsToUse = expectedCrafts * costPerPet
                        return uidStr, petsToUse, expectedCrafts
                    elseif machineType == "Rainbow" and pt == 1 and count >= costPerPet then
                        local expectedCrafts = math.floor(count / costPerPet)
                        local petsToUse = expectedCrafts * costPerPet
                        return tostring(uid), petsToUse, expectedCrafts
                    end
                end
            end
        end
    end

    return nil, 0, 0
end

local function FindLowestTierCraftableItem(category, targetTier)
    -- category: "Enchant" or "Potion"
    -- targetTier: optional (e.g. 3 means target craft Tier 3 by using Tier 2 items)
    local bestUID = nil
    local lowestTier = 999
    local maxCraftable = 0
    local foundItemName = ""

    local dirCategory = (category == "Enchant" and Directory and Directory.Enchants)
        or (category == "Potion" and Directory and Directory.Potions)

    local numTargetTier = tonumber(targetTier)
    local function MatchesTargetTier(tier)
        if numTargetTier and numTargetTier > 1 then
            return tier == (numTargetTier - 1)
        end
        return true
    end

    pcall(function()
        local successContainer, container = pcall(function() return InventoryCmds.Container() end)
        if successContainer and container then
            local allItems = (type(container.All) == "function" and container:All()) or container._byUID
            if allItems then
                for uid, item in pairs(allItems) do
                    local uidStr = tostring(uid)
                    if item and not isBlacklisted(uidStr) then
                        local itemCat = (type(item.GetCategory) == "function" and item:GetCategory()) or item._category or item.Category
                        local isMatch = false
                        if itemCat and tostring(itemCat):lower() == category:lower() then
                            isMatch = true
                        elseif type(item.IsA) == "function" and item:IsA(category) then
                            isMatch = true
                        end

                        if isMatch then
                            local id = (type(item.GetId) == "function" and item:GetId()) or item._id or item.id or ""
                            local itemDef = dirCategory and dirCategory[id]
                            local maxTier = (itemDef and itemDef.MaxTier) or 99
                            local tier = (type(item.GetTier) == "function" and item:GetTier()) or item.tn or item.tier or 1

                            -- Only craftable if current tier is less than max tier and matches target tier requirements
                            if tier < maxTier and MatchesTargetTier(tier) then
                                local amount = (type(item.GetAmount) == "function" and item:GetAmount()) or item._am or item.amount or 1
                                local reqPerTier = 5
                                if category == "Enchant" and Balancing and Balancing.CalcEnchantsPerTierRequired then
                                    reqPerTier = Balancing.CalcEnchantsPerTierRequired(tier) or 5
                                elseif category == "Potion" and Balancing and Balancing.CalcPotionsPerTierRequired then
                                    reqPerTier = Balancing.CalcPotionsPerTierRequired(tier) or 5
                                end

                                local craftCount = math.floor(amount / reqPerTier)
                                if craftCount >= 1 and tier < lowestTier then
                                    lowestTier = tier
                                    bestUID = uidStr
                                    maxCraftable = craftCount
                                    foundItemName = id ~= "" and id or category
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

    if not bestUID then
        local saveData = Save.Get()
        if saveData and saveData.Inventory and saveData.Inventory[category] then
            for uid, itemData in pairs(saveData.Inventory[category]) do
                local uidStr = tostring(uid)
                if type(itemData) == "table" and not isBlacklisted(uidStr) then
                    local id = tostring(itemData.id or itemData._id or "")
                    local itemDef = dirCategory and dirCategory[id]
                    local maxTier = (itemDef and itemDef.MaxTier) or 99
                    local tier = itemData.tn or itemData.tier or 1

                    if tier < maxTier and MatchesTargetTier(tier) then
                        local amount = itemData._am or itemData.amount or 1
                        local reqPerTier = (category == "Enchant" and Balancing and Balancing.CalcEnchantsPerTierRequired and Balancing.CalcEnchantsPerTierRequired(tier))
                            or (category == "Potion" and Balancing and Balancing.CalcPotionsPerTierRequired and Balancing.CalcPotionsPerTierRequired(tier))
                            or 5
                        local craftCount = math.floor(amount / reqPerTier)
                        if craftCount >= 1 and tier < lowestTier then
                            lowestTier = tier
                            bestUID = uidStr
                            maxCraftable = craftCount
                            foundItemName = id ~= "" and id or category
                        end
                    end
                end
            end
        end
    end

    return bestUID, lowestTier, maxCraftable, foundItemName
end

local machineBlacklistUntil = {}

local function SafeMachineInvoke(machineName, remoteName, itemUID, craftAmount)
    local now = os.clock()
    if machineBlacklistUntil[machineName] and now < machineBlacklistUntil[machineName] then
        return false, "Machine temporarily blacklisted (cooldown active)"
    end

    -- Thử remote invoke trực tiếp (sẽ thành công nếu có Supercomputer Radio hoặc đang đứng gần máy)
    local ok, res, errMsg = pcall(function() return Network.Invoke(remoteName, itemUID, craftAmount) end)
    if ok and res then return true, res end

    local errStr = tostring(errMsg or res or "")
    if string.find(errStr, "don't own", 1, true) or string.find(errStr, "not own", 1, true) or string.find(errStr, "cannot use", 1, true) then
        machineBlacklistUntil[machineName] = now + 180 -- Tạm ngưng 180s tránh spam remote khi không sở hữu máy tại World hiện tại
    else
        machineBlacklistUntil[machineName] = now + 30
    end

    return false, (errMsg or "Machine invoke rejected")
end

