                if relicId and not ownedSet[relicId] then
                    table.insert(uncollectedList, relicId) -- giữ nguyên số nguyên
                end
            end

            if #uncollectedList > 0 then
                print(string.format("[MapAuto::Relics] Found %d uncollected shiny relics. Claiming...", #uncollectedList))
                for _, rId in ipairs(uncollectedList) do
                    pcall(function()
                        -- Server nhận số nguyên (p14.Id), không phải string
                        local success, count, boost = Network.Invoke("Relic_Found", rId)
                        if success then
