-- 10C. Webhook Notification Manager (Rank Up, Huge, Titanic, Gargantuan & Secret Pets)
-- ----------------------------------------------------------------------------
local WebhookManager = {}
local knownPetUIDs = {}
local isWebhookInitialized = false
local lastObservedRank = nil

local httpRequest = nil
pcall(function()
    if typeof(request) == "function" then
        httpRequest = request
    elseif typeof(http_request) == "function" then
        httpRequest = http_request
    else
        local env = getfenv()
        local synTable = rawget(env, "syn")
        if type(synTable) == "table" and type(synTable.request) == "function" then
            httpRequest = synTable.request
        else
            local httpTable = rawget(env, "http")
            if type(httpTable) == "table" and type(httpTable.request) == "function" then
                httpRequest = httpTable.request
            end
        end
    end
end)

local function SendDiscordWebhook(payload)
    local cfg = getgenv().MapAutoConfig and getgenv().MapAutoConfig.Webhook
    if not cfg or not cfg.Enabled then return end
    local url = cfg.Url or ""
    if url == "" or not httpRequest then return end

    -- Tự động ping Discord User ID nếu có config id
    local discordId = cfg.id or cfg.DiscordUserId
    if discordId and tostring(discordId) ~= "" and not payload.content then
        payload.content = string.format("<@%s>", tostring(discordId))
    end

    task.spawn(function()
        pcall(function()
            local encoded = HttpService:JSONEncode(payload)
            httpRequest({
                Url = url,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = encoded
            })
        end)
    end)
end

function WebhookManager.Init()
    if isWebhookInitialized then return end

    local saveData = Save.Get()
    if not saveData then return end

    -- 1. Snapshot toàn bộ Pet UIDs hiện có để tránh spam pet cũ
    pcall(function()
        local successContainer, container = pcall(function() return InventoryCmds.Container() end)
        if successContainer and container then
            local allItems = (type(container.All) == "function" and container:All()) or container._byUID
            if allItems then
                for uid, item in pairs(allItems) do
                    if item then
                        local uidStr = tostring(uid)
                        local isPet = false
                        pcall(function()
                            if type(item.GetCategory) == "function" and item:GetCategory() == "Pet" then isPet = true end
                            if type(item.IsA) == "function" and item:IsA("Pet") then isPet = true end
                        end)
                        if isPet or (type(item) == "table" and (item._category == "Pet" or item.Category == "Pet")) then
                            knownPetUIDs[uidStr] = true
                        end
                    end
                end
            end
        end

        if saveData.Inventory and saveData.Inventory.Pet then
            for uid, _ in pairs(saveData.Inventory.Pet) do
                knownPetUIDs[tostring(uid)] = true
            end
        end
    end)

    -- 2. Snapshot Rank hiện tại
    lastObservedRank = saveData.Rank or 1
    isWebhookInitialized = true

    local petCount = 0
    for _ in pairs(knownPetUIDs) do
        petCount = petCount + 1
    end
    print(string.format("[MapAuto::Webhook] 🔔 Webhook System Initialized. Known Pets: %d | Starting Rank: %d", petCount, lastObservedRank))
end

function WebhookManager.Step()
    local cfg = getgenv().MapAutoConfig and getgenv().MapAutoConfig.Webhook
    if not cfg or not cfg.Enabled then return end
    if not isWebhookInitialized then
        WebhookManager.Init()
        return
    end

    local saveData = Save.Get()
    if not saveData then return end

    local playerName = LocalPlayer.Name
    local playerDisplayName = LocalPlayer.DisplayName

    -- Lấy thông tin Diamond hiện tại
    local diamonds = 0
    pcall(function()
        if CurrencyCmds and CurrencyCmds.Get then
            diamonds = CurrencyCmds.Get("Diamonds") or 0
        elseif saveData.Diamonds then
            diamonds = saveData.Diamonds
        elseif saveData.Inventory and saveData.Inventory.Currency and saveData.Inventory.Currency.Diamonds then
            diamonds = saveData.Inventory.Currency.Diamonds._am or 0
        end
    end)

    -- Lấy current best zone
    local currentZone = "Unknown"
    pcall(function()
        local successZone, ZoneCmds = pcall(function() return LoadModule(Client, "ZoneCmds") end)
        if successZone and ZoneCmds and ZoneCmds.GetMaxOwnedZone then
            currentZone = ZoneCmds.GetMaxOwnedZone()
        end
    end)

    -- ------------------------------------------------------------------------
    -- A. Rank Promotion Notification
    -- ------------------------------------------------------------------------
    if cfg.NotifyRankUp then
        local currentRank = saveData.Rank or 1
        if lastObservedRank and currentRank > lastObservedRank then
            local oldRank = lastObservedRank
            lastObservedRank = currentRank

            local rankId = RanksUtil.RankIDFromNumber(currentRank)
            local rankData = rankId and Directory.Ranks and Directory.Ranks[rankId]
            local rankTitle = (rankData and (rankData.RankTitle or rankData.Title)) or ("Rank " .. currentRank)

            print(string.format("[MapAuto::Webhook] Rank: Rank %d (%s)", currentRank, tostring(rankTitle)))
            SendDiscordWebhook({
                username = "PS99 Engine Telemetry",
                embeds = { {
                    title = "[PS99] Rank Promotion Achieved",
                    description = string.format("Account **%s** (@%s) promoted from **Rank %d** to **Rank %d (%s)**.", playerDisplayName, playerName, oldRank, currentRank, tostring(rankTitle)),
                    color = 16766720, -- Gold
                    fields = {
                        { name = "Account",    value = string.format("`%s` (@%s)", playerDisplayName, playerName), inline = true },
                        { name = "New Rank",   value = string.format("**Rank %d - %s**", currentRank, tostring(rankTitle)), inline = true },
                        { name = "Diamonds",   value = FormatNumber(diamonds), inline = true },
                        { name = "Timestamp",  value = os.date("%H:%M:%S - %Y/%m/%d"), inline = true },
                    },
                    footer = { text = "Pet Simulator 99" },
                    timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
                } },
            })
        end
    end

    -- ------------------------------------------------------------------------
    -- B. Rare Pet Discovery (Huge, Titanic, Gargantuan, Secret Pets)
    -- ------------------------------------------------------------------------
    if cfg.NotifyRarePets then
        local secretList = cfg.SecretWatchList or { "Rainbow Swirl", "Banana", "Coin", "Yellow Lucky Block", "Crown" }
        local secretSet = {}
        for _, sName in ipairs(secretList) do
            if sName and sName ~= "" then
                secretSet[sName:lower()] = sName
            end
        end

        local function CheckAndNotifyPet(uidStr, petId, isGolden, isRainbow, isShiny)
            if not petId or petId == "" then return end

            local petIdLower = petId:lower()
            local isGargantuan = string.find(petIdLower, "gargantuan") ~= nil
            local isTitanic = string.find(petIdLower, "titanic") ~= nil
            local isHuge = string.find(petIdLower, "huge") ~= nil
            local isSecret = secretSet[petIdLower] ~= nil

            if not (isGargantuan or isTitanic or isHuge or isSecret) then
                return
            end

            -- Determine Variant string
            local variantStr = "Regular"
            if isRainbow and isShiny then
                variantStr = "Rainbow Shiny"
            elseif isRainbow then
                variantStr = "Rainbow"
            elseif isGolden and isShiny then
                variantStr = "Golden Shiny"
            elseif isGolden then
                variantStr = "Golden"
            elseif isShiny then
                variantStr = "Shiny"
            end

            -- Determine Category & Embed Color
            local categoryTitle = "Special Pet"
            local embedColor = 10040319 -- Purple
            if isGargantuan then
                categoryTitle = "Gargantuan Pet"
                embedColor = 16711765 -- Red
            elseif isTitanic then
                categoryTitle = "Titanic Pet"
                embedColor = 16716947 -- Neon Pink
            elseif isHuge then
                categoryTitle = "Huge Pet"
                embedColor = 16766720 -- Gold
            elseif isSecret then
                categoryTitle = "Secret Pet"
                embedColor = 10181046 -- Mystic Purple
            end

            local embed = {
                ["title"] = string.format("[PS99] %s Obtained", categoryTitle),
                ["description"] = string.format("Account **%s** (@%s) obtained **%s %s**.", playerDisplayName, playerName, variantStr, petId),
                ["color"] = embedColor,
                ["fields"] = {
                    { ["name"] = "Pet Name", ["value"] = string.format("**%s**", petId), ["inline"] = true },
                    { ["name"] = "Classification", ["value"] = categoryTitle, ["inline"] = true },
                    { ["name"] = "Variant", ["value"] = variantStr, ["inline"] = true },
                    { ["name"] = "Account", ["value"] = string.format("`%s` (@%s)", playerDisplayName, playerName), ["inline"] = true },
                    { ["name"] = "Timestamp", ["value"] = os.date("%H:%M:%S - %Y/%m/%d"), ["inline"] = true }
                },
                ["footer"] = {
                    ["text"] = "Pet Simulator 99 Core Engine"
                },
                ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
            }

            print(string.format("[MapAuto::Webhook] Rare pet acquisition dispatched: %s (%s) for %s", petId, variantStr, playerName))
            SendDiscordWebhook({
                ["username"] = "PS99 Pet Telemetry",
                ["embeds"] = { embed }
            })
        end

        -- Quét qua Container Inventory
        pcall(function()
            local successContainer, container = pcall(function() return InventoryCmds.Container() end)
            if successContainer and container then
                local allItems = (type(container.All) == "function" and container:All()) or container._byUID
                if allItems then
                    for uid, item in pairs(allItems) do
                        local uidStr = tostring(uid)
                        if item and not knownPetUIDs[uidStr] then
                            knownPetUIDs[uidStr] = true

                            local isPet = false
                            pcall(function()
                                if type(item.GetCategory) == "function" and item:GetCategory() == "Pet" then isPet = true end
                                if type(item.IsA) == "function" and item:IsA("Pet") then isPet = true end
                            end)

                            if isPet or (type(item) == "table" and (item._category == "Pet" or item.Category == "Pet")) then
                                local petId = (type(item.GetId) == "function" and item:GetId()) or item._id or item.id or ""
                                local isGold = false
                                local isRainbow = false
                                local isShiny = false

                                pcall(function() if item.IsGolden then isGold = item:IsGolden() end end)
                                pcall(function() if item.IsRainbow then isRainbow = item:IsRainbow() end end)
                                pcall(function() if item.IsShiny then isShiny = item:IsShiny() end end)

                                if not isGold and (item.pt == 1) then isGold = true end
                                if not isRainbow and (item.pt == 2) then isRainbow = true end
                                if not isShiny and (item.sh == true) then isShiny = true end

                                CheckAndNotifyPet(uidStr, petId, isGold, isRainbow, isShiny)
                            end
                        end
                    end
                end
            end
        end)

        -- Quét qua Save Data Inventory
        if saveData.Inventory and saveData.Inventory.Pet then
            for uid, petData in pairs(saveData.Inventory.Pet) do
                local uidStr = tostring(uid)
                if not knownPetUIDs[uidStr] then
                    knownPetUIDs[uidStr] = true
                    if type(petData) == "table" then
                        local petId = tostring(petData.id or petData._id or "")
                        local isGold = (petData.pt == 1)
                        local isRainbow = (petData.pt == 2)
                        local isShiny = (petData.sh == true)

                        CheckAndNotifyPet(uidStr, petId, isGold, isRainbow, isShiny)
                    end
                end
            end
        end
    end
end

