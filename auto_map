                            print(string.format("[MapAuto::Relics] Claimed shiny relic #%s (total: %s).", tostring(rId), tostring(count)))
                        end
                    end)
                    task.wait(0.3)
                end
            end
        end)
    end)
end

-- ----------------------------------------------------------------------------
-- 10E. Auto Max Zone Egg Hatch Manager (Opens Best Egg Continuously at Last Zone)
-- ----------------------------------------------------------------------------
local MaxZoneEggManager = {}
local lastMaxEggLogTime = 0

-- Shared egg-purchase throttle + backoff.
-- The server's own hatch debounce is ~2.5s (ComputeDebounce + "FasterOpen" mastery).
-- Purchasing faster than that gets rejected and trips anti-cheat, so we pace at
-- >=2.5s and back off (up to 40s) whenever the server refuses a purchase.
local lastEggPurchaseTime = 0
local eggPurchaseFailStreak = 0
local EGG_PURCHASE_MIN_INTERVAL = 2.5
local EGG_PURCHASE_MAX_INTERVAL = 40

local function EggPurchaseReady(now)
    local interval = math.min(EGG_PURCHASE_MIN_INTERVAL * (2 ^ math.min(eggPurchaseFailStreak, 4)), EGG_PURCHASE_MAX_INTERVAL)
    return (now - lastEggPurchaseTime) >= interval
end

local function EggPurchaseDone(success, now)
    lastEggPurchaseTime = now
    if success then
        eggPurchaseFailStreak = 0
    else
        eggPurchaseFailStreak = eggPurchaseFailStreak + 1
    end
end

function MaxZoneEggManager.Step()
    if getgenv().MapAutoConfig.AutoHatchAtMaxZone == false then return end

    local now = os.clock()
    if not EggPurchaseReady(now) then return end

    -- Chỉ mở trứng liên tục khi đã ở map cuối cùng (GetNextZone() == nil)
    local isAtMaxContent = false
    pcall(function()
        local nextZoneName, nextZoneData = ZoneCmds.GetNextZone()
        isAtMaxContent = (nextZoneName == nil and nextZoneData == nil)
    end)
    if not isAtMaxContent then return end

    local saveData = Save.Get()
    if not saveData then return end

    local maxEggNum = saveData.MaximumAvailableEgg or 1
    local targetEggID = nil
    if Directory and Directory.Eggs then
        for eggID, eggData in pairs(Directory.Eggs) do
            if eggData.eggNumber == maxEggNum then
                targetEggID = eggID
                break
            end
        end
    end

    if targetEggID then
        local maxHatch = 1
        pcall(function()
            local successEggCmd, EggCmds = pcall(function() return LoadModule(Client, "EggCmds") end)
            if successEggCmd and EggCmds and EggCmds.GetMaxHatch then
                maxHatch = EggCmds.GetMaxHatch()
            else
                maxHatch = saveData.EggHatchCount or 1
            end
        end)

        if now - lastMaxEggLogTime > 20 then
            lastMaxEggLogTime = now
            print(string.format("[MapAuto::Hatch] 🥚 Max Zone reached! Auto Hatching Best Egg '%s' (x%d slots) continuously...", tostring(targetEggID), maxHatch))
        end

        pcall(function()
            task.spawn(function()
                local ok, res = pcall(Network.Invoke, "Eggs_RequestPurchase", targetEggID, maxHatch)
                EggPurchaseDone(ok and type(res) == "boolean" and res == true, now)
            end)
        end)
    end
end

