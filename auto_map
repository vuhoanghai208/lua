-- ============================================================================
-- BLOCK CANNON TELEPORT (same-world only): Server fires "Cannon Teleport" after
-- every zone switch. Our bot does instant CFrame snap → would double-teleport.
-- BUT World 2/3/4 transitions also use "Cannon Teleport" signal → must allow those.
-- Solution: check Variables.IsTeleportingWorldX before deciding to block.
-- ============================================================================
pcall(function()
    local Signal = LoadModule(Library, "Signal")
    local Variables = LoadModule(Library, "Variables")
    if Signal and Signal.Fire and Variables then
        local _origFire = Signal.Fire
        Signal.Fire = function(name, ...)
            -- Only block within-world cannon when NOT doing a world transition
            if name == "Cannon Teleport" or name == "Cannon: Started" then
                local isWorldTransition = Variables.IsTeleportingWorld2
                    or Variables.IsTeleportingWorld3
                    or Variables.IsTeleportingWorld4
                if not isWorldTransition then
                    -- Same-world zone hop → bot already snapped CFrame → drop cannon
                    return
                end
                -- World transition → let cannon run normally
            end
            return _origFire(name, ...)
        end
        RegisterPatch(Signal, "Fire", _origFire)
        print("[MapAuto] ✅ Cannon block active (same-world only, world transitions allowed)")
    else
        warn("[MapAuto] ⚠ Signal/Variables not found — cannon block skipped")
    end
end)

-- Inlined Standalone Network Queue & Rate Limiter
local NetworkQueue = {}
local queueList = {}
local isProcessingQueue = false

function NetworkQueue:enqueue(actionFunc, onSuccess, onError)
    table.insert(queueList, { action = actionFunc, success = onSuccess, err = onError })
    if not isProcessingQueue then
        isProcessingQueue = true
        task.spawn(function()
            while #queueList > 0 do
                if not Running() then break end
                local item = table.remove(queueList, 1)
                local success, res = pcall(item.action)
                if success then
                    if item.success then pcall(item.success, true, res) end
                else
                    if item.err then pcall(item.err, res) end
                end
                task.wait(0.15)
            end
            isProcessingQueue = false
        end)
    end
end

-- Global Inventory Item UID Finder Helper (Exact Matching First)
local function GetInventoryItemUID(category, itemIdName)
    if not itemIdName then return nil end
    local targetLower = tostring(itemIdName):lower()
    local foundUid = nil

    -- 1. Scan via InventoryCmds Container (Live in-memory items)
    pcall(function()
        local successContainer, container = pcall(function() return InventoryCmds.Container() end)
        if successContainer and container then
            local allItems = nil
            pcall(function()
                if type(container.All) == "function" then
                    allItems = container:All()
                elseif container._byUID then
                    allItems = container._byUID
                end
            end)
            if allItems then
                -- Pass 1: Exact Match (e.g. "Coins Flag" == "Coins Flag")
                for uid, item in pairs(allItems) do
                    if item then
                        local id = (type(item.GetId) == "function" and item:GetId()) or item._id or item.id
                        if id and tostring(id):lower() == targetLower then
                            foundUid = tostring(uid)
                            return
                        end
                    end
                end
                -- Pass 2: With Category validation if specified
                if not foundUid and category then
                    for uid, item in pairs(allItems) do
                        if item then
                            local itemCat = (type(item.GetCategory) == "function" and item:GetCategory()) or item._category or item.Category
                            local id = (type(item.GetId) == "function" and item:GetId()) or item._id or item.id
                            if id and itemCat and tostring(itemCat):lower() == tostring(category):lower() then
                                if tostring(id):lower() == targetLower then
                                    foundUid = tostring(uid)
                                    return
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

    if foundUid then return foundUid end

    -- 2. Scan via Save Data Inventory
    local saveData = Save.Get()
    if saveData and saveData.Inventory then
        -- Ưu tiên tìm trong đúng category trước (e.g. Save.Inventory.Misc)
        if category and saveData.Inventory[category] and type(saveData.Inventory[category]) == "table" then
            for uid, itemData in pairs(saveData.Inventory[category]) do
                if type(itemData) == "table" then
                    local id = tostring(itemData.id or itemData._id or "")
                    if id:lower() == targetLower then
                        return tostring(uid)
                    end
                end
            end
        end

        -- Quét toàn bộ các category khác (Exact Match)
        for catName, catTable in pairs(saveData.Inventory) do
            if type(catTable) == "table" then
                for uid, itemData in pairs(catTable) do
                    if type(itemData) == "table" then
                        local id = tostring(itemData.id or itemData._id or "")
                        if id:lower() == targetLower then
                            return tostring(uid)
                        end
                    end
                end
            end
        end
    end

    return nil
end

