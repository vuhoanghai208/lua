-- Dynamic Module Loader (Bypasses Executor IDE Static Typechecker Linter Warnings)
local function LoadModule(parent, moduleName)
    if not parent then
        warn(string.format("[MapAuto] Module loader: parent nil for '%s'", tostring(moduleName)))
        return nil
    end
    local target = nil
    local okFind = pcall(function()
        target = parent:WaitForChild(moduleName, 30)
    end)
    if not okFind or not target then
        warn(string.format("[MapAuto] Module loader: '%s' not found under %s (30s timeout)", tostring(moduleName), tostring(parent.Name)))
        return nil
    end
    local okReq, mod = pcall(require, target)
    if not okReq then
        warn(string.format("[MapAuto] Module loader: require failed for '%s': %s", tostring(moduleName), tostring(mod)))
        return nil
    end
    return mod
end

