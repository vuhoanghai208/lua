                end

                if workspace.Terrain then
                    pcall(function()
                        workspace.Terrain.WaterWaveSize = 0
                        workspace.Terrain.WaterWaveSpeed = 0
                        workspace.Terrain.WaterReflectance = 0
                        workspace.Terrain.WaterTransparency = 1
                    end)
                end

                -- 2. Visual Particle & Effect Stripper for Orbs & Lootbags (Preserves Coin Collection)
                local thingsFolder = workspace:FindFirstChild("__THINGS")
                if thingsFolder then
                    -- Visual Stripper for Orbs (Disable heavy particles without destroying instance)
                    local orbsFolder = thingsFolder:FindFirstChild("Orbs")
                    if orbsFolder then
                        local function CleanOrbVisuals(child)
                            task.defer(function()
                                pcall(function()
                                    for _, desc in ipairs(child:GetDescendants()) do
                                        if desc:IsA("ParticleEmitter") or desc:IsA("Sparkles") or desc:IsA("Beam") or desc:IsA("Trail") then
                                            desc.Enabled = false
                                        elseif desc:IsA("PointLight") or desc:IsA("SpotLight") or desc:IsA("SurfaceLight") or desc:IsA("Highlight") then
                                            desc.Enabled = false
                                        end
                                    end
                                end)
                            end)
                        end
                        AddConnection(orbsFolder.ChildAdded:Connect(CleanOrbVisuals))
                        for _, child in ipairs(orbsFolder:GetChildren()) do
                            CleanOrbVisuals(child)
                        end
                    end

                    -- Visual Stripper for Lootbags (Disable heavy particles without destroying instance)
                    local lootbagsFolder = thingsFolder:FindFirstChild("Lootbags")
                    if lootbagsFolder then
                        local function CleanLootbagVisuals(child)
                            task.defer(function()
                                pcall(function()
                                    for _, desc in ipairs(child:GetDescendants()) do
                                        if desc:IsA("ParticleEmitter") or desc:IsA("Sparkles") or desc:IsA("Beam") or desc:IsA("Trail") then
                                            desc.Enabled = false
                                        elseif desc:IsA("PointLight") or desc:IsA("SpotLight") or desc:IsA("SurfaceLight") or desc:IsA("Highlight") then
                                            desc.Enabled = false
                                        end
                                    end
                                end)
                            end)
                        end
                        AddConnection(lootbagsFolder.ChildAdded:Connect(CleanLootbagVisuals))
                        for _, child in ipairs(lootbagsFolder:GetChildren()) do
                            CleanLootbagVisuals(child)
                        end
                    end

                    -- 2B. Optimize & Hide Breakables (Transparent + Remove Visual Effects)
                    local breakablesFolder = thingsFolder:FindFirstChild("Breakables")
                    if breakablesFolder then
                        local function CleanBreakable(child)
                            task.defer(function()
                                pcall(function()
                                    local hide = getgenv().MapAutoConfig and getgenv().MapAutoConfig.HideBreakables
                                    for _, desc in ipairs(child:GetDescendants()) do
                                        if desc:IsA("ParticleEmitter") or desc:IsA("Sparkles") or desc:IsA("Highlight") or desc:IsA("PointLight") or desc:IsA("SpotLight") or desc:IsA("SurfaceLight") or desc:IsA("Beam") or desc:IsA("Trail") or desc:IsA("Smoke") or desc:IsA("Fire") then
                                            pcall(function() desc:Destroy() end)
                                        elseif desc:IsA("BillboardGui") then
                                            pcall(function() desc.Enabled = false end)
                                        elseif desc:IsA("Decal") or desc:IsA("Texture") then
                                            if hide then
                                                pcall(function() desc.Transparency = 1 end)
                                            else
                                                pcall(function() desc:Destroy() end)
                                            end
                                        elseif desc:IsA("BasePart") or desc:IsA("MeshPart") or desc:IsA("UnionOperation") then
                                            if hide then
                                                desc.Transparency = 1
                                                desc.CastShadow = false
                                            else
                                                desc.Material = Enum.Material.SmoothPlastic
                                                desc.CastShadow = false
                                            end
                                        end
                                    end
                                end)
                            end)
                        end
                        AddConnection(breakablesFolder.ChildAdded:Connect(CleanBreakable))
                        for _, child in ipairs(breakablesFolder:GetChildren()) do
                            CleanBreakable(child)
                        end
                    end

                    -- 2C. Optimize & Hide Pets (Transparent + Remove Visual Effects)
                    local petsFolder = thingsFolder:FindFirstChild("Pets")
                    if petsFolder then
                        local function CleanPet(child)
                            task.defer(function()
                                pcall(function()
                                    local hide = getgenv().MapAutoConfig and getgenv().MapAutoConfig.HidePets
                                    for _, desc in ipairs(child:GetDescendants()) do
                                        if desc:IsA("ParticleEmitter") or desc:IsA("Sparkles") or desc:IsA("Beam") or desc:IsA("Trail") or desc:IsA("Highlight") or desc:IsA("PointLight") or desc:IsA("SpotLight") or desc:IsA("SurfaceLight") then
                                            pcall(function() desc.Enabled = false end)
                                        elseif desc:IsA("BillboardGui") then
                                            pcall(function() desc.Enabled = false end)
                                        elseif desc:IsA("Decal") or desc:IsA("Texture") then
                                            if hide then
                                                pcall(function() desc.Transparency = 1 end)
                                            end
                                        elseif desc:IsA("BasePart") or desc:IsA("MeshPart") or desc:IsA("UnionOperation") then
                                            if hide then
                                                desc.Transparency = 1
                                                desc.CastShadow = false
                                            else
                                                desc.Material = Enum.Material.SmoothPlastic
                                                desc.CastShadow = false
                                            end
                                        end
                                    end
                                end)
                            end)
                        end
                        AddConnection(petsFolder.ChildAdded:Connect(CleanPet))
                        for _, child in ipairs(petsFolder:GetChildren()) do
                            CleanPet(child)
                        end
                    end

                    -- 2D. Optimize & Hide Breakable Health Bar / Damage Numbers / HUD Progress
                    if getgenv().MapAutoConfig and getgenv().MapAutoConfig.HideBreakableHealth then
                        pcall(function()
                            -- 1. Disable Template Billboards in ReplicatedStorage so cloned HUDs are disabled from birth
                            local assetsFolder = ReplicatedStorage:FindFirstChild("Assets")
                            local billboardsFolder = assetsFolder and assetsFolder:FindFirstChild("Billboards")
                            if billboardsFolder then
                                for _, bName in ipairs({ "BreakableProgress", "Damage", "BreakableProgressOLD", "BreakableModifier" }) do
                                    local bTemplate = billboardsFolder:FindFirstChild(bName)
                                    if bTemplate and bTemplate:IsA("BillboardGui") then
                                        bTemplate.Enabled = false
                                    end
                                end
                            end

                            -- 2. Hook and Strip HUDAdornee & HUD Billboards from workspace.__DEBRIS
                            local debrisFolder = workspace:FindFirstChild("__DEBRIS")
                            if debrisFolder then
                                local function CleanDebrisHUD(inst)
                                    task.defer(function()
                                        pcall(function()
                                            if not inst then return end
                                            if inst:IsA("BillboardGui") and (inst.Name == "HUD" or inst.Name == "BreakableProgress" or inst.Name == "Damage" or inst.Name == "BreakableModifier") then
                                                inst.Enabled = false
                                            end
                                            for _, desc in ipairs(inst:GetDescendants()) do
                                                if desc:IsA("BillboardGui") and (desc.Name == "HUD" or desc.Name == "BreakableProgress" or desc.Name == "Damage" or desc.Name == "BreakableModifier") then
                                                    desc.Enabled = false
                                                end
                                            end
                                        end)
                                    end)
                                end
                                AddConnection(debrisFolder.ChildAdded:Connect(CleanDebrisHUD))
                                AddConnection(debrisFolder.DescendantAdded:Connect(CleanDebrisHUD))
                                for _, child in ipairs(debrisFolder:GetChildren()) do
                                    CleanDebrisHUD(child)
                                end
                            end
                        end)
                    end
                end

                -- 3. Universal Map & BasePart Visual Stripper (mode-aware)
                --   opti_mode = 1 (MẠNH NHẤT): xóa màu + hiệu ứng + XÓA cấu trúc trang trí
                --     (PARTS_LOD / PARTS, Statues, Fanart, Leaderboard, Signs...) nhưng GIỮ:
                --     GROUND, INTERACT, Machines, BREAK_ZONES / BREAKABLE_SPAWNS, Upgrades,
                --     ZoneQuest, VIP Gate, PERSISTENT → bot không bị hỏng.
                --   opti_mode = 2 (NHẸ): chỉ xóa màu + hiệu ứng thừa, GIỮ NGUYÊN cấu trúc map.
                -- Lưu ý: KHÔNG destroy đại trà trong zone đang stream nửa chừng
                -- (bài học CleanAllMapDecor cũ: destroy đại trà làm mất INTERACT/BREAK_ZONES
                -- khi zone mới stream vào → bot không farm được). Chỉ destroy con thuần decor.
                local FLAT_GRAY_COLOR = Color3.fromRGB(160, 160, 160)
                local currentOptiMode = tonumber(getgenv().MapAutoConfig and getgenv().MapAutoConfig.opti_mode) or 2
                local strongMode = (currentOptiMode == 1)

                -- Whitelist: các member trong INTERACT phải GIỮ để bot không hỏng
                local INTERACT_KEEP_PATTERNS = {
                    "ZONEQUEST", "VIP GATE", "MACHINES", "BREAKABLE_SPAWNS",
                    "BREAK_ZONES", "BREAK_ZONE", "UPGRADES", "TELEPORT",
                }
                local function ShouldKeepInteractChild(name)
                    local n = string.upper(tostring(name))
                    for _, pat in ipairs(INTERACT_KEEP_PATTERNS) do
                        if string.find(n, pat, 1, true) then return true end
                    end
                    return false
                end

                local function StripPartVisuals(desc)
                    if not desc then return end
                    pcall(function()
                        -- Preserve LocalPlayer character
                        local myChar = LocalPlayer and LocalPlayer.Character
                        if myChar and desc:IsDescendantOf(myChar) then return end

                        if desc:IsA("ParticleEmitter") or desc:IsA("Sparkles") or desc:IsA("Decal") or desc:IsA("Texture")
                            or desc:IsA("PointLight") or desc:IsA("SpotLight") or desc:IsA("SurfaceLight")
                            or desc:IsA("Beam") or desc:IsA("Trail") or desc:IsA("Smoke") or desc:IsA("Fire")
                            or desc:IsA("Highlight") or desc:IsA("SurfaceAppearance") then
                            desc:Destroy()
                        elseif desc:IsA("BasePart") or desc:IsA("MeshPart") or desc:IsA("UnionOperation") then
                            desc.Material = Enum.Material.SmoothPlastic
                            desc.Color = FLAT_GRAY_COLOR
                            desc.CastShadow = false
                            desc.Reflectance = 0
                            if desc:IsA("MeshPart") then
                                pcall(function() desc.TextureID = "" end)
                            end
                        elseif desc:IsA("SpecialMesh") then
                            desc.TextureId = ""
                        end
                    end)
                end

                -- Mode 1: xóa cấu trúc trang trí stream vào (không đụng GROUND/INTERACT/PERSISTENT)
                local function HandleMapStructure(inst, deferDestroy)
                    if not strongMode or not inst then return end
                    local parent = inst.Parent
                    if not parent then return end
                    local destroyIt = false
                    local pn = parent.Name
                    if pn == "PARTS_LOD" or pn == "PARTS" then
                        if string.upper(inst.Name) ~= "GROUND" then destroyIt = true end
                    elseif pn == "INTERACT" then
                        if not ShouldKeepInteractChild(inst.Name) then destroyIt = true end
                    end
                    if destroyIt then
                        if deferDestroy then
                            task.defer(function() pcall(function() inst:Destroy() end) end)
                        else
                            pcall(function() inst:Destroy() end)
                        end
                    end
                end

                -- Xóa sạch ALWAYS_RENDERING* (các khối mây, đá, cảnh nền nặng ngoài map)
                for _, child in ipairs(workspace:GetChildren()) do
                    if string.find(string.lower(child.Name), "always_render", 1, true) then
                        pcall(function() child:ClearAllChildren() end)
                    end
                end

                -- Ép Quality Level về Level 01 để nhẹ GPU tối đa
                pcall(function()
                    if settings and settings().Rendering then
                        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
                    end
                end)

                -- Tắt sóng nước Terrain
                pcall(function()
                    if workspace.Terrain then
                        workspace.Terrain.WaterWaveSize = 0
                        workspace.Terrain.WaterWaveSpeed = 0
                        workspace.Terrain.WaterReflectance = 0
                    end
                end)

                -- Hook LightingManager to block game from resetting Lighting effects on zone change
                pcall(function()
                    local LightingMgr = LoadModule(Client, "LightingManager")
                    if LightingMgr and LightingMgr.SetLighting then
                        local rawSetLighting = LightingMgr.SetLighting
                        LightingMgr.SetLighting = function() end -- No-op: prevent zone lighting re-apply
                        RegisterPatch(LightingMgr, "SetLighting", rawSetLighting)
                    end
                end)

                -- Strip Lighting effects from current Lighting service
                local Lighting = game:GetService("Lighting")
                Lighting.GlobalShadows = false
                for _, v in ipairs(Lighting:GetChildren()) do
                    pcall(function()
                        if v:IsA("Atmosphere") or v:IsA("Clouds") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect")
                            or v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("ColorCorrectionEffect") then
                            v:Destroy()
                        end
                    end)
                end
                AddConnection(Lighting.ChildAdded:Connect(function(v)
                    task.defer(function()
                        if v:IsA("Atmosphere") or v:IsA("Clouds") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect")
                            or v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("ColorCorrectionEffect") then
                            pcall(function() v:Destroy() end)
                        end
                    end)
                end))

                -- Sweep all current workspace assets (strip visuals + xóa cấu trúc decor nếu mode 1)
                for _, desc in ipairs(workspace:GetDescendants()) do
                    StripPartVisuals(desc)
                    HandleMapStructure(desc)
                end

                -- Real-time Streaming Hook (Optimized: Direct single-instance processing, NO O(N^2) recursion)
                AddConnection(workspace.DescendantAdded:Connect(function(desc)
                    -- Mode 1: xóa decor ngay khi stream vào (defer để game dựng xong model trước)
                    if desc:IsA("Model") or desc:IsA("BasePart") then
                        HandleMapStructure(desc, true)
                    end
                    if desc:IsA("BasePart") or desc:IsA("ParticleEmitter") or desc:IsA("Decal") or desc:IsA("Texture") or desc:IsA("PointLight") or desc:IsA("Highlight") or desc:IsA("SurfaceAppearance") or desc:IsA("Beam") or desc:IsA("Trail") then
                        StripPartVisuals(desc)
                    end
                end))

                -- 4. Complete Orb / Lootbag Visual Stripper & Hider (Hide Orbs)
                if getgenv().MapAutoConfig.HideOrbs then
                    local function HideOrbInstance(orb)
                        if not orb then return end
                        pcall(function()
                            if orb:IsA("BasePart") then
                                orb.Transparency = 1
                                orb.LocalTransparencyModifier = 1
                                orb.CastShadow = false
                            end
                            for _, desc in ipairs(orb:GetDescendants()) do
                                if desc:IsA("BasePart") then
                                    desc.Transparency = 1
                                    desc.LocalTransparencyModifier = 1
                                    desc.CastShadow = false
                                elseif desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Beam") or desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") or desc:IsA("PointLight") or desc:IsA("Highlight") then
                                    desc:Destroy()
                                end
                            end
                        end)
                    end

                    task.spawn(function()
                        local things = workspace:WaitForChild("__THINGS", 10)
                        local orbsFolder = things and (things:FindFirstChild("Orbs") or things:WaitForChild("Orbs", 10))
                        if orbsFolder then
                            for _, orb in ipairs(orbsFolder:GetChildren()) do
                                HideOrbInstance(orb)
                            end
                            AddConnection(orbsFolder.ChildAdded:Connect(function(orb)
                                task.defer(HideOrbInstance, orb)
                            end))
                        end
                    end)

                    pcall(function()
                        local orbFolder = Client:FindFirstChild("OrbCmds")
                        local OrbModule = (orbFolder and orbFolder:FindFirstChild("Orb") and require(orbFolder.Orb))
                        if OrbModule and OrbModule.CreatePart then
                            local rawCreatePart = OrbModule.CreatePart
                            OrbModule.CreatePart = function(...)
                                local p, emitters, b, d = rawCreatePart(...)
                                if p and p:IsA("BasePart") then
                                    p.Transparency = 1
                                    p.LocalTransparencyModifier = 1
                                end
                                if emitters then
                                    for _, emitter in ipairs(emitters) do
                                        pcall(function() emitter.Enabled = false end)
                                    end
                                end
                                return p, emitters, b, d
                            end
                            RegisterPatch(OrbModule, "CreatePart", rawCreatePart)
                        end
                    end)
                end

                -- 5. Complete CPU & RAM Turbo Optimizer (Damage Numbers, Hit FX, Audio, Other Players, Physics)
                pcall(function()
                    -- A. Mute Game Audio Decoding (Save CPU Audio Processing)
                    pcall(function()
                        local UserSettingsService = UserSettings()
                        if UserSettingsService and UserSettingsService:GetService("UserGameSettings") then
                            UserSettingsService:GetService("UserGameSettings").MasterVolume = 0
                        end
                    end)
                    for _, sound in ipairs(game:GetService("SoundService"):GetDescendants()) do
                        if sound:IsA("Sound") then
                            sound.Volume = 0
                        end
                    end

                    -- B. Optimize Other Players (Avatars, Layered Clothing, Particles, Pets)
                    local function OptimizePlayerCharacter(player)
                        if player == LocalPlayer or not player.Character then return end
                        pcall(function()
                            for _, desc in ipairs(player.Character:GetDescendants()) do
                                if desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Beam") or desc:IsA("Highlight") or desc:IsA("BillboardGui") then
                                    desc:Destroy()
                                elseif desc:IsA("BasePart") then
                                    desc.CastShadow = false
                                    desc.CanCollide = false
                                    desc.CanTouch = false
                                    desc.CanQuery = false
                                end
                            end
                        end)
                    end

                    for _, p in ipairs(Players:GetPlayers()) do
                        OptimizePlayerCharacter(p)
                        AddConnection(p.CharacterAdded:Connect(function()
                            task.wait(0.5)
                            OptimizePlayerCharacter(p)
                        end))
                    end
                    AddConnection(Players.PlayerAdded:Connect(function(p)
                        AddConnection(p.CharacterAdded:Connect(function()
                            task.wait(0.5)
                            OptimizePlayerCharacter(p)
                        end))
                    end))

                    -- C. Suppress Breakables Damage Numbers & Hit Particle Explosions
                    local things = workspace:FindFirstChild("__THINGS")
                    if things then
                        AddConnection(things.DescendantAdded:Connect(function(desc)
                            task.defer(function()
                                local dName = string.lower(desc.Name)
                                if desc:IsA("BillboardGui") and (dName:find("damage") or dName:find("hit") or dName:find("crit") or dName:find("number")) then
                                    pcall(function() desc:Destroy() end)
                                elseif desc:IsA("ParticleEmitter") and desc.Parent and desc.Parent:IsDescendantOf(things) and desc.Parent.Name ~= "Pets" then
                                    pcall(function() desc:Destroy() end)
                                end
                            end)
                        end))
                    end

                    -- D. Set Physics Engine Environmental Throttle
                    pcall(function()
                        if settings and settings().Physics then
                            settings().Physics.PhysicsEnvironmentalThrottle = Enum.EnviromentalPhysicsThrottle.DefaultAuto
                        end
                    end)
                end)
            end)
        end)
    end)
end

local function FormatCompactNumber(n)
    n = tonumber(n) or 0
    if n >= 1e15 then return string.format("%.2fQ", n / 1e15)
    elseif n >= 1e12 then return string.format("%.2fT", n / 1e12)
    elseif n >= 1e9 then return string.format("%.2fB", n / 1e9)
    elseif n >= 1e6 then return string.format("%.2fM", n / 1e6)
    elseif n >= 1e3 then return string.format("%.2fK", n / 1e3)
    else return tostring(math.floor(n)) end
end

local function FormatNumber(num)
    return FormatCompactNumber(num)
end

