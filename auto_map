-- Monkey-patch registry: mọi patch module game được ghi lại để Teardown restore
-- về hàm gốc, tránh để game bị "bẻ" nửa vời khi script stop hoặc chạy lại.
local patches = {}
local disabledConns = {}
local function RegisterPatch(module, key, original)
    if module and key ~= nil then
        table.insert(patches, { module = module, key = key, original = original })
    end
end
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local function Teardown()
    for i = #connections, 1, -1 do
        pcall(function() connections[i]:Disconnect() end)
        connections[i] = nil
    end
    -- Restore toàn bộ monkey-patch module game về hàm gốc
    for i = #patches, 1, -1 do
        local p = patches[i]
        if p and p.module then
            pcall(function() p.module[p.key] = p.original end)
        end
        patches[i] = nil
    end
    -- Bật lại các Idled connection đã bị disable (Anti-AFK)
    for i = #disabledConns, 1, -1 do
        local c = disabledConns[i]
        pcall(function() if c and c.Enable then c:Enable() end end)
        disabledConns[i] = nil
    end
    -- Khôi phục 3D rendering khi dừng script
    pcall(function()
        RunService:Set3dRenderingEnabled(true)
    end)
    -- Dọn MapAuto_SafeFloor còn sót lại trong workspace
    pcall(function()
        local sf = workspace:FindFirstChild("MapAuto_SafeFloor")
        if sf then sf:Destroy() end
    end)
    -- Khôi phục CanCollide cho character (NoClip không để lại hiệu ứng phụ)
    pcall(function()
        local char = LocalPlayer and LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "MapAuto_SafeFloor" then
                    part.CanCollide = true
                end
            end
        end
    end)
end

