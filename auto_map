-- ----------------------------------------------------------------------------
local SprinklerManager = {}
local lastSprinklerCheck = 0

function SprinklerManager.Step()
    if getgenv().MapAutoConfig.AutoSprinkler == false then return end
    if os.clock() - lastSprinklerCheck < 10 then return end
    lastSprinklerCheck = os.clock()

    pcall(function()
        local successSprinkler, SprinklerCmds = pcall(function() return LoadModule(Client, "SprinklerCmds") end)
        local successMap, MapCmds = pcall(function() return LoadModule(Client, "MapCmds") end)
        local successZone, ZoneCmds2 = pcall(function() return LoadModule(Client, "ZoneCmds") end)
        if not successSprinkler or not SprinklerCmds then return end

        -- 1. Server yêu cầu nhân vật phải đứng bên trong bãi đào (Dotted Box) mới cho phép đặt Sprinkler
        local isInDottedBox = false
        pcall(function()
            if successMap and MapCmds and MapCmds.IsInDottedBox then
                isInDottedBox = MapCmds.IsInDottedBox()
            end
        end)
        if not isInDottedBox then return end

        local currentZone = (successZone and ZoneCmds2 and ZoneCmds2.GetMaxOwnedZone()) or (successMap and MapCmds and MapCmds.GetCurrentZone())
        if not currentZone then return end

        -- 2. Find a Sprinkler in inventory (category Misc, id "Breakable Sprinkler" or containing "sprinkler")
        local sprinklerUID = nil
        local sprinklerItemId = nil
        pcall(function()
            local sd = Save.Get()
            if sd and sd.Inventory and sd.Inventory.Misc then
                for uid, itemData in pairs(sd.Inventory.Misc) do
                    if type(itemData) == "table" then
                        local id = tostring(itemData.id or itemData._id or "")
                        if id:lower():find("sprinkler") then
                            sprinklerUID = tostring(uid)
                            sprinklerItemId = id
                            break
                        end
                    end
                end
            end
        end)

        if not sprinklerUID or not sprinklerItemId then return end

        -- 3. Check if sprinkler is already active with > 60s remaining
        local hasActive = false
        pcall(function()
            if SprinklerCmds.PlayerHasActiveSprinkler then
                hasActive = SprinklerCmds.PlayerHasActiveSprinkler(sprinklerItemId)
            end
            if not hasActive and SprinklerCmds.GetActiveSprinkler then
                local activeSprinkler = SprinklerCmds.GetActiveSprinkler(currentZone)
                if activeSprinkler and activeSprinkler.EndTime then
                    local remaining = activeSprinkler.EndTime - workspace:GetServerTimeNow()
                    if remaining > 60 then
                        hasActive = true
                    end
                end
            end
        end)

        if hasActive then return end

        -- 4. Invoke Consume: (sprinklerName, itemUID, amount) theo decompiled Sprinkler.lua
        print(string.format("[MapAuto::Sprinkler] Deploying '%s' at zone '%s'...", sprinklerItemId, tostring(currentZone)))
        local ok, res = pcall(function()
            if SprinklerCmds.Consume then
                return SprinklerCmds.Consume(sprinklerItemId, sprinklerUID, 1)
            end
            return Network.Invoke("Sprinklers: Consume", sprinklerItemId, sprinklerUID, 1)
        end)

        if ok and res ~= false then
            print(string.format("[MapAuto::Sprinkler] Sprinkler deployed successfully at '%s'.", tostring(currentZone)))
            lastSprinklerCheck = os.clock() + 20 -- Hoãn check 20s
        else
            lastSprinklerCheck = os.clock() + 15 -- Tránh spam nếu bị từ chối
        end
    end)
end

