-- MODULE 3: TargetFinder (Quét & Định vị Quái vật)
-- ==========================================================================
local TargetFinder = {}

function TargetFinder.isValidMonster(monsterModel)
    if not monsterModel or not monsterModel:IsA("Model") or not monsterModel.Parent then
        return false
    end
    local humanoid = monsterModel:FindFirstChildOfClass("Humanoid")
    local rootPart = monsterModel:FindFirstChild("HumanoidRootPart") or monsterModel.PrimaryPart
    return humanoid and humanoid.Health > 0 and rootPart ~= nil
end

function TargetFinder.getNearestMonster(filterMonsterId, maxDistance)
    maxDistance = maxDistance or 450
    local character = LocalPlayer.Character
    if not character then return nil, maxDistance end
    local playerRoot = character:FindFirstChild("HumanoidRootPart")
    if not playerRoot then return nil, maxDistance end
    local monstersFolder = Workspace:FindFirstChild("Monsters")
    if not monstersFolder then return nil, maxDistance end

    local spawnCenter = filterMonsterId and MonsterSpawnCenters[filterMonsterId] or nil
    
    local nearestMonster, shortestDistance = nil, maxDistance
    for _, monster in ipairs(monstersFolder:GetChildren()) do
        if TargetFinder.isValidMonster(monster) then
            local matchesFilter = true
            if filterMonsterId then
                local mobIdAttr = string.lower(tostring(monster:GetAttribute("MonsterId") or monster.Name))
                local targetId  = string.lower(tostring(filterMonsterId))
                -- Khớp thông minh tên quái thực tế trong Workspace (Ví dụ: "Poison Spider" -> spider, "Red Mummy" -> redmummy)
                local isMatch = true
                if targetId == "golem" and string.find(mobIdAttr, "boss") then
                    isMatch = false
                elseif targetId == "bear" and string.find(mobIdAttr, "ice") then
                    isMatch = false
                elseif targetId == "zombie" and string.find(mobIdAttr, "snow") then
                    isMatch = false
                elseif targetId == "mummy" and string.find(mobIdAttr, "red") then
                    isMatch = false
                elseif targetId == "icebear" then
                    isMatch = (string.find(mobIdAttr, "ice") and string.find(mobIdAttr, "bear")) ~= nil
                elseif targetId == "snowzombie" then
                    isMatch = (string.find(mobIdAttr, "snow") and string.find(mobIdAttr, "zombie")) ~= nil
                elseif targetId == "redmummy" then
                    isMatch = (string.find(mobIdAttr, "red") and string.find(mobIdAttr, "mummy")) ~= nil
                elseif targetId == "iceslime" then
                    isMatch = (string.find(mobIdAttr, "ice") and string.find(mobIdAttr, "slime")) ~= nil
                elseif targetId == "winterclown" then
                    isMatch = (string.find(mobIdAttr, "winter") or string.find(mobIdAttr, "clown")) ~= nil
                elseif targetId == "snowman" then
                    isMatch = string.find(mobIdAttr, "snowman") ~= nil
                elseif targetId == "posionscorpion" then
                    isMatch = string.find(mobIdAttr, "scorpion") ~= nil
                else
                    isMatch = string.find(mobIdAttr, targetId) ~= nil
                end

                matchesFilter = isMatch
            end
            if matchesFilter then
                local monsterRoot = monster:FindFirstChild("HumanoidRootPart") or monster.PrimaryPart
                if monsterRoot then
                    -- BÁN KÍNH BÃI FARM (Spawn Center Radius check):
                    -- Quái phải nằm trong bán kính 350 studs của bãi farm spawnCenter (tránh quái đi lạc hoặc quái ở vùng xa khác)
                    local isWithinSpawnZone = true
                    if spawnCenter then
                        local spawnDist = (Vector3.new(monsterRoot.Position.X, 0, monsterRoot.Position.Z) - Vector3.new(spawnCenter.X, 0, spawnCenter.Z)).Magnitude
                        if spawnDist > 350 then
                            isWithinSpawnZone = false
                        end
                    end

                    if isWithinSpawnZone then
                        local dist = (monsterRoot.Position - playerRoot.Position).Magnitude
                        if dist < shortestDistance then
                            shortestDistance = dist
                            nearestMonster = monster
                        end
                    end
                end
            end
        end
    end
    return nearestMonster, shortestDistance
end

