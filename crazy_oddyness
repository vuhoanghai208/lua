-- MODULE 4: Combat (Xoay mặt, Tấn công & Xả Skill)
-- ==========================================================================
local Combat = {
    UndergroundMode = false,     -- Tắt chế độ Chui Đất (trở lại farm mặt đất chuẩn)
    FastAttack      = true,      -- Giữ Fast Attack rate limit 0.12s cực nhanh
    AutoSkill       = true,      -- Tự động xả Skill (1: Slash, 2: Fireball, 3, 4...) liên tục khi farm
}
local isAttacking = false
local attackLoopConn = nil
local lastBasicAttackTime = 0
local BASIC_ATTACK_COOLDOWN = 0.08  -- Fast Attack: 0.08s (Đánh nhanh siêu tốc)

local SKILL_COOLDOWN = 0.15
local lastSkillTime = { 0, 0, 0, 0 }

function Combat.faceTarget(targetMonster)
    -- CHỐNG XUNG ĐỘT CAMERA: Khi nhân vật đang bay/di chuyển (isMoving), không can thiệp CFrame
    if isMoving or (Movement and Movement.isMoving) then return end
    if not TargetFinder.isValidMonster(targetMonster) then return end
    local character = LocalPlayer.Character
    if not character then return end
    local rootPart    = character:FindFirstChild("HumanoidRootPart")
    local monsterRoot = targetMonster:FindFirstChild("HumanoidRootPart") or targetMonster.PrimaryPart
    if not rootPart or not monsterRoot then return end

    -- CHỈ xoay hướng mượt (Lerp), GIỮ NGUYÊN vị trí
    local pos = rootPart.Position
    local lookPos = Vector3.new(monsterRoot.Position.X, pos.Y, monsterRoot.Position.Z)
    local targetCF = CFrame.lookAt(pos, lookPos)
    rootPart.CFrame = rootPart.CFrame:Lerp(targetCF, 0.35)
end


function Combat.swingBasicAttack()
    local now = os.clock()
    local cd  = Combat.FastAttack and 0.08 or 0.35
    if now - lastBasicAttackTime >= cd then
        lastBasicAttackTime = now
        NetBridge.fire("BASIC_ATTACK")
    end
end

local globalSkillCD = 0
-- Ước lượng thời gian hồi chiêu của các Slot để tránh spam request liên tục khi server đang cooldown
local slotCooldowns = { 4.0, 8.0, 12.0, 20.0 }

function Combat.castSkill(slotId)
    if not Combat.AutoSkill then return false end
    local slot = tonumber(slotId) or 1
    local now = os.clock()
    
    -- Global Cooldown 0.10s (Combo liên hoàn bão skill)
    if now - globalSkillCD < 0.10 then return false end
    
    local cd = slotCooldowns[slot] or 5.0
    if now - (lastSkillTime[slot] or 0) >= cd then
        lastSkillTime[slot] = now
        globalSkillCD = now
        NetBridge.fire("CAST_SKILL", slot)
        return true
    end
    return false
end

function Combat.stopAutoAttack()
    isAttacking = false
    if attackLoopConn then
        attackLoopConn:Disconnect()
        attackLoopConn = nil
    end
end

function Combat.startAutoAttack(targetMonster)
    Combat.stopAutoAttack()
    if not TargetFinder.isValidMonster(targetMonster) then return end
    
    isAttacking = true
    attackLoopConn = RunService.Heartbeat:Connect(function()
        if not isAttacking or not TargetFinder.isValidMonster(targetMonster) then
            Combat.stopAutoAttack()
            return
        end
        Combat.faceTarget(targetMonster)
        Combat.swingBasicAttack()
        for slot = 1, 4 do
            if Combat.castSkill(slot) then
                break -- Xả 1 skill thành công thì ngừng quét để chờ Global CD
            end
        end
    end)
end

local QuestManager = {}

-- getMaxLevelGap: Số cấp tối đa được phép nhận Quest vượt trước so với Level hiện tại
-- Level < 10  : gap = 0   → Chỉ nhận quest đúng level (còn yếu, tránh quest khó)
-- Level 10-29 : gap = 999 (khống chế Quest Level <= 30) → Nhận vượt cấp tối đa tới Crab (30)
-- Level 30-39 : gap = 999 (khống chế Quest Level <= 43) → Nhận vượt cấp tối đa tới Zombie (42)
-- Level >= 40 : gap = 3   → Từ Level 40 trở đi chỉ nhận trước tối đa 3 cấp
function QuestManager.getMaxLevelGap(playerLevel, questMinLvl)
    if not playerLevel then return 0 end
    if playerLevel >= 40 then
        return 3   -- Level >= 40: chỉ nhận trước tối đa 3 cấp
    elseif playerLevel >= 30 then
        if questMinLvl and questMinLvl > 43 then
            return 0 -- Level 30-39: từ chối Quest > 43 (Spider 48/Golem 55)
        end
        return 999   -- Level 30-39: nhận vượt cấp tối đa mốc 43 (Zombie)
    elseif playerLevel >= 10 then
        if questMinLvl and questMinLvl > 30 then
            return 0 -- Level 10-29: từ chối Quest > 30 (Wolf 31/Bear 36/Zombie 42)
        end
        return 999   -- Level 10-29: nhận vượt cấp tối đa mốc 30 (Crab)
    end
    return 0       -- Level < 10: chỉ nhận quest đúng level
end

