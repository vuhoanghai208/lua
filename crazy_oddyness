local TargetFinder = {}

function TargetFinder.isValidMonster(monsterModel, filterMonsterId)
    if not monsterModel or not monsterModel:IsA("Model") or not monsterModel.Parent then
        return false
    end
    local humanoid = monsterModel:FindFirstChildOfClass("Humanoid")
    local rootPart = monsterModel:FindFirstChild("HumanoidRootPart") or monsterModel.PrimaryPart
    if not humanoid or humanoid.Health <= 0 or not rootPart then
        return false
    end

    -- BỎ QUA QUÁI BỊ BUG RỚT XUỐNG LÒNG ĐẤT / VOID (Y < -25)
    if rootPart.Position.Y < -25 then
        return false
    end

    -- BẢO VỆ NHÂN VẬT YẾU: Bỏ qua toàn bộ World Boss (Bone Dragon, Golem Boss, World Dragon)
    -- nếu không trong chế độ farm Boss chuyên biệt hoặc Level < 85
    local mobIdAttr = string.lower(tostring(monsterModel:GetAttribute("MonsterId") or monsterModel.Name))
    local isWorldBoss = string.find(mobIdAttr, "boss") ~= nil 
                     or string.find(mobIdAttr, "dragon") ~= nil
                     or humanoid.MaxHealth >= 50000

    if isWorldBoss then
        local playerLevel = (NetBridge.PlayerData and NetBridge.PlayerData.level) or 1
        if playerLevel < 85 or (filterMonsterId and filterMonsterId ~= "boss" and filterMonsterId ~= "dragon") then
            return false
        end
    end

    if filterMonsterId then
        local spawnCenter = MonsterSpawnCenters[filterMonsterId]
        if spawnCenter and (rootPart.Position.Y < spawnCenter.Y - 25 or rootPart.Position.Y > spawnCenter.Y + 70) then
            return false
        end
    end

    return true
end

-- Cache cho monstersFolder:GetChildren() — rebuild mỗi 0.5s thay vì mỗi 0.15s
local _cachedMonsters = {}
local _lastMonsterCacheTime = 0
local MONSTER_CACHE_TTL = 0.5  -- giây

local function getCachedMonsters(monstersFolder)
    local now = os.clock()
    if now - _lastMonsterCacheTime >= MONSTER_CACHE_TTL then
        _lastMonsterCacheTime = now
        _cachedMonsters = monstersFolder:GetChildren()
    end
    return _cachedMonsters
end

function TargetFinder.getNearestMonster(filterMonsterId, maxDistance)
    maxDistance = maxDistance or 450
    local character = LocalPlayer.Character
    if not character then return nil, maxDistance end
    local playerRoot = character:FindFirstChild("HumanoidRootPart")
    if not playerRoot then return nil, maxDistance end
    local monstersFolder = Workspace:FindFirstChild("Monsters")
    if not monstersFolder then return nil, maxDistance end

    local spawnCenter = filterMonsterId and MonsterSpawnCenters[filterMonsterId] or nil
    -- Hoist string.lower ra ngoài loop: tránh tính lại mỗi monster
    local targetIdLower = filterMonsterId and string.lower(tostring(filterMonsterId)) or nil
    
    -- Bước 1: Thu thập tất cả quái phù hợp — dùng cache thay vì GetChildren() mỗi lần
    local validCandidates = {}
    for _, monster in ipairs(getCachedMonsters(monstersFolder)) do
        if TargetFinder.isValidMonster(monster, filterMonsterId) then
            local matchesFilter = true
            if filterMonsterId then
                local mobIdAttr = string.lower(tostring(monster:GetAttribute("MonsterId") or monster.Name))
                local targetId  = targetIdLower  -- đã hoist ra ngoài loop
                local isMatch   = true

                if targetId == "golem" and string.find(mobIdAttr, "boss") then
                    isMatch = false
                elseif targetId == "bear" and string.find(mobIdAttr, "ice") then
                    isMatch = false
                elseif targetId == "zombie" and string.find(mobIdAttr, "snow") then
                    isMatch = false
                elseif targetId == "mummy" and string.find(mobIdAttr, "red") then
                    isMatch = false
                elseif targetId == "icebear" then
                    isMatch = (string.find(mobIdAttr, "ice") and string.find(mobIdAttr, "bear")) ~= nil
                elseif targetId == "snowzombie" then
                    isMatch = (string.find(mobIdAttr, "snow") and string.find(mobIdAttr, "zombie")) ~= nil
                elseif targetId == "redmummy" then
                    isMatch = (string.find(mobIdAttr, "red") and string.find(mobIdAttr, "mummy")) ~= nil
                elseif targetId == "iceslime" then
                    isMatch = (string.find(mobIdAttr, "ice") and string.find(mobIdAttr, "slime")) ~= nil
                elseif targetId == "winterclown" then
                    isMatch = (string.find(mobIdAttr, "winter") or string.find(mobIdAttr, "clown")) ~= nil
                elseif targetId == "snowman" then
                    isMatch = string.find(mobIdAttr, "snowman") ~= nil
                elseif targetId == "posionscorpion" then
                    isMatch = string.find(mobIdAttr, "scorpion") ~= nil
                else
                    isMatch = string.find(mobIdAttr, targetId) ~= nil
                end

                matchesFilter = isMatch
            end

            if matchesFilter then
                local monsterRoot = monster:FindFirstChild("HumanoidRootPart") or monster.PrimaryPart
                if monsterRoot then
                    local isWithinSpawnZone = true
                    if spawnCenter then
                        local spawnDist = (Vector3.new(monsterRoot.Position.X, 0, monsterRoot.Position.Z) - Vector3.new(spawnCenter.X, 0, spawnCenter.Z)).Magnitude
                        -- Giới hạn 150 studs từ tâm bãi để bot không bị "dắt" đi ra ngoài map hoặc sang bãi khác
                        if spawnDist > 150 then
                            isWithinSpawnZone = false
                        end
                    end

                    if isWithinSpawnZone then
                        local dist = (monsterRoot.Position - playerRoot.Position).Magnitude
                        if dist <= maxDistance then
                            table.insert(validCandidates, {
                                monster = monster,
                                root    = monsterRoot,
                                dist    = dist
                            })
                        end
                    end
                end
            end
        end
    end

    if #validCandidates == 0 then
        return nil, maxDistance
    end

    -- Bước 2: Đánh giá điểm mật độ cụm (Cluster Density Scoring)
    -- Đếm số quái lân cận trong bán kính 45 studs xung quanh từng con quái
    local bestCandidate = nil
    local bestScore     = math.huge
    local bestRealDist  = maxDistance

    for _, candidate in ipairs(validCandidates) do
        local densityCount = 0
        for _, other in ipairs(validCandidates) do
            local gap = (candidate.root.Position - other.root.Position).Magnitude
            if gap <= 45 then
                densityCount = densityCount + 1
            end
        end

        -- Mỗi quái lân cận trong cụm làm giảm 40 studs khoảng cách ảo (ưu tiên cụm đông)
        local score = candidate.dist - (densityCount * 40)

        if score < bestScore then
            bestScore     = score
            bestCandidate = candidate.monster
            bestRealDist  = candidate.dist
        end
    end

    return bestCandidate, bestRealDist
end

-- getClusterTarget: ưu tiên cụm quái ĐÔNG (không đu quái lẻ).
-- OPTIMIZED: cache 0.35s (tránh quét lại mỗi 0.15s) + khoảng cách bình phương
-- (không sqrt) + spatial grid hash đếm mật độ O(n) thay vì O(n²) và đổ quái.
-- Trả về: mobGanCum, tamCum, dist, soLuongCum
local CLUSTER_RADIUS = 55
local CLUSTER_CACHE_TTL = 0.35
local clusterCache = {}

function TargetFinder.getClusterTarget(filterMonsterId, maxDistance)
    maxDistance = maxDistance or 450
    local cacheKey = tostring(filterMonsterId or "")
    local now = os.clock()
    local hit = clusterCache[cacheKey]
    if hit and now - hit.t < CLUSTER_CACHE_TTL then
        return hit.mob, hit.center, hit.dist, hit.cnt
    end

    local character = LocalPlayer.Character
    if not character then return nil, nil, maxDistance, 0 end
    local playerRoot = character:FindFirstChild("HumanoidRootPart")
    if not playerRoot then return nil, nil, maxDistance, 0 end
    local monstersFolder = Workspace:FindFirstChild("Monsters")
    if not monstersFolder then return nil, nil, maxDistance, 0 end

    local spawnCenter = filterMonsterId and MonsterSpawnCenters[filterMonsterId] or nil
    local targetIdLower = filterMonsterId and string.lower(tostring(filterMonsterId)) or nil
    local playerPos = playerRoot.Position
    local maxDSq = maxDistance * maxDistance
    local zoneDSq = 150 * 150

    -- Bước 1: thu thập ứng viên (dùng dsq bình phương, tránh sqrt mỗi con)
    local candidates = {}
    for _, monster in ipairs(getCachedMonsters(monstersFolder)) do
        if TargetFinder.isValidMonster(monster, filterMonsterId) then
            local matchesFilter = true
            if filterMonsterId then
                local mobIdAttr = string.lower(tostring(monster:GetAttribute("MonsterId") or monster.Name))
                local targetId = targetIdLower
                local isMatch  = true
                if targetId == "golem" and string.find(mobIdAttr, "boss") then
                    isMatch = false
                elseif targetId == "bear" and string.find(mobIdAttr, "ice") then
                    isMatch = false
                elseif targetId == "zombie" and string.find(mobIdAttr, "snow") then
                    isMatch = false
                elseif targetId == "mummy" and string.find(mobIdAttr, "red") then
                    isMatch = false
                elseif targetId == "icebear" then
                    isMatch = (string.find(mobIdAttr, "ice") and string.find(mobIdAttr, "bear")) ~= nil
                elseif targetId == "snowzombie" then
                    isMatch = (string.find(mobIdAttr, "snow") and string.find(mobIdAttr, "zombie")) ~= nil
                elseif targetId == "redmummy" then
                    isMatch = (string.find(mobIdAttr, "red") and string.find(mobIdAttr, "mummy")) ~= nil
                elseif targetId == "iceslime" then
                    isMatch = (string.find(mobIdAttr, "ice") and string.find(mobIdAttr, "slime")) ~= nil
                elseif targetId == "winterclown" then
                    isMatch = (string.find(mobIdAttr, "winter") or string.find(mobIdAttr, "clown")) ~= nil
                elseif targetId == "snowman" then
                    isMatch = string.find(mobIdAttr, "snowman") ~= nil
                elseif targetId == "posionscorpion" then
                    isMatch = string.find(mobIdAttr, "scorpion") ~= nil
                else
                    isMatch = string.find(mobIdAttr, targetId) ~= nil
                end
                matchesFilter = isMatch
            end

            if matchesFilter then
                local root = monster:FindFirstChild("HumanoidRootPart") or monster.PrimaryPart
                if root then
                    local p = root.Position
                    local dx = p.X - playerPos.X
                    local dz = p.Z - playerPos.Z
                    local dy = p.Y - playerPos.Y
                    local dSq = dx * dx + dz * dz + dy * dy
                    if dSq <= maxDSq then
                        local isWithinSpawnZone = true
                        if spawnCenter then
                            local sDX = p.X - spawnCenter.X
                            local sDZ = p.Z - spawnCenter.Z
                            if sDX*sDX + sDZ*sDZ > zoneDSq then isWithinSpawnZone = false end
                        end
                        if isWithinSpawnZone then
                            table.insert(candidates, {
                                monster = monster, root = root,
                                px = p.X, pz = p.Z, dSq = dSq
                            })
                        end
                    end
                end
            end
        end
    end

    if #candidates == 0 then
        clusterCache[cacheKey] = { t = now, mob = nil, center = nil, dist = maxDistance, cnt = 0 }
        return nil, nil, maxDistance, 0
    end

    -- Bước 2: Spatial grid (cell = CLUSTER_RADIUS) để đếm mật độ cụm O(n) thay vì O(n²)
    local cell  = CLUSTER_RADIUS
    local R2    = CLUSTER_RADIUS * CLUSTER_RADIUS
    local grid  = {}
    for _, cand in ipairs(candidates) do
        local k = math.floor(cand.px / cell) .. "," .. math.floor(cand.pz / cell)
        local slot = grid[k]
        if not slot then slot = {}; grid[k] = slot end
        slot[#slot + 1] = cand
    end

    local bestCnt, bestCenter, bestScore = 0, nil, math.huge
    for _, anchor in ipairs(candidates) do
        local ax, az = anchor.px, anchor.pz
        local bx = math.floor(ax / cell)
        local bz = math.floor(az / cell)
        local sx, sz, cnt = 0, 0, 0
        for gx = bx - 1, bx + 1 do
            for gz = bz - 1, bz + 1 do
                local slot = grid[gx .. "," .. gz]
                if slot then
                    for _, other in ipairs(slot) do
                        local dx = other.px - ax
                        local dz = other.pz - az
                        if dx*dx + dz*dz <= R2 then
                            sx = sx + other.px
                            sz = sz + other.pz
                            cnt = cnt + 1
                        end
                    end
                end
            end
        end
        if cnt > 0 then
            local c = Vector3.new(sx / cnt, playerPos.Y, sz / cnt)
            -- Ưu tiên vượt trội cho cụm >= 3 quái để tận dụng tối đa Aura Kiếm AOE
            local cntBonus = (cnt >= 3 and 600 or 0) + (cnt * 180)
            local score = (c - playerPos).Magnitude - cntBonus
            if score < bestScore then
                bestScore = score
                bestCnt   = cnt
                bestCenter = c
            end
        end
    end

    -- Bước 3: Chọn con quái gần PLAYER nhất nằm trong cụm đã chọn để tấn công
    local nearestMob, nearestD = nil, math.huge
    local halfW = CLUSTER_RADIUS + 10
    local halfW2 = halfW * halfW
    for _, p in ipairs(candidates) do
        local dx = p.px - bestCenter.X
        local dz = p.pz - bestCenter.Z
        if dx*dx + dz*dz <= halfW2 then
            if p.dSq < nearestD then
                nearestD = p.dSq
                nearestMob = p.monster
            end
        end
    end
    if not nearestMob then
        nearestMob = candidates[1].monster
        nearestD   = candidates[1].dSq
    end

    local result = {
        t = now, mob = nearestMob, center = bestCenter or Vector3.new(candidates[1].px, playerPos.Y, candidates[1].pz),
        dist = math.sqrt(nearestD), cnt = bestCnt or 1
    }
    clusterCache[cacheKey] = result
    return result.mob, result.center, result.dist, result.cnt
end

