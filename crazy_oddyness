-- MODULE 1b: AutoPotion (Tự dùng thuốc khi HP < 20%)
-- Source: PotionController.lua (decompiled)
--   • Dùng potion: Net.event("e039a15"):FireServer()
--   • Cooldown server confirm: Net.event("e459d82") → {cooldown, startedAt}
--   • Cooldown: 13s | PotionSealed attribute = không được dùng
-- ==========================================================================
local AutoPotion = {}
do
    local Net = require(ReplicatedStorage.Shared.Net)
    local POTION_REMOTE    = "e039a15"    -- fire → use potion
    local COOLDOWN_REMOTE  = "e459d82"    -- onClientEvent → {cooldown, startedAt}
    local HP_THRESHOLD     = 0.20         -- dùng khi HP < 20%
    local COOLDOWN_SECS    = 13           -- server-side cooldown
    local CLIENT_RATE      = 0.5          -- không fire quá 1 lần / 0.5s locally

    local cooldownUntil    = 0            -- os.clock() thời điểm hết cooldown
    local lastFire         = 0

    -- Lắng nghe server confirm cooldown để đồng bộ chính xác hơn
    Net.event(COOLDOWN_REMOTE).OnClientEvent:Connect(function(payload)
        if type(payload) == "table" then
            local cd        = tonumber(payload.cooldown)  or COOLDOWN_SECS
            local startedAt = tonumber(payload.startedAt) or os.clock()
            -- startedAt là server time; dùng COOLDOWN_SECS làm fallback local
            cooldownUntil = os.clock() + math.max(0, cd - (workspace:GetServerTimeNow() - startedAt))
            debugLog("POTION", "Server confirm cooldown %.1fs", cd)
        end
    end)

    function AutoPotion.tryUse()
        -- Guard: cooldown chưa xong
        if os.clock() < cooldownUntil then return end
        -- Guard: rate limit local
        if os.clock() - lastFire < CLIENT_RATE then return end

        local character = LocalPlayer.Character
        if not character then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return end

        -- Guard: PotionSealed (dungeon debuff)
        if LocalPlayer:GetAttribute("PotionSealed") == true then return end

        local hpRatio = humanoid.Health / humanoid.MaxHealth
        if hpRatio >= HP_THRESHOLD then return end

        -- Fire remote → giống game tự fire khi nhấn R
        lastFire      = os.clock()
        cooldownUntil = os.clock() + COOLDOWN_SECS  -- optimistic lock
        Net.event(POTION_REMOTE):FireServer()
        debugLog("POTION", "Dùng potion! HP=%.0f%% (%.0f/%.0f)",
            hpRatio * 100, humanoid.Health, humanoid.MaxHealth)
    end

    function AutoPotion.startLoop()
        task.spawn(function()
            while true do
                task.wait(0.5)   -- check 2 lần/giây
                pcall(AutoPotion.tryUse)
            end
        end)
        debugLog("POTION", "AutoPotion loop started (threshold=20%%, cooldown=%ds)", COOLDOWN_SECS)
    end
end

