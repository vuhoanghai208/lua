-- MODULE 2: Movement (Di chuyển Walk Tween mượt bám sát mặt đất)
-- ==========================================================================
local GroundProbe = require(ReplicatedStorage.Shared.Util.GroundProbe)

local Movement = {}
local activeTween     = nil   -- TweenInstance hiện tại
local activeMoveConn  = nil   -- Heartbeat connection kiểm tra distance
local isMoving        = false
local currentTargetPos = nil

Movement.HOVER_HEIGHT = 1.8 -- Lướt bám sát mặt đất 1.8 studs (An toàn tuyệt đối với Server Anti-Cheat MovementGuard HOVER_MIN_HEIGHT=10)

function Movement.getGroundPos(pos)
    -- Probe từ 25 studs phía trên xuống 80 studs, trả về mặt đất + offset 1.8 (Lướt sát mặt đất)
    local groundPos, _ = GroundProbe.groundBelow(pos + Vector3.new(0, 25, 0), 80)
    
    -- TRÁNH LEO CÂY / CÀNH CÂY (Tree/Structure height bypass):
    -- Nếu groundPos trả về có độ cao Y quá cao so với pos (lệch > 12 studs) hoặc cao hơn hẳn mặt đất thông thường (Y > 35):
    if groundPos and (groundPos.Y - pos.Y > 12 or (pos.Y <= 30 and groundPos.Y > 35)) then
        -- Thử probe từ độ cao thấp hơn (pos + 3 studs) để lọt qua cành cây
        local lowGround, _ = GroundProbe.groundBelow(pos + Vector3.new(0, 3, 0), 40)
        if lowGround and lowGround.Y <= 35 then
            groundPos = lowGround
        else
            groundPos = Vector3.new(pos.X, math.min(pos.Y, 25), pos.Z)
        end
    end

    return groundPos and (groundPos + Vector3.new(0, Movement.HOVER_HEIGHT, 0)) or (pos + Vector3.new(0, Movement.HOVER_HEIGHT, 0))
end

-- Khóa trục Y bằng BodyVelocity trong Head (học từ AryaMain.lua L764-769)
-- MaxForce Y=math.huge → physics không kéo nhân vật chìm xuống đất khi đang tween
local function ensureYLock(character)
    local head = character:FindFirstChild("Head")
    if head and not head:FindFirstChild("_ylock") then
        local bv = Instance.new("BodyVelocity")
        bv.Name     = "_ylock"
        bv.MaxForce = Vector3.new(0, math.huge, 0)
        bv.Velocity = Vector3.zero
        bv.Parent   = head
    end
end

local function removeYLock(character)
    local head = character and character:FindFirstChild("Head")
    if head then
        local bv = head:FindFirstChild("_ylock")
        if bv then bv:Destroy() end
    end
end

-- Disable CanCollide toàn bộ character để không bị kẹt tường/fence (AryaMain L762)
local function setCharacterCanCollide(character, value)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = value
        end
    end
end

function Movement.stop()
    isMoving = false
    currentTargetPos = nil

    if activeTween then
        pcall(function() activeTween:Cancel() end)
        activeTween = nil
    end
    if activeMoveConn then
        activeMoveConn:Disconnect()
        activeMoveConn = nil
    end

    local character = LocalPlayer.Character
    if character then
        -- Chỉ khôi phục collision khi bot đã tắt; khi bot đang chạy giữ CanCollide=false để không kẹt cây/tường
        if not (KaitunBot and KaitunBot.Enabled) then
            setCharacterCanCollide(character, true)
            removeYLock(character)
        end
    end

end


--- walkTween dùng TweenService:Create trên rootPart.CFrame (học từ AryaMain.lua L788)
-- Ưu điểm so với Heartbeat manual step:
--   • TweenService nội suy CFrame mượt, không giật
--   • CanCollide=false → không kẹt fence/tường
--   • BodyVelocity Y-lock → không chui đất khi tween
--   • Server anti-teleport: mỗi frame chỉ di chuyển distance/duration studs
--     (ví dụ 400 studs / (330 s/s) ≈ 1.2s → ~0.6 studs/frame ở 60fps)
function Movement.walkTween(targetPos, speed, stopDistance, onComplete)
    speed        = speed or 35
    stopDistance = stopDistance or 4.0

    -- Đang đi đến cùng điểm → giữ nguyên, tránh reset giật
    if isMoving and currentTargetPos and (targetPos - currentTargetPos).Magnitude < 5 then
        return
    end

    Movement.stop()
    currentTargetPos = targetPos

    local character = LocalPlayer.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not rootPart or not humanoid or humanoid.Health <= 0 then return end

    -- Tính flatDist để check ngay nếu đã đến đích
    local flatDiff = Vector3.new(targetPos.X - rootPart.Position.X, 0, targetPos.Z - rootPart.Position.Z)
    if flatDiff.Magnitude <= stopDistance then
        if onComplete then onComplete() end
        return
    end

    -- Bước 1: Pre-set Y về ground của ĐIỂM ĐÍCh (AryaMain L787)
    -- Tránh nhân vật phải "leo" theo trục Y trong lúc tween → không chui đất
    local destGroundPos = Movement.getGroundPos(targetPos)
    local curCF = rootPart.CFrame
    rootPart.CFrame = CFrame.new(curCF.X, destGroundPos.Y, curCF.Z)

    -- Bước 2: Disable CanCollide để không kẹt tường (AryaMain L762)
    setCharacterCanCollide(character, false)

    -- Bước 3: Y-lock BodyVelocity (AryaMain L764-769) — giữ nhân vật không chìm
    ensureYLock(character)

    -- Bước 4: Tween mượt đến đích bằng TweenService (AryaMain L788)
    local dist     = flatDiff.Magnitude
    local duration = dist / speed    -- giây
    local destCF   = CFrame.new(Vector3.new(destGroundPos.X, destGroundPos.Y, destGroundPos.Z))
                     * (rootPart.CFrame - rootPart.CFrame.p)  -- giữ rotation hiện tại

    isMoving = true
    activeTween = TweenService:Create(rootPart,
        TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        {CFrame = destCF}
    )
    activeTween:Play()

    -- Bước 5: Heartbeat monitor distance + Dynamic Terrain Hovering (bảo vệ không bao giờ chui xuống nước khi tween)
    activeMoveConn = RunService.Heartbeat:Connect(function()
        if not isMoving or not character.Parent or humanoid.Health <= 0 then
            Movement.stop()
            return
        end

        local currentPos = rootPart.Position

        -- Dynamic Hover Probe: Dò địa hình/mặt nước bên dưới từng frame, luôn nâng nhân vật lơ lửng +8 studs
        local dynamicGround = Movement.getGroundPos(currentPos)
        if dynamicGround and dynamicGround.Y > (rootPart.Position.Y + 0.5) then
            rootPart.CFrame = CFrame.new(currentPos.X, dynamicGround.Y, currentPos.Z) * (rootPart.CFrame - rootPart.CFrame.p)
        end

        local fd = Vector3.new(targetPos.X - currentPos.X, 0, targetPos.Z - currentPos.Z).Magnitude

        if fd <= stopDistance then
            Movement.stop()
            if onComplete then onComplete() end
        end
    end)

    -- Auto-cleanup khi tween tự hoàn thành
    activeTween.Completed:Connect(function()
        if isMoving then
            Movement.stop()
            if onComplete then onComplete() end
        end
    end)
end


