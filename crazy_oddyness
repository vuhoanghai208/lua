        local lblGold    = MkText(container, "Gold: 0", 26, C_WHITE, true, 162, 36)
        local lblWeapon  = MkText(container, "Weapon: -", 18, C_DIM, false, 208, 26)
        local lblHP      = MkText(container, "HP: -/-  |  Mob: -  |  Quest: -", 16, C_DIM, false, 242, 24)
        local lblStatus  = MkText(container, "Status: Initializing...", 16, C_DIM, false, 274, 24)
        local lblTarget  = MkText(container, "Target: None", 16, C_DIM, false, 304, 24)
        MkSep(container, 340)
        local lblRun     = MkText(container, "ENGINE STATUS: STARTING", 22, C_WHITE, true, 356, 36)

        -- Tên kiếm đang đeo (từ server equipment)
        local function getEquippedWeaponName()
            local pd = NetBridge.PlayerData
            local ew = pd and pd.equipment and pd.equipment.weapon
            if not ew then return "-" end
            local id = type(ew) == "table" and (ew.itemId or ew.id) or tostring(ew or "")
            if id == "" then return "-" end
            for _, w in ipairs(WEAPON_SHOP_LIST) do
                if w.itemId == id then return w.name end
            end
            local aliases = EQUIP_TOOL_MAP[id]
            if aliases and #aliases > 0 then return aliases[1] end
            return id
        end

        -- Toggle (top-right) + hotkey \
        local isOpen = true
        local toggleBtn = Instance.new("TextButton")
        toggleBtn.Name = "MiniToggle"
        toggleBtn.Size = UDim2.new(0, 34, 0, 34)
        toggleBtn.Position = UDim2.new(1, -46, 0, 10)
        toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 25, 50)
        toggleBtn.BorderSizePixel = 0
        toggleBtn.Text = "-"
        toggleBtn.TextSize = 20
        toggleBtn.Font = Enum.Font.GothamBold
        toggleBtn.TextColor3 = C_PURPLE
        toggleBtn.AutoButtonColor = false
        toggleBtn.ZIndex = 1100
        toggleBtn.Parent = sg
        do
            local uc = Instance.new("UICorner"); uc.CornerRadius = UDim.new(0, 8); uc.Parent = toggleBtn
            local us = Instance.new("UIStroke"); us.Color = C_PURPLE; us.Thickness = 1; us.Transparency = 0.4; us.Parent = toggleBtn
        end

        local function SetVisible(v)
            UI.isOpen = v
            container.Visible = v
            bg.Visible = v
            toggleBtn.Text = v and "-" or "+"
            toggleBtn.TextColor3 = v and C_PURPLE or C_GREEN
        end
        toggleBtn.MouseButton1Click:Connect(function() SetVisible(not UI.isOpen) end)
        toggleBtn.MouseEnter:Connect(function() pcall(function() TweenService:Create(toggleBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(50, 40, 80)}):Play() end) end)
        toggleBtn.MouseLeave:Connect(function() pcall(function() TweenService:Create(toggleBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(30, 25, 50)}):Play() end) end)
        UIS.InputBegan:Connect(function(input, gpe)
            if not gpe and input.KeyCode == Enum.KeyCode.BackSlash then SetVisible(not UI.isOpen) end
        end)

        -- Realtime refresh
        task.spawn(function()
            while sg and sg.Parent do
                pcall(function()
                    local now = os.clock()
                    local elapsed = math.max(1, now - UI.uiStart)
                    local eh = math.floor(elapsed / 3600)
                    local em = math.floor((elapsed % 3600) / 60)
                    local es = math.floor(elapsed % 60)
                    if eh > 0 then
                        lblSession.Text = string.format("Session Time: %dh %dm %ds", eh, em, es)
                    else
                        lblSession.Text = string.format("Session Time: %dm %ds", em, es)
                    end

                    local lvl = tonumber(lp:GetAttribute("Level"))
                            or (NetBridge.PlayerData and tonumber(NetBridge.PlayerData.level)) or 0
                    lblLevel.Text = "Level: " .. tostring(lvl)

                    local gold = QuestManager.getGold() or 0
                    lblGold.Text = "Gold: " .. FormatNumber(gold)

                    -- Kiếm đang đeo trên tay
                    lblWeapon.Text = "Weapon: " .. getEquippedWeaponName()

                    local char = lp.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    local hpStr = hum and (math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)) or "-"
                    local mobName = "None"
                    local questStr = "-"
                    if KaitunUI.forceMob then
                        mobName = KaitunUI.forceMob
                    else
                        local m, qi = QuestManager.getActiveQuestTargetMob()
                        if m then
                            mobName = m
                            if qi and qi.questId then questStr = qi.questId .. " " .. (qi.current or 0) .. "/" .. (qi.required or 0) end
                        end
                    end
                    lblHP.Text = string.format("HP: %s  |  Mob: %s  |  Quest: %s", hpStr, mobName, questStr)

                    local status = (KaitunBot.Enabled and "RUNNING / FARMING") or "STOPPED / IDLE"
                    lblStatus.Text = "Status: " .. status
                    lblTarget.Text = "Target: " .. (mobName or "None")

                    lblRun.Text = (KaitunBot.Enabled and "ENGINE STATUS: RUNNING" or "ENGINE STATUS: STOPPED")
                    lblRun.TextColor3 = KaitunBot.Enabled and C_GREEN or C_DIM
                end)
                task.wait(0.3)
            end
        end)

        -- Giữ nguyên trạng thái thu nhỏ/mở của người dùng trước đó
        SetVisible(UI.isOpen == true)
    end

    -- Kích hoạt mount ban đầu
    UI.mount()

    -- WATCHDOG RESTORER: Tự động theo dõi và dựng lại UI 100% nếu bị xóa do chuyển World/Map Join
    task.spawn(function()
        while true do
            task.wait(2.0)
            pcall(function()
                local cg = pcall(function() return game:GetService("CoreGui") end) and game:GetService("CoreGui")
                local pg = lp:FindFirstChild("PlayerGui")
                local uiExists = (cg and cg:FindFirstChild("KaitunDashboard")) or (pg and pg:FindFirstChild("KaitunDashboard"))
                if not uiExists then
                    UI.mount()
                end
            end)
        end
    end)
end

-- ==========================================================================
-- WebhookLogger: báo cáo vàng kiếm được mỗi X giờ qua Discord Webhook.
-- Config lấy từ getgenv().Kaitun (đặt ở đầu file) gồm:
--   Url, IntervalHours, TagId, Enabled.
-- ==========================================================================
local WebhookLogger = {}
do
    local Http = game:GetService("HttpService")
    local lp   = game:GetService("Players").LocalPlayer

    local function GetConfig()
        local cfg = { Url = nil, IntervalHours = 1, TagId = nil, Enabled = true }
        local ok, g = pcall(function() return getgenv() end)
        if ok and type(g) == "table" and type(g.Kaitun) == "table" then
            local u = g.Kaitun
            if u.Url ~= nil then cfg.Url = tostring(u.Url) end
            if u.IntervalHours ~= nil then cfg.IntervalHours = math.max(0.01, tonumber(u.IntervalHours) or 1) end
            if u.TagId ~= nil then cfg.TagId = tostring(u.TagId) end
            if u.Enabled ~= nil then cfg.Enabled = (u.Enabled == true) end
        end
        return cfg
    end

    local function Comma(num)
        local f = tostring(math.floor(tonumber(num) or 0))
        while true do
            local k
            f, k = string.gsub(f, "^(-?%d+)(%d%d%d)", "%1,%2")
            if k == 0 then break end
        end
        return f
    end

    local function SendEmbed(embed)
        local cfg = GetConfig()
        if not cfg.Enabled or not cfg.Url or cfg.Url == "" then return false end
        local content = ""
        if cfg.TagId and cfg.TagId ~= "" then
            content = "<@&" .. cfg.TagId .. ">"
        end
        local payload = Http:JSONEncode({ content = content, embeds = { embed } })

        -- Cross-executor HTTP request fallback for client executors
        local httpRequest = (syn and syn.request) or (http and http.request) or request or http_request
        if type(httpRequest) == "function" then
            pcall(function()
                httpRequest({
                    Url     = cfg.Url,
                    Method  = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body    = payload
                })
            end)
            return true
        else
            return pcall(function()
                return Http:PostAsync(cfg.Url, payload, Enum.HttpContentType.ApplicationJson)
            end)
        end
    end

    function WebhookLogger.send(payload)
        payload = payload or {}
        local lvl = tonumber(lp:GetAttribute("Level")) or (NetBridge.PlayerData and tonumber(NetBridge.PlayerData.level)) or 1
        
        local equippedWeapon = "-"
        pcall(function()
            local pd = NetBridge.PlayerData
            local ew = pd and pd.equipment and pd.equipment.weapon
            local id = type(ew) == "table" and (ew.itemId or ew.id) or tostring(ew or "")
            if id ~= "" and id ~= "nil" then
                for _, w in ipairs(WEAPON_SHOP_LIST) do
                    if w.itemId == id then equippedWeapon = w.name; break end
                end
                if equippedWeapon == "-" and EQUIP_TOOL_MAP[id] then
                    equippedWeapon = EQUIP_TOOL_MAP[id][1]
                end
                if equippedWeapon == "-" then equippedWeapon = id end
            end
        end)

        local embed = {
            color = 0x9B5DF7,
            fields = {
                { name = "Gold Earned", value = Comma(payload.got or 0), inline = true },
                { name = "Earning Rate", value = Comma(payload.rate or 0) .. " Gold/hr", inline = true },
                { name = "Time Window", value = string.format("%dm", math.floor(payload.windowMin or 60)), inline = true },
                { name = "Total Gold", value = Comma(QuestManager.getGold() or 0), inline = true },
                { name = "Player Level", value = tostring(lvl), inline = true },
                { name = "Equipped Weapon", value = equippedWeapon, inline = true },
            },
            footer = { text = lp.Name .. " | Kaitun Engine" },
        }
        return SendEmbed(embed)
    end

    -- Auto tracker: cộng dồn vàng tăng thêm, gửi mỗi IntervalHours
    task.spawn(function()
        local lastGold, windowGold, windowStart = nil, 0, os.clock()
        while true do
            task.wait(5)
            local cfg = GetConfig()
            if cfg.Enabled and cfg.Url and cfg.Url ~= "" and cfg.IntervalHours > 0 then
                local gold = QuestManager.getGold() or 0
                if lastGold and gold >= lastGold then
                    windowGold = windowGold + (gold - lastGold)
                end
                lastGold = gold
                local now = os.clock()
                local el = now - windowStart
                if el >= cfg.IntervalHours * 3600 then
                    if windowGold > 0 then
                        local rate = windowGold / math.max(1, el / 3600)
                        WebhookLogger.send({
                            got = windowGold,
                            rate = rate,
                            windowMin = math.floor(el / 60),
                        })
                    end
                    windowGold = 0
                    windowStart = now
                end
            end
        end
    end)
end
KaitunBot.Webhook = WebhookLogger

return KaitunBot

