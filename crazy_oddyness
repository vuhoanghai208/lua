-- Debug Printer
local UILogBuffer = {}   -- Buffer cho UI console (Log tab)
function debugLog(category, message, ...)
    local formatted
    if select('#', ...) > 0 then
        local ok, res = pcall(string.format, tostring(message), ...)
        formatted = ok and res or tostring(message)
    else
        formatted = tostring(message)
    end
    local line = string.format("[%s] [%s] %s", os.date("%H:%M:%S"), category, formatted)
    print(line)
    table.insert(UILogBuffer, line)
    if #UILogBuffer > 300 then table.remove(UILogBuffer, 1) end
    -- (các tab UI dùng chung buffer này)
end

