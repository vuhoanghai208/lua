-- ==========================================================================
-- MODULE: GraphicsOptimizer (Tắt hiệu ứng đồ họa để giảm tải CPU/GPU/RAM tối đa)
-- Chạy 1 lần khi khởi động + lắng nghe DescendantAdded cho objects mới
-- ==========================================================================
local GraphicsOptimizer = {}

local Lighting = game:GetService("Lighting")

-- Danh sách class cần destroy (hiệu ứng, hậu xử lý, bầu trời)
local DESTROY_CLASSES = {
    PostEffect = true, ColorCorrectionEffect = true, BloomEffect = true,
    BlurEffect = true, SunRaysEffect = true, DepthOfFieldEffect = true,
    Atmosphere = true, Sky = true,
    ParticleEmitter = true, Trail = true, Beam = true,
    Fire = true, Smoke = true, Sparkles = true,
    Decal = true, Texture = true, SpecialMesh = true,
}

-- Xử lý 1 instance: tắt shadow, xóa effect/texture/particle + Ép phẳng tắt hẳn màu Map
local function processInstance(v)
    local class = v.ClassName
    if DESTROY_CLASSES[class] then
        pcall(function() v:Destroy() end)
        return
    end
    if v:IsA("BasePart") then
        pcall(function()
            v.CastShadow = false
            -- TẮT HẮN MÀU MAP: Ép toàn bộ part trên Map về chất liệu SmoothPlastic & màu xám xịt đồng nhất
            local char = LocalPlayer.Character
            if not (char and v:IsDescendantOf(char)) then
                v.Material = Enum.Material.SmoothPlastic
                v.Color    = Color3.fromRGB(100, 100, 100)
            end
        end)
    end
end

function GraphicsOptimizer.apply()
    debugLog("GRAPHICS", "Optimizing graphics pipeline for minimal CPU/GPU usage")

    pcall(function()
        Lighting.GlobalShadows   = false
        Lighting.FogEnd          = 9e9
        Lighting.FogStart        = 9e9
        Lighting.Brightness      = 1
        Lighting.Ambient         = Color3.fromRGB(128, 128, 128)
        Lighting.OutdoorAmbient  = Color3.fromRGB(128, 128, 128)
    end)

    for _, v in ipairs(Lighting:GetChildren()) do
        if DESTROY_CLASSES[v.ClassName] then
            pcall(function() v:Destroy() end)
        end
    end

    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)
    pcall(function()
        game:GetService("UserGameSettings").SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
    end)

    task.spawn(function()
        local count = 0
        for _, v in ipairs(Workspace:GetDescendants()) do
            processInstance(v)
            count = count + 1
            if count % 500 == 0 then task.wait() end
        end
        debugLog("GRAPHICS", "Processed %d objects in Workspace (Shadows/Textures OFF)", count)
    end)

    Workspace.DescendantAdded:Connect(function(v)
        task.defer(function() pcall(processInstance, v) end)
    end)

    debugLog("GRAPHICS", "Graphics optimizer active: Shadows=OFF, Fog=OFF, PostFX=OFF, Quality=L1")
end

-- Tự động kích hoạt khi nạp Script
GraphicsOptimizer.apply()
KaitunBot.start()

