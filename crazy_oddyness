--- Hàm khớp tên vũ khí thông minh hỗ trợ tất cả tên gốc, Tool Name và Display Name
local function matchesWeapon(name, itemId)
    if not name or not itemId then return false end
    local l = string.lower(tostring(name))
    local lowerId = string.lower(tostring(itemId))

    if l == lowerId or string.find(l, lowerId, 1, true) ~= nil then
        return true
    end

    local aliases = EQUIP_TOOL_MAP[itemId]
    if type(aliases) == "table" then
        for _, alias in ipairs(aliases) do
            local la = string.lower(alias)
            if l == la or string.find(l, la, 1, true) ~= nil then
                return true
            end
        end
    elseif type(aliases) == "string" then
        local la = string.lower(aliases)
        if l == la or string.find(l, la, 1, true) ~= nil then
            return true
        end
    end
    return false
end

local lastEquipSentTime = {}  -- debounce: tránh spam equip remote

local function isWeaponEquippedOnCharacter(itemId)
    -- Check 1: Character đang cầm Tool này trực tiếp (unsheathed)
    local char = LocalPlayer.Character
    if char then
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") and matchesWeapon(child.Name, itemId) then
                return true
            end
        end
    end

    -- Check 2: Tool trong Backpack (sheathed)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, child in ipairs(bp:GetChildren()) do
            if child:IsA("Tool") and matchesWeapon(child.Name, itemId) then
                return true
            end
        end
    end

    -- Check 3: Server equipment slot — nguồn sự thật
    -- Game này dùng data-based inventory, không spawn Tool vật lý vào Backpack
    -- Bỏ guard charHasTool: sau respawn character trắng tay nhưng server vẫn ghi nhớ equipped
    if NetBridge.PlayerData and type(NetBridge.PlayerData.equipment) == "table" then
        local equippedWeapon = NetBridge.PlayerData.equipment.weapon
        local equippedId = type(equippedWeapon) == "table"
            and (equippedWeapon.itemId or equippedWeapon.id)
            or tostring(equippedWeapon or "")
        if matchesWeapon(equippedId, itemId) then
            return true
        end
    end

    return false
end


--- Kiểm tra kỹ lưỡng xem kiếm (itemId) đã có trong Hành trang / Nhân vật / Server payload chưa
local function hasWeaponInInventory(itemId)
    -- Check 1: Đã xác nhận từ Server payload hoặc cache sở hữu?
    if ownedWeapons[itemId] == true then
        return true
    end

    -- Check 2: Đang cầm trên tay (Character)
    local char = LocalPlayer.Character
    if char then
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") and matchesWeapon(child.Name, itemId) then
                ownedWeapons[itemId] = true
                return true, child
            end
        end
    end

    -- Check 3: Trong túi đồ (Backpack)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, child in ipairs(bp:GetChildren()) do
            if child:IsA("Tool") and matchesWeapon(child.Name, itemId) then
                ownedWeapons[itemId] = true
                return true, child
            end
        end
    end

    -- Check 4: Trong DataSync PlayerData.inventory từ Server
    if NetBridge.PlayerData and type(NetBridge.PlayerData.inventory) == "table" then
        for _, invItem in pairs(NetBridge.PlayerData.inventory) do
            local invId = type(invItem) == "table" and (invItem.itemId or invItem.id) or tostring(invItem)
            if matchesWeapon(invId, itemId) then
                ownedWeapons[itemId] = true
                return true
            end
        end
    end

    return false, nil
end



local function findWeaponMerchantNPC()
    for _, folderName in ipairs({ "VillageNPCs", "NPCs" }) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, npc in ipairs(folder:GetChildren()) do
                local npcId = npc:GetAttribute("NpcId") or npc.Name
                if npcId == "npc_weapon_merchant" or string.find(string.lower(tostring(npcId)), "weapon") then
                    return npc
                end
            end
        end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name == "npc_weapon_merchant" or obj:GetAttribute("NpcId") == "npc_weapon_merchant") then
            return obj
        end
    end
    return nil
end

local function resetCharacter()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            hum.Health = 0
        else
            pcall(function() char:BreakJoints() end)
        end
    end
end

local function waitForRespawn(timeout)
    local start = os.clock()
    while os.clock() - start < (timeout or 5) do
        local char = LocalPlayer.Character
        if char then
            local hum  = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and root then
                return char, root
            end
        end
        task.wait(0.1)
    end
    local c = LocalPlayer.Character
    return c, c and c:FindFirstChild("HumanoidRootPart")
end

local function ensureShopToken()
    if currentShopToken then return currentShopToken end

    local Net      = require(ReplicatedStorage.Shared.Net)
    local npcModel = findWeaponMerchantNPC()

    if npcModel then
        local npcPos = npcModel:FindFirstChild("HumanoidRootPart") and npcModel.HumanoidRootPart.Position or npcModel:GetPivot().Position
        local targetPos = npcPos + Vector3.new(0, 2, 3)

        local char, rootPart = waitForRespawn(0.3)
        local dist           = rootPart and (rootPart.Position - targetPos).Magnitude or 9999

        -- 1. Nếu ở xa (>100 studs): Tự sát để respawn về Làng gần NPC
        if dist > 100 then
            debugLog("SHOP", "Distance to NPC: %.1fm > 100m -> Resetting to respawn at village", dist)
            Movement.stop()
            resetCharacter()

            -- Chờ nhân vật sống lại tại Làng
            char, rootPart = waitForRespawn(5)
            task.wait(0.3)

            if rootPart then
                dist = (rootPart.Position - targetPos).Magnitude
                debugLog("SHOP", "Respawned at village (distance to NPC: %.1fm)", dist)
            end
        end

        -- 2. Di chuyển từ Làng tới sát NPC Merchant — timeout động theo khoảng cách thực tế
        if dist > 8 then
            local walkTimeout = math.ceil(dist / 28) + 5  -- buffer 5s (dist/28 studs per second)
            debugLog("SHOP", "Navigating to merchant NPC (distance: %.1fm, timeout: %ds)...", dist, walkTimeout)
            Movement.walkTween(targetPos, 34, 5.0)

            local startTime = os.clock()
            while os.clock() - startTime < walkTimeout do
                local curChar = LocalPlayer.Character
                local curRoot = curChar and curChar:FindFirstChild("HumanoidRootPart")
                if curRoot and (curRoot.Position - targetPos).Magnitude <= 8 then
                    rootPart = curRoot
                    break
                end
                task.wait(0.1)
            end
            Movement.stop()
        end

        -- 3. Kích hoạt ProximityPrompt để server gửi e14b5f0 (token chỉ đến qua ProximityPrompt)
        local prompt = npcModel:FindFirstChildWhichIsA("ProximityPrompt", true)
        local promptStart = os.clock()

        while os.clock() - promptStart < 5.0 and not currentShopToken do
            if prompt and fireproximityprompt then
                pcall(function() fireproximityprompt(prompt) end)
            end
            -- KHÔNG dùng ebe39b7 action="shop" — đó là quest remote, server sẽ ignore
            task.wait(0.3)
        end

        if currentShopToken then
            debugLog("SHOP", "Acquired shop token: %s", currentShopToken)
        else
            debugLog("SHOP", "Failed to acquire shop token")
        end
    end

    return currentShopToken
end


function EconomyUpgrade.autoBuyAndEquipBestWeapon()
    if EconomyUpgrade.isBuyingWeapon then return end

    -- Cooldown sau khi mua fail (too_far): chờ DataSync cập nhật inventory trước khi retry
    if EconomyUpgrade.buyFailCooldownUntil and os.clock() < EconomyUpgrade.buyFailCooldownUntil then
        return  -- im lặng, không spam log
    end

    -- Chờ DataSync từ Server nạp xong kho đồ
    local inv = NetBridge.PlayerData and NetBridge.PlayerData.inventory
    if type(inv) ~= "table" then return end

    -- Tự động kiểm tra xả bán rác khi tích đủ >= 1,000 món
    pcall(EconomyUpgrade.autoSellLoot)

    local Net  = require(ReplicatedStorage.Shared.Net)
    local gold = QuestManager.getGold()

    -- Build set kiếm đang có trong kho từ PlayerData.inventory trực tiếp
    -- Hỗ trợ cả 2 định dạng Server gửi:
    --   Array:   inv[1] = {itemId="wood", qty=137, ...}
    --   HashMap: inv["wood"] = {qty=137, ...}  (key là itemId)
    local invWeaponSet = {}
    local invSize = 0
    for k, invItem in pairs(inv) do
        invSize = invSize + 1
        local itemId = ""
        if type(invItem) == "table" then
            -- Thử lấy itemId từ field trước
            itemId = tostring(invItem.itemId or invItem.id or "")
            -- Nếu không có → key k chính là itemId (HashMap format)
            if itemId == "" and type(k) == "string" then
                itemId = k
            end
        elseif type(k) == "string" then
            -- invItem là value đơn giản (number/string), key k là itemId
            itemId = k
        end
        if itemId ~= "" then
            invWeaponSet[itemId] = true
        end
    end
    -- Ghi nhận thêm từ equipment slot (weapon đang đeo server-side)
    if type(NetBridge.PlayerData.equipment) == "table" then
        local ew = NetBridge.PlayerData.equipment.weapon
        local wId = type(ew) == "table" and (ew.itemId or ew.id) or tostring(ew or "")
        if wId ~= "" and wId ~= "nil" then
            invWeaponSet[wId] = true
        end
    end

    -- DEBUG: Dump vũ khí phát hiện được (xóa sau khi xác nhận hoạt động)
    local foundWeapons = {}
    for itemId in pairs(invWeaponSet) do table.insert(foundWeapons, itemId) end
    debugLog("INVENTORY", "Inventory size: %d | Weapons: [%s]", invSize, table.concat(foundWeapons, ", "))

    for _, w in ipairs(WEAPON_SHOP_LIST) do
        local hasIt = invWeaponSet[w.itemId] == true

        -- TRƯỜNG HỢP A: Đã sở hữu kiếm này trong kho Server
        if hasIt then
            if not isWeaponEquippedOnCharacter(w.itemId) then
                debugLog("EQUIP", "Equipping best weapon: %s", w.name)
                Net.event("e534d20"):FireServer(w.itemId)
                task.wait(0.3)
                Net.event("e4a8bee"):FireServer()
            else
                debugLog("EQUIP", "Best weapon equipped: %s", w.name)
            end
            break
        end

        -- TRƯỜNG HỢP B: Chưa sở hữu & Đủ Gold mua
        if gold >= w.price then
            EconomyUpgrade.isBuyingWeapon = true -- Khóa vòng lặp farm chính để tập trung mua sắm
            EconomyUpgrade.currentBuyingItemId = w.itemId
            debugLog("SHOP", "Sufficient gold (%d) -> Initiating purchase: %s", gold, w.name)


            -- 1. Đảm bảo có Shop Token hợp lệ (nếu chưa có -> tự tương tác NPC lấy Token)
            local token = ensureShopToken()
            if not token then
                debugLog("SHOP", "Shop token unavailable -> Deferred purchase: %s", w.name)
                EconomyUpgrade.isBuyingWeapon = false
                break
            end

            debugLog("SHOP", "Sending purchase: %s (%s)", w.name, w.itemId)

            -- 2. Gửi lệnh mua chính thức với token hợp lệ (e3dbafe)
            Net.event("e3dbafe"):FireServer({
                type   = "buy",
                shopId = "village_weapon",
                itemId = w.itemId,
                tk     = token
            })
            -- Optimistic lock KHÔNG đặt ở đây nữa — chỉ set sau khi server confirm (e24efa7 buy_success/already_owned)
            -- Để tránh loop mua lại vô hạn khi server reject (too_far / not_owned)

            -- 3. Gửi lệnh trang bị (e534d20)

            task.wait(0.2)
            debugLog("EQUIP", "Equipping purchased weapon: %s", w.name)
            Net.event("e534d20"):FireServer(w.itemId)
            lastEquippedWeapon = w.itemId

            -- 4. Tự sát (Health=0) để respawn quay lại bãi farm siêu tốc
            debugLog("SHOP", "Purchased and equipped %s -> Resetting character to return to farm", w.name)
            Movement.stop()
            resetCharacter()
            waitForRespawn(4)

            -- Clear token sau khi đã dùng: server thường invalidate session token sau 1 lần giao dịch
            currentShopToken = nil

            EconomyUpgrade.isBuyingWeapon = false -- Mở lại vòng lặp farm chính
            break -- Chỉ mua 1 thanh kiếm mạnh nhất vừa đủ tiền trong lượt này
        end
    end
end


