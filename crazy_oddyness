local IntroHandler = {
    nicknameDone = false
}

function IntroHandler.restoreAllGuis()
    LocalPlayer:SetAttribute("HudRevealed", true)
    LocalPlayer:SetAttribute("StartScreenOpen", nil)

    pcall(function()
        local StarterGui = game:GetService("StarterGui")
        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
    end)

    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end

    local ignoredGuis = {
        StartScreenGui = true,
        LoadingScreen  = true,
        StartFlashGui  = true,
        AfkGui         = true,
        NameInputGui   = true,
        KeybindGui     = true,
        SettingsGui    = true,
    }

    for _, child in ipairs(playerGui:GetChildren()) do
        if child:IsA("ScreenGui") and not ignoredGuis[child.Name] then
            if not child.Enabled then
                child.Enabled = true
            end
        end
    end
end

function IntroHandler.autoBypassStartScreen()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end
    
    local startScreenGui = playerGui:FindFirstChild("StartScreenGui")
    if startScreenGui and (startScreenGui.Enabled or LocalPlayer:GetAttribute("StartScreenOpen") == true) then
        debugLog("START-SCREEN", "Phát hiện Màn hình Join Game -> Tự động Bỏ qua & Khôi phục Giao diện!")

        local screen     = startScreenGui:FindFirstChild("Screen")
        local mainColumn = screen and screen:FindFirstChild("MainColumn")
        local playBtn    = mainColumn and mainColumn:FindFirstChild("PlayBtn")

        if playBtn and firesignal then
            pcall(function() firesignal(playBtn.Activated) end)
            pcall(function() firesignal(playBtn.MouseButton1Click) end)
        end

        -- Ép giải phóng khóa giao diện ngay lập tức
        LocalPlayer:SetAttribute("StartScreenOpen", nil)
        startScreenGui.Enabled = false

        -- Xóa Blur Effect trong Lighting nếu có (Xử lý dứt điểm rủi ro bị Blur vĩnh viễn)
        pcall(function()
            local blur = game:GetService("Lighting"):FindFirstChild("StartScreenBlur")
            if blur then blur:Destroy() end
        end)

        -- Unbind Camera RenderStep của StartScreen nếu có (Tránh camera bị kẹt/khóa góc nhìn)
        pcall(function()
            RunService:UnbindFromRenderStep("StartScreenCamBlend")
        end)

        -- Khôi phục Camera Custom & Controls di chuyển
        pcall(function()
            local camera = workspace.CurrentCamera
            if camera then
                camera.CameraType = Enum.CameraType.Custom
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum then camera.CameraSubject = hum end
            end
        end)

        pcall(function()
            local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
            local playerModule = playerScripts and playerScripts:FindFirstChild("PlayerModule")
            if playerModule then
                local controls = require(playerModule):GetControls()
                if controls and controls.Enable then controls:Enable() end
            end
        end)

        -- Khôi phục 100% Giao diện HUD, Topbar, SkillBar
        IntroHandler.restoreAllGuis()
    end
end

function IntroHandler.autoSetNickname()
    if IntroHandler.nicknameDone then return end

    local currentName = NetBridge and NetBridge.PlayerData and NetBridge.PlayerData.name
    if type(currentName) == "string" and currentName ~= "" then
        IntroHandler.nicknameDone = true
        return
    end

    local namePending = LocalPlayer:GetAttribute("NameInputPending")
    local playerGui   = LocalPlayer:FindFirstChild("PlayerGui")
    local nameGui     = playerGui and playerGui:FindFirstChild("NameInputGui")

    -- Chỉ chạy khi có yêu cầu nhập tên từ Game (NameInputPending hoặc NameInputGui hiển thị)
    if namePending or (nameGui and nameGui.Enabled) then
        local HttpService = game:GetService("HttpService")
        local randomSuffix = string.upper(string.sub(HttpService:GenerateGUID(false), 1, 5))
        local generatedName = "Kt_" .. randomSuffix

        debugLog("INTRO-NAME", "Phát hiện Acc Mới chưa có tên -> Tự động đặt tên nhân vật: %s", generatedName)

        local Net = require(game:GetService("ReplicatedStorage").Shared.Net)
        local success, result = pcall(function()
            return Net.func("ee075f4"):InvokeServer(generatedName)
        end)

        if success and type(result) == "table" then
            if result.success or result.reason == "already_set" then
                IntroHandler.nicknameDone = true
                if nameGui then nameGui.Enabled = false end
                LocalPlayer:SetAttribute("NameInputPending", nil)
                if result.success then
                    debugLog("INTRO-NAME", ">>> ĐẶT TÊN THÀNH CÔNG: %s <<<", generatedName)
                    Net.event("e5f9a2c"):FireServer()
                    Net.event("e4a8bee"):FireServer() -- Sync lại Data
                else
                    debugLog("INTRO-NAME", "Acc đã có tên từ trước (already_set) -> Đã hoàn tất đặt tên.")
                end
            else
                debugLog("INTRO-WARN", "Đặt tên chưa hoàn tất (%s), sẽ thử lại...", tostring(result.reason or "waiting"))
            end
        end
    end
end

function IntroHandler.checkAll()
    pcall(IntroHandler.autoBypassStartScreen)
    pcall(IntroHandler.autoSetNickname)
    pcall(IntroHandler.restoreAllGuis)
end


