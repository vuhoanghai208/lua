function QuestManager.getGold()
    -- 1. Check Attributes
    local attrGold = LocalPlayer:GetAttribute("Gold") or LocalPlayer:GetAttribute("gold")
    if attrGold then
        local g = tonumber(attrGold)
        if g and g >= 0 then return g end
    end

    -- 2. Check PlayerData
    if NetBridge.PlayerData and NetBridge.PlayerData.gold then
        local g = tonumber(NetBridge.PlayerData.gold)
        if g and g >= 0 then return g end
    end

    -- 3. Check leaderstats
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        local gVal = leaderstats:FindFirstChild("Gold") or leaderstats:FindFirstChild("gold")
        if gVal then return tonumber(gVal.Value) or 0 end
    end

    -- 4. Check Data folder
    local dataFolder = LocalPlayer:FindFirstChild("Data")
    if dataFolder then
        local gVal = dataFolder:FindFirstChild("Gold") or dataFolder:FindFirstChild("gold")
        if gVal then return tonumber(gVal.Value) or 0 end
    end

    return 0
end


