function NetBridge.getRemote(actionName, isFunction)
    local hashKey = NetBridge.ACTION_MAP[actionName] or actionName
    return isFunction and Net.func(hashKey) or Net.event(hashKey)
end

function NetBridge.fire(actionName, ...)
    local remote = NetBridge.getRemote(actionName, false)
    if remote then remote:FireServer(...) end
end

function NetBridge.invoke(actionName, ...)
    local remote = NetBridge.getRemote(actionName, true)
    if remote then return remote:InvokeServer(...) end
    return nil
end

function NetBridge.on(actionName, callback)
    local remote = NetBridge.getRemote(actionName, false)
    if remote then return remote.OnClientEvent:Connect(callback) end
    return nil
end

local function handleDataSync(payload)
    if type(payload) == "table" then
        for k, v in pairs(payload) do
            NetBridge.PlayerData[k] = v
        end

        -- Cập nhật runtime cache ownedWeapons từ Server Inventory
        -- Chỉ ghi nhận vũ khí (category = equipment), bỏ qua loot/vật liệu
        if type(payload.inventory) == "table" then
            for _, invItem in pairs(payload.inventory) do
                if type(invItem) ~= "table" then continue end
                local itemId = invItem.itemId or invItem.id or ""
                local cat    = tostring(invItem.category or invItem.cat or "")
                local isWeapon = (string.find(cat, "equipment", 1, true) ~= nil)
                              or (string.find(tostring(invItem.equipSlot or ""), "weapon", 1, true) ~= nil)
                if isWeapon and itemId ~= "" then
                    ownedWeapons[itemId] = true
                end
            end
        end
        -- Ghi nhận vũ khí đang đeo trong equipment slot
        if type(payload.equipment) == "table" then
            local eqWeapon = payload.equipment.weapon
            local wId = type(eqWeapon) == "table" and (eqWeapon.itemId or eqWeapon.id) or tostring(eqWeapon or "")
            if wId ~= "" and wId ~= "nil" then
                ownedWeapons[wId] = true
            end
        end

        debugLog("NET", "DataSync synced: Level=%s, Gold=%s", tostring(NetBridge.PlayerData.level), tostring(NetBridge.PlayerData.gold))
    end
end

NetBridge.on("DATA_SYNC", handleDataSync)
pcall(function()
    Net.event("e9131bc").OnClientEvent:Connect(handleDataSync)
end)

