local lastSkipLogTimes = {}
local lastNoQuestTime   = 0

function QuestManager.getActiveQuestTargetMob()
    local progressTable = NetBridge.PlayerData and NetBridge.PlayerData.questProgress
    local playerLevel   = tonumber(LocalPlayer:GetAttribute("Level")) or (NetBridge.PlayerData and tonumber(NetBridge.PlayerData.level)) or 1
    playerLevel = math.max(1, playerLevel)

    local hasSkippedQuest = false

    if type(progressTable) == "table" then
        for questId, data in pairs(progressTable) do
            -- BUG4 FIX: Chỉ coi Quest là Active khi data.accepted == true (hoặc data.accepted == nil nhưng đang có progress/target)
            local isAccepted = (data.accepted == true) or (data.accepted == nil and (data.progress ~= nil or data.target ~= nil))
            if type(data) == "table" and isAccepted and data.completed ~= true and data.status ~= "completed" then
                local questMinLevel = tonumber(QuestMinLevels[questId]) or 1
                local maxGap = QuestManager.getMaxLevelGap(playerLevel)
                if questMinLevel - playerLevel > maxGap then
                    hasSkippedQuest = true
                    local now = os.clock()
                    local lastLog = lastSkipLogTimes[questId] or 0
                    if now - lastLog >= 10 then
                        lastSkipLogTimes[questId] = now
                        debugLog("QUEST-SKIP", "Tạm hoãn Quest %s vì minLevel (%d) vượt quá %d cấp so với Level (%d) -> Ưu tiên cày cấp", tostring(questId), questMinLevel, maxGap, playerLevel)
                    end
                else
                    local targetMob = data.target or data.mobId or QuestMobMap[questId]
                    if not targetMob and type(data.condition) == "table" then
                        targetMob = data.condition.target
                    end
                    
                    if not targetMob and type(questId) == "string" then
                        for mobKey, _ in pairs(MonsterSpawnCenters) do
                            if string.find(string.lower(questId), string.lower(mobKey)) then
                                targetMob = mobKey
                                break
                            end
                        end
                    end
                    
                    if targetMob then
                        local current = tonumber(data.progress or data.count or 0) or 0
                        local rawReq  = tonumber(data.required) or tonumber(data.targetCount)
                        local QuestDefs = pcall(function() return require(ReplicatedStorage.Shared.Defs.QuestDefs) end) and require(ReplicatedStorage.Shared.Defs.QuestDefs) or nil
                        local questDef  = QuestDefs and QuestDefs[questId]
                        local defRequired = questDef and questDef.condition and tonumber(questDef.condition.required)
                        local required = (rawReq and rawReq > 0) and rawReq or defRequired or QuestRequiredDefs[questId] or DefaultTargetCounts[targetMob] or 10
                        local isServerReady = (data.ready == true) or (data.status == "ready_to_turn_in") or (data.canTurnIn == true) or (required > 0 and current >= required)

                        if isServerReady then
                            return targetMob, { current = current, required = required, questId = questId, readyToTurnIn = true, accepted = true }, hasSkippedQuest
                        else
                            return targetMob, { current = current, required = required, questId = questId, readyToTurnIn = false, accepted = true }, hasSkippedQuest
                        end
                    end
                end
            end
        end
    end
    
    return QuestManager.getRecommendedMobForLevel(), nil, hasSkippedQuest
end

function QuestManager.acceptQuest(questId, npcId)
    npcId = npcId or "village_elder"
    debugLog("QUEST", "Đang gửi lệnh nhận Quest chuẩn xác (ebe39b7): %s (NPC: %s)", tostring(questId), tostring(npcId))
    Net.event("ebe39b7"):FireServer({
        npcId   = npcId,
        action  = "accept",
        questId = questId,
        tk      = currentShopToken
    })
end

function QuestManager.completeQuest(questId, npcId)
    npcId = npcId or "village_elder"
    debugLog("QUEST", "Đang gửi lệnh trả Quest chuẩn xác (ebe39b7): %s (NPC: %s)", tostring(questId), tostring(npcId))
    Net.event("ebe39b7"):FireServer({
        npcId   = npcId,
        action  = "turnin",
        questId = questId,
        tk      = currentShopToken
    })
end

function QuestManager.getRecommendedMobForLevel()
    local level = tonumber(LocalPlayer:GetAttribute("Level")) or 0
    if level == 0 and NetBridge.PlayerData and NetBridge.PlayerData.level then
        level = tonumber(NetBridge.PlayerData.level) or 1
    end
    level = math.max(1, level)
    for _, config in ipairs(QuestManager.LEVEL_ROADMAP) do
        if level >= config.minLevel and level <= config.maxLevel then
            return config.mobId
        end
    end
    return "pig"
end

