local function generateHumanKoreanNickname()
    local base = KOREAN_NAME_BASES[math.random(1, #KOREAN_NAME_BASES)]
    local style = math.random(1, 3)
    local name = base
    if style == 1 then
        local num = math.random(1, 99)
        name = string.format("%s%02d", base, num)
    elseif style == 2 then
        local num = math.random(1, 99)
        name = string.format("%s_%d", base, num)
    else
        local suffix = (math.random(1, 2) == 1 and "i") or string.sub(base, -1)
        name = base .. suffix
    end
    if #name > 12 then name = string.sub(name, 1, 12) end
    return name
end

