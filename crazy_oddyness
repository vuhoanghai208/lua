-- Số lượng cần GIỮ LẠI vì quest collect_item đang chạy cần (không được bán)
--- Làm theo progress của từng quest active (accepted & chưa completed).
local function getQuestCollectReserve()
    local reserve = {}
    local progressTable = NetBridge.PlayerData and NetBridge.PlayerData.questProgress
    if type(progressTable) ~= "table" then return reserve end

    local QuestDefs = require(ReplicatedStorage.Shared.Defs.QuestDefs)

    for questId, data in pairs(progressTable) do
        if type(data) ~= "table" then continue end
        -- active: đã nhận, chưa hoàn thành
        local isAccepted = (data.accepted == true)
                        or (data.accepted == nil and (data.progress ~= nil or data.target ~= nil))
        if not isAccepted then continue end
        if data.completed == true or data.status == "completed" then continue end

        local questDef = QuestDefs[questId]
        local cond     = questDef and questDef.condition
        if not (cond and cond.type == "collect_item" and type(cond.itemId) == "string") then continue end

        local required = tonumber(cond.required) or 0
        -- Resolve đủ `required`: quest main collect (`keepItems=false` mặc định) sẽ CONSUME
        -- item thật trong kho lúc turn-in → phải giữ nguyên lượng cần, không phải phần thiếu.
        if required > 0 then
            reserve[cond.itemId] = math.max(reserve[cond.itemId] or 0, required)
        end
    end
    return reserve
end

function EconomyUpgrade.autoSellLoot()
    local inv = NetBridge.PlayerData and NetBridge.PlayerData.inventory
    if type(inv) ~= "table" then return end

    local Net      = require(ReplicatedStorage.Shared.Net)
    local SELL_THRESHOLD = 1000  -- Bán khi tích >= X cái

    -- Reserve số lượng nguyên liệu cần giữ cho quest collect_item đang chạy
    local questReserve = getQuestCollectReserve()
    if not EconomyUpgrade._lastReserveLog then EconomyUpgrade._lastReserveLog = 0 end
    if os.clock() - EconomyUpgrade._lastReserveLog >= 30 then
        EconomyUpgrade._lastReserveLog = os.clock()
        for itemId, need in pairs(questReserve) do
            debugLog("SHOP", "Reserving %d [%s] for active quest", need, itemId)
        end
    end

    local now = os.time()
    local forceClean = false
    -- Dọn sạch sẽ kho mỗi 15 phút (900s) để clear rác bãi farm cũ (số lượng < 1000)
    if not EconomyUpgrade.lastForceSellTime then EconomyUpgrade.lastForceSellTime = now end
    if now - EconomyUpgrade.lastForceSellTime >= 900 then
        forceClean = true
        EconomyUpgrade.lastForceSellTime = now
        debugLog("SHOP", "Periodic inventory cleanup triggered (15m interval)")
    end

    for k, invItem in pairs(inv) do
        local itemId = ""
        local qty    = 0
        if type(invItem) == "table" then
            itemId = tostring(invItem.itemId or invItem.id or (type(k) == "string" and k) or "")
            qty    = tonumber(invItem.qty or invItem.count or invItem.amount or 0) or 0
        elseif type(k) == "string" then
            itemId = k
            qty    = tonumber(invItem) or 0
        end

        if itemId == "" then continue end

        local isPreserved = PRESERVED_MATERIALS[itemId]
                         or string.find(itemId, "rune",   1, true)
                         or string.find(itemId, "scroll", 1, true)

        local qtyToSell = qty
        if not isPreserved then
            local reserved = questReserve[itemId] or 0
            if reserved > 0 then
                qtyToSell = math.max(0, qty - reserved)
                if qtyToSell == 0 then continue end
            end
        end

        if not isPreserved and (qty >= SELL_THRESHOLD or (forceClean and qty > 0)) then
            if forceClean and qty < SELL_THRESHOLD then
                debugLog("SHOP", "Selling trash item: %d/%d [%s]", qtyToSell, qty, itemId)
            else
                debugLog("SHOP", "Selling item threshold reached: %d [%s]", qtyToSell, itemId)
            end
            Net.event("ec134ea"):FireServer({
                type   = "sell",
                itemId = itemId,
                qty    = qtyToSell
            })
            task.wait(0.3)
        end
    end
end


-- ==========================================================================
-- MAIN KAITUN BOT LOADER WITH SMOOTH WALK TWEEN MOVEMENT
-- ==========================================================================
local KaitunBot = {
    Enabled = false,
    CurrentTarget = nil
}

function KaitunBot.start()
    if KaitunBot.Enabled then return end
    KaitunBot.Enabled = true
    
    debugLog("SYSTEM", "Kaitun engine initialized")
    
    IntroHandler.checkAll()
    NetBridge.fire("CLIENT_INIT")
    QuestManager.requestSync()
    
    -- Vòng lặp kiểm tra tự động Bỏ Màn Join Game & Đặt Tên Acc Mới
    task.spawn(function()
        while KaitunBot.Enabled do
            IntroHandler.checkAll()
            task.wait(1.5)
        end
    end)
    
    task.spawn(function()
        local lastReportTime     = 0
        local lastWarnTime       = 0   -- throttle log "Chờ quái respawn" (1 lần/10s)
        local lastNpcInteractTime= 0
        local isWaitingForQuestResponse = false
        local _isJobChangePending   = false  -- Mode chuyển nghề độc lập: bypass toàn bộ farm/quest
        local _jobChangeNpcInteracted = false
        -- Stuck detection

        local lastStuckCheck     = 0
        local lastStuckPos       = nil
        local stuckCount         = 0
        local waterStuckStart    = nil
        local STUCK_TIMEOUT      = 4    -- 4 giây không di chuyển được → kẹt cây/địa hình
        local STUCK_THRESHOLD    = 4    -- studs tối thiểu phải di chuyển trong STUCK_TIMEOUT

        local lastCollideSet     = 0

        while KaitunBot.Enabled do
            if EconomyUpgrade.isBuyingWeapon then
                task.wait(0.5)
            else
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local now = os.clock()
                    -- Tối ưu máy yếu: Chỉ quét setCharacterCanCollide mỗi 2.0s thay vì quét mỗi 0.15s
                    if now - lastCollideSet >= 2.0 then
                        lastCollideSet = now
                        setCharacterCanCollide(character, false)
                    end

                    local rootPart   = character:FindFirstChild("HumanoidRootPart")
                    local currentPos = rootPart.Position

                    -- 1. Xác định Quái mục tiêu (Ưu tiên theo Quest)
                    local mobId, questProgressInfo, hasSkippedQuest = QuestManager.getActiveQuestTargetMob()
                    local now = os.clock()

                    -- UI HOOK: Force Mob (ép farm 1 bãi) hoặc Auto Quest (farm theo level khi tắt quest)
                    if KaitunUI and not KaitunUI.AllowQuest then
                        questProgressInfo = nil
                        hasSkippedQuest   = false
                    end
                    if KaitunUI and KaitunUI.forceMob and not KaitunUI.AllowQuest then
                        mobId = KaitunUI.forceMob
                    end

                    -- Water / Swimming escape detection: nếu nhân vật rơi xuống sông/hồ nước (>3.5s) -> Tự sát respawn về Làng thoát kẹt
                    local hum = character:FindFirstChildOfClass("Humanoid")
                    if hum then
                        local state = hum:GetState()
                        if state == Enum.HumanoidStateType.Swimming or hum.FloorMaterial == Enum.Material.Water then
                            if not waterStuckStart then
                                waterStuckStart = now
                            elseif now - waterStuckStart >= 3.5 then
                                debugLog("NAVIGATION", "Character in water (>3.5s) -> Resetting to land")
                                waterStuckStart = nil
                                Movement.stop()
                                resetCharacter()
                                waitForRespawn(4)
                            end
                        else
                            waterStuckStart = nil
                        end
                    end

                    -- VOID / UNDERGROUND (Y < -8): thoát ra khỏi lòng đất.
                    -- KHÔNG set CFrame 1 phát (MovementGuard server 'teleport_confirmed'
                    -- khi nhảy >70 studs + speed>240 -> kick). Dùng walkTween nội suy 60studs/s,
                    -- luôn dưới ngưỡng teleport, bot lướt mượt về mặt đất bãi quái.
                    if currentPos.Y < -8 then
                        local spawnCenterVoid = MonsterSpawnCenters[mobId]
                        local rescueY = spawnCenterVoid and (spawnCenterVoid.Y + 2) or 22
                        local rescueX = spawnCenterVoid and spawnCenterVoid.X or currentPos.X
                        local rescueZ = spawnCenterVoid and spawnCenterVoid.Z or currentPos.Z
                        debugLog("NAVIGATION", "Underground detected (Y=%.1f) -> Rescuing position", currentPos.Y)
                        Movement.stop()
                        Movement.walkTween(Vector3.new(rescueX, rescueY, rescueZ), 60, 3.0)
                        stuckCount = 0
                        lastStuckPos = nil
                        task.wait(0.3)
                    end

                    -- Stuck detection: mỗi 4 giây kiểm tra nếu bị vướng thân cây / địa hình
                    if now - lastStuckCheck >= STUCK_TIMEOUT then
                        if lastStuckPos then
                            local moved = (currentPos - lastStuckPos).Magnitude
                            if moved < STUCK_THRESHOLD then
                                stuckCount = stuckCount + 1
                                local hum = character:FindFirstChildOfClass("Humanoid")

                                -- THOÁT KẸT TRÊN CÀNH CÂY / KHUNG CAO: Nếu Y > 35 hoặc kẹt liên tiếp >= 2 lần (8s)
                                if currentPos.Y > 35 or stuckCount >= 2 then
                                    local label = currentPos.Y < 0 and "VOID/GROUND" or "TREE"
                                    debugLog("NAVIGATION", "Stuck detected (%s, Y=%.1f, count=%d) -> Repositioning to ground", label, currentPos.Y, stuckCount)
                                    Movement.stop()
                                    setCharacterCanCollide(character, false)
                                    
                                    local dropY = (currentTargetPos and currentTargetPos.Y < 32) and (currentTargetPos.Y + 2.5) or 22
                                    rootPart.CFrame = CFrame.new(currentPos.X, dropY, currentPos.Z)
                                    stuckCount = 0
                                else
                                    if hum then
                                        Movement.stop()
                                        setCharacterCanCollide(character, false)
                                        NetBridge.fire("BASIC_ATTACK")
                                        hum:ChangeState(Enum.HumanoidStateType.Jumping)
                                    end
                                    debugLog("NAVIGATION", "Stuck detected (%.1fm in %ds) -> Clearing obstacles", moved, STUCK_TIMEOUT)
                                end
                            else
                                stuckCount = 0
                            end
                        end
                        lastStuckPos   = currentPos
                        lastStuckCheck = now
                    end

                    -- Status log mỗi 5 giây & kiểm tra xả bán rác khi tích đủ >= 1000 món
                    if now - lastReportTime >= 5 then
                        lastReportTime = now
                        pcall(EconomyUpgrade.autoSellLoot)
                        local posStr = string.format("(%.0f,%.0f,%.0f)", currentPos.X, currentPos.Y, currentPos.Z)
                        if questProgressInfo then
                            debugLog("STATUS", "Quest: %s | Mob: %s (%d/%d) | Gold: %d | Pos: %s",
                                tostring(questProgressInfo.questId), mobId,
                                questProgressInfo.current, questProgressInfo.required,
                                QuestManager.getGold(), posStr)
                        else
                            debugLog("STATUS", "Farm: %s | Gold: %d | Pos: %s", mobId, QuestManager.getGold(), posStr)
                        end
                    end

                    -- TỰ ĐỘNG CHẠY VỀ VILLAGE ELDER:
                    -- Case A: Quest đã hoàn thành sẵn sàng trả (readyToTurnIn == true)
                    -- Case B: Chưa có Quest active (questProgressInfo == nil), KHÔNG bị hoãn quest (hasSkippedQuest == false) VÀ không nằm trong thời gian chờ (noQuestAvailable == false)
                    local playerLevel = tonumber(LocalPlayer:GetAttribute("Level")) or (NetBridge.PlayerData and tonumber(NetBridge.PlayerData.level)) or 1

                    -- ĐỐI VỚI ACC LEVEL 5 -> 14: Ưu tiên bãi Pig thẳng lên Level 15 trước khi nhận Quest lặt vặt
                    local _readyToTurnIn  = questProgressInfo and questProgressInfo.readyToTurnIn == true
                    local _hasActiveQuest = questProgressInfo ~= nil
                    local noQuestAvailable = (os.clock() - lastNoQuestTime) < 20

                    -- BẢO VỆ CHỐNG TỰ SÁT LẶP LẠI MỖI 120s KHI CHƯA ĐỦ MINLEVEL:
                    -- Nếu quest vừa bị từ chối do minLevel > playerLevel (ví dụ crab_cull minLevel=30 vs playerLevel=24),
                    -- thì KHÓA KHÔNG CHO QUAY VỀ NPC cho đến khi playerLevel >= rejectedMinLevel (Level 30).
                    local isBlockedByMinLevel = (QuestManager.rejectedMinLevel ~= nil and playerLevel < QuestManager.rejectedMinLevel)
                    if not isBlockedByMinLevel and QuestManager.rejectedMinLevel and playerLevel >= QuestManager.rejectedMinLevel then
                        QuestManager.rejectedMinLevel = nil -- Đã đủ Level, giải phóng lock
                    end

                    local isLowLevelFarmPig = (playerLevel >= 5 and playerLevel <= 15 and not _readyToTurnIn)
                    local needReturnToElder = not isLowLevelFarmPig and not isBlockedByMinLevel and (_readyToTurnIn or (not _hasActiveQuest and not hasSkippedQuest and not noQuestAvailable))
                    -- UI HOOK: khi ép farm 1 bãi thì bỏ qua logic quay về NPC
                    if KaitunUI and (not KaitunUI.AllowQuest or KaitunUI.forceMob) then
                        needReturnToElder = false
                    end
                    -- Override mục tiêu sang Pig khi đang trong mode farm pig (bỏ qua quest hiện tại)
                    if isLowLevelFarmPig then
                        mobId = "pig"
                    end

                    local rawJob = LocalPlayer:GetAttribute("Job") or LocalPlayer:GetAttribute("JobId") or LocalPlayer:GetAttribute("jobId") or (NetBridge.PlayerData and (NetBridge.PlayerData.jobId or NetBridge.PlayerData.job)) or ""
                    local playerJob = string.lower(tostring(rawJob))
                    local unlockedJobs = NetBridge.PlayerData and NetBridge.PlayerData.unlockedJobs
                    local isMagicswordUnlocked = (type(unlockedJobs) == "table" and unlockedJobs["magicsword"] == true)

                    -- ===== DEDICATED JOB CHANGE MODE =====
                    -- Khi phát hiện Level >= 10 và chưa là magicsword (và chưa từng nói chuyện chuyển nghề thành công với NPC):
                    -- Bật flag riêng, bypass toàn bộ farm/quest/suicide, chỉ walk thẳng đến NPC.
                    local _needJobChange = playerLevel >= 10 
                                          and playerJob ~= "magicsword" 
                                          and not isMagicswordUnlocked 
                                          and not QuestManager.jobChangeCompleted
                                          and not (questProgressInfo and not questProgressInfo.readyToTurnIn)
                    if _needJobChange and not _isJobChangePending then
                        _isJobChangePending     = true
                        _jobChangeNpcInteracted = false
                        debugLog("JOB", "Job change pending (Level=%d, Job='%s') -> Navigating to npc_dark_sword_chief", playerLevel, playerJob)
                    end
                    if not _needJobChange then
                        _isJobChangePending     = false
                        _jobChangeNpcInteracted = false
                    end

                    if _isJobChangePending then
                        local jcNpcId      = "npc_dark_sword_chief"
                        local jcDefaultPos = Vector3.new(16, 3, 12)
                        local jcNpcModel   = (Workspace:FindFirstChild("VillageNPCs") and Workspace.VillageNPCs:FindFirstChild(jcNpcId))
                                          or (Workspace:FindFirstChild("NPCs")        and Workspace.NPCs:FindFirstChild(jcNpcId))
                        local jcNpcPos     = jcNpcModel and (jcNpcModel.PrimaryPart and jcNpcModel.PrimaryPart.Position or jcNpcModel:GetPivot().Position) or jcDefaultPos
                        local jcDist       = (Vector3.new(currentPos.X, 0, currentPos.Z) - Vector3.new(jcNpcPos.X, 0, jcNpcPos.Z)).Magnitude

                        Combat.stopAutoAttack()
                        if jcDist > 8 then
                            if now - lastReportTime >= 5 then
                                lastReportTime = now
                                debugLog("JOB", "Approaching job NPC [%s] (distance: %.1fm)...", jcNpcId, jcDist)
                            end
                            Movement.walkTween(jcNpcPos, 80, 3.0)
                        else
                            Movement.stop()
                            if not _jobChangeNpcInteracted and (now - lastNpcInteractTime >= 3.0) then
                                lastNpcInteractTime     = now
                                _jobChangeNpcInteracted = true
                                debugLog("JOB", "Interacting with job NPC [%s]", jcNpcId)
                                if jcNpcModel then
                                    local prompt = jcNpcModel:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    if prompt and fireproximityprompt then
                                        pcall(function() fireproximityprompt(prompt) end)
                                    end
                                end
                                Net.event("ebe39b7"):FireServer({ npcId = jcNpcId, action = "talk" })
                                QuestManager.requestSync()
                                task.delay(4.0, function() _jobChangeNpcInteracted = false end)
                            end
                        end

                    elseif needReturnToElder then
                        local targetNpcId  = "village_elder"
                        local defaultNpcPos = Vector3.new(10, 3, -14)

                        local targetNpcModel = (Workspace:FindFirstChild("VillageNPCs") and Workspace.VillageNPCs:FindFirstChild(targetNpcId))
                                       or (Workspace:FindFirstChild("NPCs") and Workspace.NPCs:FindFirstChild(targetNpcId))

                        local targetNpcPos = targetNpcModel and (targetNpcModel.PrimaryPart and targetNpcModel.PrimaryPart.Position or targetNpcModel:GetPivot().Position) or defaultNpcPos
                        local flatNpcDist = (Vector3.new(currentPos.X, 0, currentPos.Z) - Vector3.new(targetNpcPos.X, 0, targetNpcPos.Z)).Magnitude

                        -- Nếu cách xa (> 250m) -> Tự sát về Làng.
                        if flatNpcDist > 250 then
                            debugLog("QUEST", "Distance to NPC: %.1fm > 250m -> Resetting to respawn at village", flatNpcDist)
                            Movement.stop()
                            resetCharacter()
                            waitForRespawn(4)
                            task.wait(1.0)
                        elseif flatNpcDist > 8 then
                            if now - lastReportTime >= 5 then
                                lastReportTime = now
                                debugLog("QUEST", "Approaching village NPC [%s] (distance: %.1fm)", targetNpcId, flatNpcDist)
                            end
                            Movement.walkTween(targetNpcPos, 34, 2.0)
                            Combat.stopAutoAttack()
                        else
                            Movement.stop()
                            if not isWaitingForQuestResponse and (now - lastNpcInteractTime >= 3.0) then
                                lastNpcInteractTime = now
                                isWaitingForQuestResponse = true
                                debugLog("QUEST", "Interacting with village NPC [%s]", targetNpcId)
                                if targetNpcModel then
                                    local prompt = targetNpcModel:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    if prompt and fireproximityprompt then
                                        pcall(function() fireproximityprompt(prompt) end)
                                    end
                                end
                                Net.event("ebe39b7"):FireServer({ npcId = targetNpcId, action = "talk" })
                                QuestManager.requestSync()

                                task.delay(3.0, function()
                                    isWaitingForQuestResponse = false
                                end)
                            end
                        end

                    else

                        -- 2. Tìm cụm quái ĐÔNG nhất trong Workspace (không đu quái lẻ, bán kính 450 studs)

                        local targetMob, clusterCenter, dist, clusterCount = TargetFinder.getClusterTarget(mobId, 450)

                        if targetMob then
                            KaitunBot.CurrentTarget = targetMob
                            local targetRoot = targetMob:FindFirstChild("HumanoidRootPart") or targetMob.PrimaryPart

                            if targetRoot then
                                local isLowHealth = false
                                if hum and hum.MaxHealth > 0 and (hum.Health / hum.MaxHealth) < 0.35 then
                                    isLowHealth = true
                                end

                                if isLowHealth then
                                    Combat.stopAutoAttack()
                                    if dist < 60 then
                                        -- Bỏ chạy ra xa quái để chờ hồi máu/potion (cự ly an toàn 60 studs)
                                        -- Caching vị trí chạy 1.5s để không update Tween mỗi frame (chống giật/lỏ)
                                        local timeSinceRun = now - (KaitunBot.lastRunPosTime or 0)
                                        if not KaitunBot.CurrentRunPos or timeSinceRun > 1.5 then
                                            local runDir = (currentPos - targetRoot.Position).Unit
                                            if runDir ~= runDir or runDir.Magnitude == 0 then
                                                runDir = Vector3.new(1, 0, 0)
                                            end
                                            local flatRunDir = Vector3.new(runDir.X, 0, runDir.Z).Unit
                                            -- Cộng dồn flatRunDir vào currentPos thay vì targetRoot để chạy lùi mượt
                                            local runPos = currentPos + flatRunDir * 60
                                            
                                            -- Bẻ lái: Ép bot không chạy văng khỏi bãi quái khi Kite
                                            local spawnCenter = MonsterSpawnCenters[mobId]
                                            if spawnCenter then
                                                local distToCenter = (Vector3.new(runPos.X, 0, runPos.Z) - Vector3.new(spawnCenter.X, 0, spawnCenter.Z)).Magnitude
                                                if distToCenter > 130 then
                                                    -- Nếu hướng chạy này làm bot lọt ra khỏi bãi, ép hướng chạy về thẳng Tâm Bãi
                                                    runPos = spawnCenter
                                                end
                                            end
                                            
                                            runPos = Vector3.new(runPos.X, currentPos.Y, runPos.Z)
                                            
                                            KaitunBot.CurrentRunPos = runPos
                                            KaitunBot.lastRunPosTime = now
                                        end
                                        
                                        -- Buff max speed = 42 để chạy nhanh hơn quái
                                        Movement.walkTween(KaitunBot.CurrentRunPos, 42, 1.0)
                                        
                                        if now - (KaitunBot.lastRunLog or 0) >= 3.0 then
                                            debugLog("COMBAT", "Low health (%.0f%%) -> Kiting to safe distance", (hum.Health/hum.MaxHealth)*100)
                                            KaitunBot.lastRunLog = now
                                        end
                                    else
                                        KaitunBot.CurrentRunPos = nil
                                        Movement.stop()
                                        if now - (KaitunBot.lastRunLog or 0) >= 3.0 then
                                            debugLog("COMBAT", "Safe distance reached (%.1fm), waiting for health recovery", dist)
                                            KaitunBot.lastRunLog = now
                                        end
                                    end
                                else
                                    KaitunBot.CurrentRunPos = nil
                                    -- Cụm quái đã tự quét lại MỖI lần lặp ở getClusterTarget
                                    local distToCluster = clusterCenter and (clusterCenter - currentPos).Magnitude or 0
                                    if distToCluster > 35 then
                                        -- Lướt thần tốc (42 studs/s) thẳng vào Tâm Cụm Quái Đông Nhất.
                                        -- KHÔNG bắn auto-attack khi còn xa tâm: faceTarget() ghi đè CFrame
                                        -- mỗi frame sẽ chiến đấu với tween → nhân vật kẹt không tiến được.
                                        Movement.walkTween(clusterCenter, 42, 3.0)
                                        Combat.stopAutoAttack()
                                    else
                                        -- Đã vào trong cụm quái: Vừa lướt tiếp cận vừa đánh + xả combo liên tục
                                        if dist <= 12 then
                                            Movement.stop()
                                        else
                                            Movement.walkTween(targetRoot.Position, 42, 2.0)
                                        end
                                        Combat.startAutoAttack(targetMob)
                                    end
                                end
                            end

                        else
                            -- Chưa có quái → đi về spawn center
                            local spawnCenter = MonsterSpawnCenters[mobId]
                            if spawnCenter then
                                local flatDist = Vector3.new(
                                    spawnCenter.X - currentPos.X, 0,
                                    spawnCenter.Z - currentPos.Z).Magnitude

                                if flatDist > 10 then
                                    Movement.walkTween(spawnCenter, 34, 5.0)
                                else
                                    Movement.stop()
                                    if now - lastWarnTime >= 10 then
                                        lastWarnTime = now
                                        debugLog("STATUS", "At spawn center for %s (distance: %.1fm), waiting for respawn", mobId, flatDist)
                                    end
                                end
                            else
                                debugLog("STATUS", "No spawn center found for mob: %s", mobId)
                            end
                            Combat.stopAutoAttack()
                        end
                    end


            end
            end
            task.wait(0.15)
        end

    end)


    
    -- Vòng lặp Mua Shop, Bán Đồ & Nâng cấp tự động (chạy nhẹ nhàng 25s/lần)
    task.spawn(function()
        while KaitunBot.Enabled do
            if EconomyUpgrade.AutoSell then pcall(EconomyUpgrade.autoSellLoot) end
            if EconomyUpgrade.AutoBuyWeapon then pcall(EconomyUpgrade.autoBuyAndEquipBestWeapon) end
            if EconomyUpgrade.AutoEnhance then pcall(EconomyUpgrade.enhanceEquippedWeapon) end
            task.wait(25)
        end
    end)



    -- Vòng lặp tự động click nút Accept / Turn In trên UI QuestDialogue Panel (Chính xác 100% từ log điều tra)
    task.spawn(function()
        while KaitunBot.Enabled do
            pcall(function()
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                if playerGui then
                    local questGui = playerGui:FindFirstChild("QuestDialogGui")
                    if questGui and questGui.Enabled then
                        local box = questGui:FindFirstChild("Box")
                        if box and box.Visible then
                            local actionBtn = box:FindFirstChild("ActionButton")
                            if actionBtn and actionBtn:IsA("GuiObject") and actionBtn.Visible then
                                -- Guard: không click Accept nếu vừa từ chối quest do vượt level
                                local btnText = tostring(actionBtn.Text)
                                if _lastQuestOfferRejected and (btnText == "Accept" or btnText == "Nhận") then
                                    -- Reset flag sau khi UI đóng lại (không click = tự đóng)
                                    return
                                end
                                _lastQuestOfferRejected = false
                                debugLog("QUEST", "Clicked dialogue action button: %s", btnText)
                                if type(firesignal) == "function" then
                                    pcall(function() if actionBtn.Activated then firesignal(actionBtn.Activated) end end)
                                    pcall(function() if actionBtn.MouseButton1Click then firesignal(actionBtn.MouseButton1Click) end end)
                                end
                            end
                        end
                    end
                end
            end)
            task.wait(1.0)
        end
    end)



    -- Kích hoạt AutoPotion loop (HP < 20%)
    AutoPotion.startLoop()
end

