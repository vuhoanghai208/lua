local lastEquippedWeapon = nil

local currentShopToken = nil
local currentQuestToken = nil  -- Token riêng cho Quest NPC (ebd9a45), tách biệt với Shop token

do
    local Net = require(ReplicatedStorage.Shared.Net)

    -- 1. Lắng nghe Shop payload chính thức từ Server (e14b5f0) để lấy token (tk) & cập nhật ownedWeapons
    Net.event("e14b5f0").OnClientEvent:Connect(function(payload)
        if type(payload) == "table" then
            if type(payload.tk) == "string" then
                currentShopToken = payload.tk
                debugLog("SHOP", "Shop session token received: %s", currentShopToken)
            end
            if type(payload.items) == "table" then
                local updated = false
                for k, item in pairs(payload.items) do
                    local itemId = type(item) == "table" and (item.itemId or k) or k
                    if type(item) == "table" and (item.owned == true or item.equipped == true) then
                        ownedWeapons[itemId] = true
                        updated = true
                        debugLog("SHOP", "Ownership synced: %s", tostring(itemId))
                    end
                end
            end
        end
    end)

    -- 2. Lắng nghe shop payload phụ từ Server (e3dbafe / ebd9a45)
    Net.event("e3dbafe").OnClientEvent:Connect(function(payload)
        if type(payload) == "table" and type(payload.tk) == "string" then
            currentShopToken = payload.tk
            debugLog("SHOP", "Shop token updated: %s", currentShopToken)
        end
    end)

    Net.event("ebd9a45").OnClientEvent:Connect(function(payload)
        if type(payload) ~= "table" then return end

        local npcId   = payload.npcId
        local questId = payload.questId
        local phase   = payload.phase
        local tk      = payload.tk or currentQuestToken

        if type(payload.tk) == "string" then
            currentQuestToken = payload.tk
            debugLog("QUEST", "Quest token updated: %s", currentQuestToken)
        end

        debugLog("QUEST", "Received ebd9a45: npcId=%s, questId=%s, phase=%s",
            tostring(npcId), tostring(questId), tostring(phase))

        local action = nil
        local playerLevel = tonumber(LocalPlayer:GetAttribute("Level")) or (NetBridge.PlayerData and tonumber(NetBridge.PlayerData.level)) or 1
        local questMinLvl = tonumber(payload.minLevel) or QuestMinLevels[questId] or 1

        if npcId == "npc_dark_sword_chief" then
            QuestManager.jobChangeCompleted = true
            debugLog("JOB", "Job change confirmed from npc_dark_sword_chief (phase=%s)", tostring(phase))
        end

        if phase == "offer" then
            if questId == "quest_favor_magicsword" and playerLevel < 60 then
                lastNoQuestTime = os.clock() + 3600
                debugLog("QUEST", "Rejected quest_favor_magicsword (level %d < 60)", playerLevel)
                action = nil
            else
                local maxGap = QuestManager.getMaxLevelGap(playerLevel, questMinLvl)
                if questMinLvl - playerLevel > maxGap then
                    QuestManager.rejectedMinLevel = questMinLvl
                    lastNoQuestTime = os.clock() + 3600
                    _lastQuestOfferRejected = true
                    debugLog("QUEST", "Rejected quest %s (minLevel=%d > maxGap for level %d)", tostring(questId), questMinLvl, playerLevel)
                    action = nil
                else
                    QuestManager.rejectedMinLevel = nil
                    _lastQuestOfferRejected = false
                    action = "accept"
                end
            end
        elseif phase == "job_offer" then
            action = "job_accept"
        elseif phase == "ready_to_turn_in" then
            action = "turnin"
        elseif phase == "none" or phase == "unavailable_level" then
            lastNoQuestTime = os.clock()
            debugLog("QUEST", "No eligible quest (phase=%s), 20s cooldown", tostring(phase))
        end

        if npcId and action and tk then
            task.spawn(function()
                task.wait(0.25)
                debugLog("QUEST", "Sent quest payload: npcId=%s, action=%s, questId=%s",
                    tostring(npcId), tostring(action), tostring(questId))
                
                Net.event("ebe39b7"):FireServer({
                    npcId   = npcId,
                    action  = action,
                    questId = questId,
                    tk      = tk
                })
                if action == "job_accept" then
                    pcall(function()
                        Net.event("e680f0e"):FireServer("magicsword")
                    end)
                end

                -- Đồng bộ DataSync sau 0.3s để Client cập nhật Quest mới
                task.wait(0.3)
                Net.event("e4a8bee"):FireServer()
            end)
        end
    end)






    -- 3. Lắng nghe phản hồi Toast / Thông báo từ Server (e24efa7)
    Net.event("e24efa7").OnClientEvent:Connect(function(payload)
        local code = type(payload) == "table" and payload.code or tostring(payload)
        local kind = type(payload) == "table" and payload.kind or "info"
        debugLog("SHOP", "Server message: code=%s, kind=%s", tostring(code), tostring(kind))

        if (code == "already_owned" or code == "buy_success") and EconomyUpgrade.currentBuyingItemId then
            ownedWeapons[EconomyUpgrade.currentBuyingItemId] = true
            debugLog("SHOP", "Ownership registered: %s", EconomyUpgrade.currentBuyingItemId)
        end

        if code == "too_far" then
            currentShopToken = nil
            if EconomyUpgrade.currentBuyingItemId then
                ownedWeapons[EconomyUpgrade.currentBuyingItemId] = nil
            end
            EconomyUpgrade.buyFailCooldownUntil = os.clock() + 60
            pcall(function() Net.event("e4a8bee"):FireServer() end)
            debugLog("SHOP", "Server returned too_far, resetting token and requesting sync")
        end
    end)
end




