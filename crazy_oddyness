local Net = require(ReplicatedStorage.Shared.Net)

local NetBridge = {
    PlayerData = {}
}

NetBridge.ACTION_MAP = {
    BASIC_ATTACK     = "e89c992", -- Event: Tấn công thường (FireServer)
    CAST_SKILL       = "e14ca84", -- Event: Sử dụng kỹ năng (FireServer - Number 1->4)
    ATTACK_FEEDBACK  = "e3f1983", -- Event: Phản hồi đòn đánh
    CLIENT_INIT      = "edb5518", -- Event: Khởi tạo Client
    DATA_SYNC        = "e48d3fd", -- Event: Đồng bộ dữ liệu nhân vật
    QUEST_UPDATE     = "e4a8bee", -- Event: Cập nhật / Nhận / Trả nhiệm vụ
    PORTAL_TELEPORT  = "e623186", -- Event: Cổng dịch chuyển
    MAP_WAYPOINT     = "e503498", -- Event: Waypoint
    SHOP_BUY         = "e3dbafe", -- Event: Mua shop NPC (e3dbafe)
    INVENTORY_EQUIP  = "e534d20", -- Event: Trang bị vũ khí (e534d20 - verified từ R1e9785b659a01da4)
    ITEM_ENHANCE     = "e61c8a7", -- Function: Cường hóa vũ khí
    RUNE_FUSE        = "e5c21ad", -- Function: Ghép Rune
    SETTINGS_PATCH   = "e4bd8e0", -- Function: Lưu cài đặt
    TRADE_ACTION     = "eb83c1d", -- Event: Trade
    TRADE_INVITE     = "ea25820"  -- Event: Mời trade
}


function NetBridge.getRemote(actionName, isFunction)
    local hashKey = NetBridge.ACTION_MAP[actionName] or actionName
    return isFunction and Net.func(hashKey) or Net.event(hashKey)
end

function NetBridge.fire(actionName, ...)
    local remote = NetBridge.getRemote(actionName, false)
    if remote then remote:FireServer(...) end
end

function NetBridge.invoke(actionName, ...)
    local remote = NetBridge.getRemote(actionName, true)
    if remote then return remote:InvokeServer(...) end
    return nil
end

function NetBridge.on(actionName, callback)
    local remote = NetBridge.getRemote(actionName, false)
    if remote then return remote.OnClientEvent:Connect(callback) end
    return nil
end

NetBridge.on("DATA_SYNC", function(payload)
    if type(payload) == "table" then
        for k, v in pairs(payload) do
            NetBridge.PlayerData[k] = v
        end
        debugLog("NET-SYNC", "Đã nhận DataSync: Level=%s, Gold=%s", tostring(NetBridge.PlayerData.level), tostring(NetBridge.PlayerData.gold))
    end
end)

