    { itemId = "fire_sword",    price = 100000, name = "Fire Sword" },
    { itemId = "diamond_sword", price = 53000,  name = "Diamond Blade" },
    { itemId = "shark_sword",   price = 27000,  name = "Shark Blade" },
    { itemId = "inferno",       price = 9200,   name = "Chronos Inferno" },
    { itemId = "light_sword",   price = 2900,   name = "Light Baton" },
    { itemId = "wooden_sword",  price = 1100,   name = "Wooden Sword" },
    { itemId = "bone",          price = 91,     name = "Bone" },
}

--- Kiểm tra kỹ lưỡng xem kiếm (itemId) đã có trong Hành trang / Nhân vật / Server payload chưa
local function hasWeaponInInventory(itemId)
    -- Check 1: Đã xác nhận từ Server payload hoặc cache sở hữu?
    if ownedWeapons[itemId] == true then
        return true
    end

    local equipToolName = EQUIP_TOOL_MAP[itemId] or itemId
    local lowerId       = string.lower(itemId)
    local lowerTool     = string.lower(equipToolName)

    local function matches(name)
        if not name then return false end
        local l = string.lower(name)
        return l == lowerId or l == lowerTool or string.find(l, lowerId, 1, true) ~= nil or string.find(l, lowerTool, 1, true) ~= nil
    end

    -- Check 2: Đang cầm trên tay (Character)
    local char = LocalPlayer.Character
    if char then
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") and matches(child.Name) then
                ownedWeapons[itemId] = true
                return true, child
            end
        end
    end

    -- Check 3: Trong túi đồ (Backpack)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, child in ipairs(bp:GetChildren()) do
            if child:IsA("Tool") and matches(child.Name) then
                ownedWeapons[itemId] = true
                return true, child
            end
        end
    end

    -- Check 4: Trong DataSync PlayerData.inventory từ Server
    if NetBridge.PlayerData and type(NetBridge.PlayerData.inventory) == "table" then
        for _, invItem in pairs(NetBridge.PlayerData.inventory) do
            local invId = type(invItem) == "table" and (invItem.itemId or invItem.id) or tostring(invItem)
            if matches(invId) then
                ownedWeapons[itemId] = true
                return true
            end
        end
    end

    return false, nil
end



local function findWeaponMerchantNPC()
    for _, folderName in ipairs({ "VillageNPCs", "NPCs" }) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, npc in ipairs(folder:GetChildren()) do
                local npcId = npc:GetAttribute("NpcId") or npc.Name
                if npcId == "npc_weapon_merchant" or string.find(string.lower(tostring(npcId)), "weapon") then
                    return npc
                end
            end
        end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name == "npc_weapon_merchant" or obj:GetAttribute("NpcId") == "npc_weapon_merchant") then
            return obj
        end
    end
    return nil
end

local function resetCharacter()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            hum.Health = 0
        else
            pcall(function() char:BreakJoints() end)
        end
    end
end

local function waitForRespawn(timeout)
    local start = os.clock()
    while os.clock() - start < (timeout or 5) do
        local char = LocalPlayer.Character
        if char then
            local hum  = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and root then
                return char, root
            end
        end
        task.wait(0.1)
    end
    local c = LocalPlayer.Character
    return c, c and c:FindFirstChild("HumanoidRootPart")
end

local function ensureShopToken()
    if currentShopToken then return currentShopToken end

    local Net      = require(ReplicatedStorage.Shared.Net)
    local npcModel = findWeaponMerchantNPC()

    if npcModel then
        local npcPos = npcModel:FindFirstChild("HumanoidRootPart") and npcModel.HumanoidRootPart.Position or npcModel:GetPivot().Position
        local targetPos = npcPos + Vector3.new(0, 2, 3)

        local char, rootPart = waitForRespawn(0.3)
        local dist           = rootPart and (rootPart.Position - targetPos).Magnitude or 9999

        -- 1. Nếu ở xa (>100 studs): Tự sát để respawn về Làng gần NPC
        if dist > 100 then
            debugLog("SHOP-TOKEN", "Đang ở bãi quái xa (%.1f studs) -> Tự sát (Health=0) để respawn về Làng...", dist)
            Movement.stop()
            resetCharacter()

            -- Chờ nhân vật sống lại tại Làng
            char, rootPart = waitForRespawn(5)
            task.wait(0.3)

            if rootPart then
                dist = (rootPart.Position - targetPos).Magnitude
                debugLog("SHOP-TOKEN", "Đã respawn về Làng (khoảng cách tới NPC còn %.1f studs).", dist)
            end
        end

        -- 2. Di chuyển từ Làng tới sát NPC Merchant (cách < 8 studs)
        if dist > 8 then
            debugLog("SHOP-TOKEN", "Đang di chuyển từ Làng tới NPC Merchant (cách %.1f studs)...", dist)
            Movement.walkTween(targetPos, 34, 5.0)

            local startTime = os.clock()
            while os.clock() - startTime < 5 do
                local curChar = LocalPlayer.Character
                local curRoot = curChar and curChar:FindFirstChild("HumanoidRootPart")
                if curRoot and (curRoot.Position - targetPos).Magnitude <= 8 then
                    rootPart = curRoot
                    break
                end
                task.wait(0.1)
            end
            Movement.stop()
        end

        -- 3. Kích hoạt ProximityPrompt liên tục trong 2 giây cho tới khi nhận Token e14b5f0
        local prompt = npcModel:FindFirstChildWhichIsA("ProximityPrompt", true)
        local promptStart = os.clock()

        while os.clock() - promptStart < 2.5 and not currentShopToken do
            if prompt and fireproximityprompt then
                fireproximityprompt(prompt)
            end
            Net.event("ebe39b7"):FireServer({ npcId = "npc_weapon_merchant", action = "shop" })
            task.wait(0.3)
        end

        if currentShopToken then
            debugLog("SHOP-TOKEN", ">>> ĐÃ LẤY TOKEN CHÍNH XÁC THÀNH CÔNG: %s <<<", currentShopToken)
        else
            debugLog("SHOP-WARN", "Cảnh báo: Không lấy được Token sau 2.5s thử lại.")
        end
    end

    return currentShopToken
end


function EconomyUpgrade.autoBuyAndEquipBestWeapon()
    if EconomyUpgrade.isBuyingWeapon then return end

    local Net  = require(ReplicatedStorage.Shared.Net)
    local gold = QuestManager.getGold()

    for _, w in ipairs(WEAPON_SHOP_LIST) do
        local hasIt = hasWeaponInInventory(w.itemId)

        -- TRƯỜNG HỢP A: Đã sở hữu kiếm này trong người (Backpack / Character / Server Payload)
        if hasIt then
            if lastEquippedWeapon ~= w.itemId then
                debugLog("SHOP-EQUIP", "Phát hiện ĐÃ SỞ HỮU kiếm [%s] -> Gửi lệnh đeo!", w.name)
                Net.event("e534d20"):FireServer(w.itemId)
                lastEquippedWeapon = w.itemId
            end
            break -- Đã sở hữu/đeo thanh kiếm xịn nhất có thể, dừng không duyệt tiếp kiếm yếu hơn
        end

        -- TRƯỜNG HỢP B: Chưa sở hữu & Đủ Gold mua
        if gold >= w.price then
            EconomyUpgrade.isBuyingWeapon = true -- Khóa vòng lặp farm chính để tập trung mua sắm
            EconomyUpgrade.currentBuyingItemId = w.itemId
            debugLog("SHOP-BUY", "Phát hiện đủ %d Gold -> Kích hoạt quy trình mua kiếm [%s]...", gold, w.name)


            -- 1. Đảm bảo có Shop Token hợp lệ (nếu chưa có -> tự tương tác NPC lấy Token)
            local token = ensureShopToken()
            if not token then
                debugLog("SHOP-WARN", "Không lấy được Shop Token -> Hoãn mua [%s], sẽ thử lại ở lượt sau.", w.name)
                EconomyUpgrade.isBuyingWeapon = false
                break
            end

            debugLog("SHOP-BUY", "Gửi lệnh mua: %s (%s) | tk=%s", w.name, w.itemId, token)

            -- 2. Gửi lệnh mua chính thức với token hợp lệ (e3dbafe)
            Net.event("e3dbafe"):FireServer({
                type   = "buy",
                shopId = "village_weapon",
                itemId = w.itemId,
                tk     = token
            })
            ownedWeapons[w.itemId] = true -- Đánh dấu ĐÃ SỞ HỮU ngay lập tức để không bao giờ mua lại

            -- 3. Gửi lệnh trang bị (e534d20)

            task.wait(0.2)
            debugLog("SHOP-EQUIP", "Gửi lệnh trang bị sau khi mua: %s (%s)", w.name, w.itemId)
            Net.event("e534d20"):FireServer(w.itemId)
            lastEquippedWeapon = w.itemId

            -- 4. Tự sát (Health=0) để respawn quay lại bãi farm siêu tốc
            debugLog("SHOP-RESPAWN", "Đã mua và trang bị [%s] -> Tự sát (Health=0) để respawn quay lại farm!", w.name)
            Movement.stop()
            resetCharacter()
            waitForRespawn(4)

            EconomyUpgrade.isBuyingWeapon = false -- Mở lại vòng lặp farm chính
            break -- Chỉ mua 1 thanh kiếm mạnh nhất vừa đủ tiền trong lượt này
        end
    end
end


function EconomyUpgrade.buyShopItem(itemId)

    local Net = require(ReplicatedStorage.Shared.Net)
    Net.event("e3dbafe"):FireServer({
        type   = "buy",
        shopId = "village_weapon",
        itemId = itemId
    })
end

function EconomyUpgrade.enhanceEquippedWeapon()
    -- BUG1 FIX: count=0 trước đây → server từ chối vì không có nguyên liệu.
    -- count=1: dùng 1 nguyên liệu tăng cường cơ bản; boost=0: không dùng scroll thêm.
    return NetBridge.invoke("ITEM_ENHANCE", {
        action = "try",
        slot = "weapon",
        boost = 0,
        count = 1,
        useProtect = false
    })
end

function EconomyUpgrade.fuseRunes(runeItemId)
    if not runeItemId then return nil end
    return NetBridge.invoke("RUNE_FUSE", {
        itemId = runeItemId
    })
end

function EconomyUpgrade.autoSellLoot()
    if not NetBridge.PlayerData or type(NetBridge.PlayerData.inventory) ~= "table" then return end

    local ItemDefs = pcall(function() return require(ReplicatedStorage.Shared.Defs.ItemDefs) end) and require(ReplicatedStorage.Shared.Defs.ItemDefs) or {}
    local Net      = require(ReplicatedStorage.Shared.Net)

    for _, invItem in pairs(NetBridge.PlayerData.inventory) do
        local itemId = type(invItem) == "table" and (invItem.itemId or invItem.id) or tostring(invItem)
        local qty    = type(invItem) == "table" and tonumber(invItem.qty or invItem.count or 1) or 1

        if itemId and qty and qty > 0 then
            local def = ItemDefs[itemId]
            -- Tự động bán nguyên liệu quái rớt (Loot / Material)
            if def and (def.category == "material" or def.inventorySection == "other") then
                debugLog("SHOP-SELL", "Tự động bán rác/nguyên liệu [%s] (Số lượng: %d)...", itemId, qty)
                Net.event("ec134ea"):FireServer({
                    type   = "sell",
                    itemId = itemId,
                    qty    = qty
                })
                task.wait(0.2)
            end
        end
    end
end


-- ==========================================================================
-- MAIN KAITUN BOT LOADER WITH SMOOTH WALK TWEEN MOVEMENT
-- ==========================================================================
local KaitunBot = {
    Enabled = false,
    CurrentTarget = nil
}

function KaitunBot.start()
    if KaitunBot.Enabled then return end
    KaitunBot.Enabled = true
    
    debugLog("BOT", "Đã khởi chạy Kaitun Auto Farm All-In-One (Smooth Walk Tween Active)!")
    
    IntroHandler.checkAll()
    NetBridge.fire("CLIENT_INIT")
    QuestManager.requestSync()
    
    -- Vòng lặp kiểm tra tự động Bỏ Màn Join Game & Đặt Tên Acc Mới
    task.spawn(function()
        while KaitunBot.Enabled do
            IntroHandler.checkAll()
            task.wait(1.5)
        end
    end)
    
    task.spawn(function()
        local lastReportTime     = 0
        local lastWarnTime       = 0   -- throttle log "Chờ quái respawn" (1 lần/10s)
        local lastNpcInteractTime= 0
        local isWaitingForQuestResponse = false
        -- Stuck detection

        local lastStuckCheck     = 0
        local lastStuckPos       = nil
        local stuckCount         = 0
        local waterStuckStart    = nil
        local STUCK_TIMEOUT      = 4    -- 4 giây không di chuyển được → kẹt cây/địa hình
        local STUCK_THRESHOLD    = 4    -- studs tối thiểu phải di chuyển trong STUCK_TIMEOUT

        while KaitunBot.Enabled do
            if EconomyUpgrade.isBuyingWeapon then
                task.wait(0.5)
            else
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    -- Luôn duy trì CanCollide=false trong lúc bot chạy để lướt xuyên thân cây
                    setCharacterCanCollide(character, false)

                    local rootPart   = character:FindFirstChild("HumanoidRootPart")
                    local currentPos = rootPart.Position

                    -- 1. Xác định Quái mục tiêu (Ưu tiên theo Quest)
                    local mobId, questProgressInfo, hasSkippedQuest = QuestManager.getActiveQuestTargetMob()
                    local now = os.clock()

                    -- Water / Swimming escape detection: nếu nhân vật rơi xuống sông/hồ nước (>3.5s) -> Tự sát respawn về Làng thoát kẹt
                    local hum = character:FindFirstChildOfClass("Humanoid")
                    if hum then
                        local state = hum:GetState()
                        if state == Enum.HumanoidStateType.Swimming or hum.FloorMaterial == Enum.Material.Water then
                            if not waterStuckStart then
                                waterStuckStart = now
                            elseif now - waterStuckStart >= 3.5 then
                                debugLog("BOT-WARN", "Nhân vật rơi xuống sông/hồ nước (>3.5s) -> Tự sát (Health=0) để respawn lên mặt đất Làng!")
                                waterStuckStart = nil
                                Movement.stop()
                                resetCharacter()
                                waitForRespawn(4)
                            end
                        else
                            waterStuckStart = nil
                        end
                    end

                    -- Stuck detection: mỗi 4 giây kiểm tra nếu bị vướng thân cây / địa hình
                    if now - lastStuckCheck >= STUCK_TIMEOUT then
                        if lastStuckPos then
                            local moved = (currentPos - lastStuckPos).Magnitude
                            if moved < STUCK_THRESHOLD then
                                stuckCount = stuckCount + 1
                                local hum = character:FindFirstChildOfClass("Humanoid")

                                -- THOÁT KẸT TRÊN CÀNH CÂY / KHUNG CAO: Nếu Y > 35 hoặc kẹt liên tiếp >= 2 lần (8s)
                                if currentPos.Y > 35 or stuckCount >= 2 then
                                    debugLog("BOT-WARN", "PHÁT HIỆN KẸT TRÊN CÀNH CÂY (Y=%.1f, Count=%d) -> Ép CFrame rơi xuống mặt đất thoát kẹt!", currentPos.Y, stuckCount)
                                    Movement.stop()
                                    setCharacterCanCollide(character, false)
                                    
                                    -- Ép CFrame thả rơi về độ cao mặt đất an toàn (Y ~ 22 studs hoặc targetPos.Y)
                                    local dropY = (currentTargetPos and currentTargetPos.Y < 32) and (currentTargetPos.Y + 2.5) or 22
                                    rootPart.CFrame = CFrame.new(currentPos.X, dropY, currentPos.Z)
                                    stuckCount = 0
                                else
                                    if hum then
                                        Movement.stop()
                                        setCharacterCanCollide(character, false)
                                        NetBridge.fire("BASIC_ATTACK") -- Chém chặt cây vướng đường
                                        hum:ChangeState(Enum.HumanoidStateType.Jumping)
                                    end
                                    debugLog("BOT-WARN", "STUCK %.1f studs/%ds -> Chém chặt cây vướng đường & Nhảy thoát kẹt!", moved, STUCK_TIMEOUT)
                                end
                            else
                                stuckCount = 0
                            end
                        end
                        lastStuckPos   = currentPos
                        lastStuckCheck = now
                    end

                    -- Status log mỗi 5 giây
                    if now - lastReportTime >= 5 then
                        lastReportTime = now
                        local posStr = string.format("(%.0f,%.0f,%.0f)", currentPos.X, currentPos.Y, currentPos.Z)
                        if questProgressInfo then
                            debugLog("BOT-STATUS", "Quest: %s | Mob: %s (%d/%d) | Gold: %d | Pos: %s",
                                tostring(questProgressInfo.questId), mobId,
                                questProgressInfo.current, questProgressInfo.required,
                                QuestManager.getGold(), posStr)
                        else
                            debugLog("BOT-STATUS", "Farm by Level: %s | Gold: %d | Pos: %s", mobId, QuestManager.getGold(), posStr)
                        end
                    end

                    -- TỰ ĐỘNG CHẠY VỀ VILLAGE ELDER:
                    -- Case A: Quest đã hoàn thành sẵn sàng trả (readyToTurnIn == true)
                    -- Case B: Chưa có Quest active (questProgressInfo == nil), KHÔNG bị hoãn quest (hasSkippedQuest == false) VÀ không nằm trong thời gian chờ (noQuestAvailable == false)
                    local noQuestAvailable = (os.clock() - (lastNoQuestTime or 0) < 20)
                    local hasActiveQuest   = (questProgressInfo ~= nil)
                    local readyToTurnIn    = (questProgressInfo and questProgressInfo.readyToTurnIn == true)

                    local needReturnToElder = readyToTurnIn or (not hasActiveQuest and not hasSkippedQuest and not noQuestAvailable)


                    if needReturnToElder then
                        local VILLAGE_ELDER_POS = Vector3.new(10, 3, -14)
                        local elderNpc = (Workspace:FindFirstChild("VillageNPCs") and Workspace.VillageNPCs:FindFirstChild("village_elder"))
                                      or (Workspace:FindFirstChild("NPCs") and Workspace.NPCs:FindFirstChild("village_elder"))

                        local elderPos = elderNpc and (elderNpc.PrimaryPart and elderNpc.PrimaryPart.Position or elderNpc:GetPivot().Position) or VILLAGE_ELDER_POS
                        local flatElderDist = (Vector3.new(currentPos.X, 0, currentPos.Z) - Vector3.new(elderPos.X, 0, elderPos.Z)).Magnitude

                        -- Nếu cách cực xa bãi quái (> 250m) -> Mới tự sát respawn về Làng. Nếu đã ở trong Làng (Cách < 250m) -> Đi bộ bình thường
                        if flatElderDist > 250 then
                            local reason = (questProgressInfo and questProgressInfo.readyToTurnIn) and "TRẢ QUEST" or "NHẬN QUEST"
                            debugLog("QUEST-AUTO", "Đang ở bãi quái cực xa (Cách %.1fm) -> Tự sát (Health=0) để respawn về Làng %s!", flatElderDist, reason)
                            Movement.stop()
                            resetCharacter()
                            waitForRespawn(4)
                            task.wait(1.0)
                        elseif flatElderDist > 8 then
                            if now - lastReportTime >= 5 then
                                lastReportTime = now
                                debugLog("QUEST-AUTO", "Đã ở trong Làng -> Di chuyển tới Trưởng Làng (Cách %.1fm)...", flatElderDist)
                            end
                            Movement.walkTween(elderPos, 34, 2.0)
                            Combat.stopAutoAttack()
                        else
                            Movement.stop()
                            if not isWaitingForQuestResponse and (now - lastNpcInteractTime >= 3.0) then
                                lastNpcInteractTime = now
                                isWaitingForQuestResponse = true
                                local actName = (questProgressInfo and questProgressInfo.readyToTurnIn) and "TRẢ QUEST HOÀN THÀNH" or "NHẬN QUEST MỚI"
                                debugLog("QUEST-AUTO", ">>> Đã đứng sát Trưởng Làng (%.1fm) -> Tự động gửi lệnh tương tác %s! <<<", flatElderDist, actName)
                                if elderNpc then
                                    local prompt = elderNpc:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    if prompt and fireproximityprompt then
                                        pcall(function() fireproximityprompt(prompt) end)
                                    end
                                end
                                Net.event("ebe39b7"):FireServer({ npcId = "village_elder", action = "talk" })
                                QuestManager.requestSync()

                                task.delay(3.0, function()
                                    isWaitingForQuestResponse = false
                                end)
                            end

                        end
                    else

                        -- 2. Tìm quái gần nhất trong Workspace (Giới hạn bán kính local 450 studs)
                        local targetMob, dist = TargetFinder.getNearestMonster(mobId, 450)

                        if targetMob then
                            KaitunBot.CurrentTarget = targetMob
                            local targetRoot = targetMob:FindFirstChild("HumanoidRootPart") or targetMob.PrimaryPart

                            if targetRoot then
                                if dist > 6 then
                                    Movement.walkTween(targetRoot.Position, 34, 3.0)
                                    if dist <= 25 then
                                        Combat.faceTarget(targetMob)
                                        for slot = 1, 4 do Combat.castSkill(slot) end
                                    else
                                        Combat.stopAutoAttack()
                                    end
                                else
                                    Movement.stop()
                                    Combat.startAutoAttack(targetMob)
                                end
                            end

                        else
                            -- Chưa có quái → đi về spawn center
                            local spawnCenter = MonsterSpawnCenters[mobId]
                            if spawnCenter then
                                local flatDist = Vector3.new(
                                    spawnCenter.X - currentPos.X, 0,
                                    spawnCenter.Z - currentPos.Z).Magnitude

                                if flatDist > 10 then
                                    Movement.walkTween(spawnCenter, 34, 5.0)
                                else
                                    Movement.stop()
                                    if now - lastWarnTime >= 10 then
                                        lastWarnTime = now
                                        debugLog("BOT-WARN",
                                            "Đã ở bãi %s (flatDist=%.1f). Chờ quái respawn...",
                                            mobId, flatDist)
                                    end
                                end
                            else
                                debugLog("BOT-WARN", "Không có SpawnCenter cho mob '%s'.", mobId)
                            end
                            Combat.stopAutoAttack()
                        end
                    end


            end
            end
            task.wait(0.15)
        end

    end)


    
    -- Vòng lặp Mua Shop, Bán Đồ & Nâng cấp tự động (chạy nhẹ nhàng 25s/lần)
    task.spawn(function()
        while KaitunBot.Enabled do
            pcall(EconomyUpgrade.autoSellLoot)
            pcall(EconomyUpgrade.autoBuyAndEquipBestWeapon)
            pcall(EconomyUpgrade.enhanceEquippedWeapon)
            task.wait(25)
        end
    end)



    -- Vòng lặp tự động click nút Accept / Turn In trên UI QuestDialogue Panel (Chính xác 100% từ log điều tra)
    task.spawn(function()
        while KaitunBot.Enabled do
            pcall(function()
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                if playerGui then
                    local questGui = playerGui:FindFirstChild("QuestDialogGui")
                    if questGui and questGui.Enabled then
                        local box = questGui:FindFirstChild("Box")
                        if box and box.Visible then
                            local actionBtn = box:FindFirstChild("ActionButton")
                            if actionBtn and actionBtn:IsA("GuiObject") and actionBtn.Visible then
                                debugLog("QUEST-UI", ">>> Click Nhận/Trả Quest trên UI: QuestDialogGui.Box.ActionButton (Text='%s') <<<", tostring(actionBtn.Text))
                                if firesignal then
                                    pcall(function() firesignal(actionBtn.Activated) end)
                                    pcall(function() firesignal(actionBtn.MouseButton1Click) end)
                                end
                            end
                        end
                    end
                end
            end)
            task.wait(1.0)
        end
    end)



    -- Kích hoạt AutoPotion loop (HP < 20%)
    AutoPotion.startLoop()
end

