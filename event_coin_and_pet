local lastHatchAttemptTime = 0
function EventP2.IsEconomyMaxed()
    local isMaxed = true
    pcall(function()
        local SaveModule = require(Client:WaitForChild("Save"))
        local save = SaveModule and SaveModule.Get()
        local saveUpgrades = save and save.EventUpgrades or {}
        
        local maxLevels = {
            ["GardenBetterEggs"] = 11,
            ["GardenMoreCoins"] = 20,
            ["GardenMoreDamage"] = 20,
            ["GardenFasterAttacks"] = 20,
            ["GardenFasterCrops"] = 20,
            ["GardenBiggerHarvest"] = 20,
            ["GardenMoreSeeds"] = 20,
            ["GardenBetterLuck"] = 20
        }
        
        for upId, targetMaxLvl in pairs(maxLevels) do
            local currentLevel = tonumber(saveUpgrades[upId]) or 0
            if currentLevel < targetMaxLvl then
                isMaxed = false
                return
            end
        end
        
        local tdLocal = ClientTowerDefense and ClientTowerDefense.GetLocal and ClientTowerDefense.GetLocal()
        if tdLocal and ClientTower then
            local activeTowers = ClientTower.All(tdLocal) or {}
            for _, tower in ipairs(activeTowers) do
                if tower and not tower.Destroyed then
                    local currentLvl = (tower.GetUpgrade and tower:GetUpgrade()) or (tower.State and tower.State.Upgrade and tower.State.Upgrade.Get and tower.State.Upgrade:Get()) or 1
                    local item = tower.GetItem and tower:GetItem()
                    local maxLvl = item and item.GetMaxUpgrade and item:GetMaxUpgrade() or 10
                    if currentLvl < maxLvl then
                        isMaxed = false
                        return
                    end
                end
            end
        end
    end)
    return isMaxed
end

