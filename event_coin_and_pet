local function parseAssetId(icon)
    if not icon then return "" end
    return tostring(icon):match("%d+") or ""
end

function EventP2.SendDiscordWebhook(arg1, arg2, arg3, arg4, arg5)
    if not Config.WebhookURL or Config.WebhookURL == "" or Config.WebhookURL:find("PASTE_YOUR_WEBHOOK") then
        debugLog("[WEBHOOK] Webhook URL not configured.")
        return
    end

    local httpReq = (syn and syn.request) or (http and http.request) or http_request or request or httpRequest
    if not httpReq then
        warn("⚠️ [WEBHOOK ERROR] Executor does not support HTTP requests!")
        return
    end

    local itemName, itemCategory, assetId, extraDetails
    if arg5 ~= nil then
        itemName = arg2
        itemCategory = arg3
        assetId = arg4
        extraDetails = arg5
    else
        itemName = arg1
        itemCategory = arg2
        assetId = arg3
        extraDetails = arg4
    end

    local cleanAssetId = parseAssetId(assetId)
    local iconUrl = cleanAssetId ~= "" 
        and ("https://biggamesapi.io/image/" .. cleanAssetId) 
        or "https://biggamesapi.io/image/110514491848115"

    local isSpecial = tostring(itemName):find("Huge") or tostring(itemName):find("Titanic") or tostring(itemName):find("Gargantuan") or tostring(itemName):find("Mythic") or tostring(itemName):find("Ultimate")
    local embedColor = isSpecial and 0xFFD700 or 0x00FF88

    local embed = {
        title = string.format("📦 %s", tostring(itemName)),
        color = embedColor,
        fields = {
            { name = "👤 Player", value = "`" .. (LocalPlayer and LocalPlayer.Name or "Player") .. "`", inline = true },
            { name = "📂 Category", value = "`" .. tostring(itemCategory) .. "`", inline = true }
        },
        thumbnail = { url = iconUrl },
        footer = {
            text = "Pet Simulator 99 • Event Part 2 Notifier"
        },
        timestamp = DateTime.now():ToIsoDate()
    }
    
    if extraDetails and extraDetails ~= "" then
        embed.fields[#embed.fields + 1] = { name = "📊 Details", value = extraDetails, inline = false }
    end
    
    embed.fields[#embed.fields + 1] = { name = "🕒 Time", value = "<t:" .. os.time() .. ":R>", inline = true }

    local HttpService = game:GetService("HttpService")
    local payloadTable = {
        username = "PS99 Event Notifier 🤖",
        avatar_url = "https://biggamesapi.io/image/110514491848115",
        embeds = { embed }
    }

    if Config.DiscordTagID and tostring(Config.DiscordTagID) ~= "" and isSpecial then
        payloadTable.content = "<@" .. tostring(Config.DiscordTagID) .. ">"
    end

    local bodyData = HttpService:JSONEncode(payloadTable)

    task.spawn(function()
        local ok, res = pcall(httpReq, {
            Url = Config.WebhookURL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = bodyData
        })

        if ok and res then
            local code = res.StatusCode or res.Status or 0
            if code == 200 or code == 204 then
                debugLog("[WEBHOOK SUCCESS] Sent notification to Discord for item:", tostring(itemName))
            else
                warn(string.format("[WEBHOOK ERROR] Status Code: %s | Response: %s", tostring(code), tostring(res.Body or "")))
            end
        else
            warn("[WEBHOOK ERROR] HTTP Request failed:", tostring(res))
        end
    end)
end

