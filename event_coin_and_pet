-- HELPER TÍNH SỨC MẠNH DPS CHUẨN CỦA UNIT DỰA TRÊN ROSTER CHUẨN + LEVEL + VARIANTS (HUGE / TITANIC / SHINY / RAINBOW)
local function getUnitPower(id, lvl, itemData)
    if not id then return 1 end
    lvl = lvl or 1
    
    local strId = tostring(id)
    local isHuge = strId:find("Huge") or (itemData and type(itemData) == "table" and itemData.id and tostring(itemData.id):find("Huge"))
    local isTitanic = strId:find("Titanic") or (itemData and type(itemData) == "table" and itemData.id and tostring(itemData.id):find("Titanic"))
    local isShiny = strId:find("Shiny") or (itemData and type(itemData) == "table" and itemData.sh)
    local isRainbow = strId:find("Rainbow") or (itemData and type(itemData) == "table" and itemData.pt == 2)
    local isGolden = strId:find("Golden") or (itemData and type(itemData) == "table" and itemData.pt == 1)
    
    local rank = ROSTER_POWER[id]
    if not rank then
        for rName, rRank in pairs(ROSTER_POWER) do
            if strId:find(rName) then
                rank = rRank
                break
            end
        end
    end
    
    rank = rank or 1
    
    if isTitanic then
        rank = rank + 100
    elseif isHuge then
        rank = rank + 50
    end
    
    if isShiny then rank = rank + 5 end
    if isRainbow then rank = rank + 3 end
    if isGolden then rank = rank + 2 end
    
    return (rank * 10000) + (lvl * 10)
end

-- HELPER LẤY CHÍNH XÁC DANH SÁCH DEFENDER UNITS TỪ SAVE.GET().INVENTORY.TOWER (HỖ TRỢ STACK SỐ LƯỢNG _am x218)
local function getInventoryTowers()
    local inventoryTowers = {}
    local saveData = Save.Get and Save.Get()
    local inv = saveData and saveData.Inventory
    
    if inv and inv.Tower then
        -- 1. Đếm số lượng từng UID đang đứng thi đấu trên sân
        local activeCountsByUID = {}
        local tdLocal = ClientTowerDefense and ClientTowerDefense.GetLocal and ClientTowerDefense.GetLocal()
        local activeTowers = (tdLocal and ClientTower and ClientTower.All(tdLocal)) or {}
        
        for _, active in ipairs(activeTowers) do
            if active and not active.Destroyed then
                local item = active:GetItem()
                local u = item and (item.GetUID and item:GetUID() or item._uid or item.uid)
                if u then
                    local uStr = tostring(u)
                    activeCountsByUID[uStr] = (activeCountsByUID[uStr] or 0) + 1
                end
            end
        end
        
        -- 2. Duyệt qua từng item trong Save.Get().Inventory.Tower và tính toán số lượng chưa đặt (_am - activeCount)
        for uid, itemData in pairs(inv.Tower) do
            if type(itemData) == "table" then
                local unitId = itemData.id or itemData._id or "Unknown"
                local unitLvl = itemData.sh or itemData.level or itemData.lvl or 1
                local stackAmt = itemData._am or itemData.am or itemData.amount or itemData._cnt or 1
                local pwr = getUnitPower(unitId, unitLvl, itemData)
                local uStr = tostring(uid)
                
                local placedAmt = activeCountsByUID[uStr] or 0
                local unplacedAmt = math.max(0, stackAmt - placedAmt)
                
                for i = 1, unplacedAmt do
                    table.insert(inventoryTowers, {
                        uid = uStr,
                        id = unitId,
                        lvl = unitLvl,
                        data = itemData,
                        power = pwr
                    })
                end
            end
        end
    end
    
    return inventoryTowers
end

-- HELPER QUÉT TOÀN BỘ CÁC Ô TRỐNG TRÊN LANES VÀ TÍNH CHÍNH XÁC RELATIVE CFRAME
local function getAvailableLaneSlots()
    local freeSlots = {}
    local localPlot = ClientPlot and ClientPlot.GetLocal and ClientPlot.GetLocal("Garden")
    local plotModel = localPlot and localPlot:GetModel()
    local tdLocal = ClientTowerDefense and ClientTowerDefense.GetLocal and ClientTowerDefense.GetLocal()
    
    if not plotModel or not tdLocal then return freeSlots, tdLocal end
    
    local lanesFolder = plotModel:FindFirstChild("Lanes")
    if not lanesFolder then return freeSlots, tdLocal end
    
    local activeTowers = ClientTower.All(tdLocal) or {}
    local unlockedLanes = localPlot:Save("PvC_UnlockedLanes") or 7
    
    for _, lane in ipairs(lanesFolder:GetChildren()) do
        local laneNum = tonumber(lane.Name)
        if laneNum and laneNum <= unlockedLanes then
            local slotsFolder = lane:FindFirstChild("Slots")
            if slotsFolder then
                for _, slotPart in ipairs(slotsFolder:GetChildren()) do
                    if slotPart:IsA("BasePart") then
                        local isOccupied = false
                        for _, tower in ipairs(activeTowers) do
                            if tower and not tower.Destroyed then
                                local towerCF = (tower.GetCFrame and tower:GetCFrame()) or (tower.Model and tower.Model.GetPivot and tower.Model:GetPivot())
                                local pos = towerCF and towerCF.Position
                                if pos and (Vector2.new(pos.X, pos.Z) - Vector2.new(slotPart.Position.X, slotPart.Position.Z)).Magnitude < 2.5 then
                                    isOccupied = true
                                    break
                                end
                            end
                        end
                        if not isOccupied then
                            table.insert(freeSlots, slotPart)
                        end
                    end
                end
            end
        end
    end
    
    return freeSlots, tdLocal
end

