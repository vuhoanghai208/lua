-- --------------------------------------------------------------------------
-- MODULE 7: AUTO EVENT LUCK BOOST (GardenChanceMachine_AddTime - HUGE/TITANIC/GARGANTUAN)
-- --------------------------------------------------------------------------
function EventP2.ManageEventBoosts()
    if not Config.AutoEventBoost then return end
    
    local suns = getSunflowers()
    if suns <= 0 then return end
    
    local boostMaxTokens = { Huge = 1667, Titanic = 5000, Gargantuan = 10000 }
    local boostTypes = { "Huge", "Titanic", "Gargantuan" }
    local maxBoostSeconds = 21600 -- Mốc MAX thời gian 6 tiếng (21,600 giây)
    
    local saveData = Save.Get and Save.Get()
    local tracks = saveData and saveData.GardenChanceMachineTracks or {}
    local nowServer = workspace:GetServerTimeNow()
    
    for _, boostName in ipairs(boostTypes) do
        pcall(function()
            local totalTokensForMax = boostMaxTokens[boostName] or 5000
            local perTokenSec = maxBoostSeconds / totalTokensForMax
            
            local expireTime = tracks[boostName] or 0
            local currentBoostSeconds = (expireTime > nowServer) and (expireTime - nowServer) or 0
            
            local secondsNeeded = maxBoostSeconds - currentBoostSeconds
            
            if secondsNeeded > 10 then
                local tokensNeeded = math.ceil(secondsNeeded / perTokenSec)
                local amountToSpend = math.min(tokensNeeded, suns)
                
                if amountToSpend > 0 then
                    local bSuccess, bResult = Network.Invoke("GardenChanceMachine_AddTime", boostName, "Slot1", amountToSpend)
                    if bSuccess and bResult then
                        debugLog(string.format("[EVENT BOOST] Maxed [%s Luck] (+%s Sunflowers) -> Boost set to 6 Hours!", boostName, formatNumber(amountToSpend)))
                    else
                        local halfAmt = math.floor(amountToSpend / 2)
                        if halfAmt > 0 then
                            pcall(function()
                                Network.Invoke("GardenChanceMachine_AddTime", boostName, "Slot1", halfAmt)
                            end)
                        end
                    end
                end
            end
        end)
        task.wait(0.05)
    end
end

