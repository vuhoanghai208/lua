-- --------------------------------------------------------------------------
-- MODULE 9.5: AUTO GARDEN FUSE MACHINE (INDEPENDENT 5-MINUTE DEDICATED THREAD)
-- --------------------------------------------------------------------------
function EventP2.AutoFusePets()
    if not Config.AutoFusePets then return end
    
    debugLog("[GARDEN FUSE] 5-Minute Dedicated Thread Check: Scanning inventory for Fuse target & fodder units...")
    
    pcall(function()
        local Save = require(Client:WaitForChild("Save"))
        local TowerLevelingUtil = require(ReplicatedStorage.Library.Util.TowerLevelingUtil)
        local save = Save and Save.Get()
        
        if not save or not save.Inventory or not save.Inventory.Tower then
            debugLog("[GARDEN FUSE SKIP] Inventory.Tower data is empty")
            return
        end
        
        local maxXP = TowerLevelingUtil.MaximumXP or 1000000
        
        -- 1. BƯỚC 1: XÁC ĐỊNH BẢNG RANK CỦA TẤT CẢ PET HIỆN CÓ TRONG TÚI
        local rankSet = {}
        for uid, unitData in pairs(save.Inventory.Tower) do
            if type(unitData) == "table" and unitData.id then
                local unitId = tostring(unitData.id)
                local baseRank = ROSTER_POWER[unitId]
                if not baseRank then
                    for rName, rRank in pairs(ROSTER_POWER) do
                        if unitId:find(rName) then baseRank = rRank; break end
                    end
                end
                baseRank = baseRank or 1
                rankSet[baseRank] = true
            end
        end
        
        local activeRanks = {}
        for r in pairs(rankSet) do table.insert(activeRanks, r) end
        table.sort(activeRanks, function(a, b) return a > b end) -- Xếp Rank từ Cao -> Thấp
        
        -- Giữ lại Top 1 và Top 2 Bậc Pet cao nhất hiện có (BẢO VỆ 100%, KHÔNG BAO GIỜ THIÊU HỦY)
        local protectedRanks = {}
        for i = 1, math.min(2, #activeRanks) do
            protectedRanks[activeRanks[i]] = true
        end
        
        -- 2. BƯỚC 2: PHÂN LOẠI TARGET (PET TOP 1/TOP 2 CẦN BƠM XP) VÀ FODDER (PET TỪ TOP 3 TRỞ ĐI ĐỂ FUSE)
        local targetUnits = {}
        local fodderUnits = {}
        
        for uid, unitData in pairs(save.Inventory.Tower) do
            if type(unitData) == "table" and unitData.id then
                local unitId = tostring(unitData.id)
                local count = unitData._am or 1
                local uq = unitData._uq or (unitData._data and unitData._data._uq)
                local xp = tonumber((uq and (uq.xp or uq.XP)) or unitData.xp or unitData.XP or 0) or 0
                local isLocked = unitData._lk or unitData._l
                
                local baseRank = ROSTER_POWER[unitId]
                if not baseRank then
                    for rName, rRank in pairs(ROSTER_POWER) do
                        if unitId:find(rName) then baseRank = rRank; break end
                    end
                end
                baseRank = baseRank or 1
                
                local isHugeOrTitanic = unitId:find("Huge") or unitId:find("Titanic") or unitId:find("Gargantuan")
                local isProtected = protectedRanks[baseRank] or isHugeOrTitanic
                
                -- Pet Top 1/Top 2 chưa max XP sẽ làm Target nhận XP
                if isProtected and xp < maxXP then
                    table.insert(targetUnits, { uid = uid, id = unitId, xp = xp, rank = baseRank })
                end
                
                -- Pet từ Top 3 trở đi (không thuộc protectedRanks, không locked, không Huge) sẽ làm Fodder
                if not isLocked and not isProtected then
                    table.insert(fodderUnits, { uid = uid, id = unitId, count = count, rank = baseRank })
                end
            end
        end
        
        -- ƯU TIÊN TARGET:
        -- 1. Ưu tiên Pet Bậc cao hơn (Top 1 > Top 2)
        -- 2. Với các con cùng Bậc Top 1 (cùng tên), ƯU TIÊN CON CÓ XP/LEVEL CAO NHẤT TRƯỚC để nhanh Max Level DPS cực đại!
        table.sort(targetUnits, function(a, b)
            if a.rank ~= b.rank then
                return a.rank > b.rank
            else
                return a.xp > b.xp -- Con XP cao hơn xếp trước để mau Max Cấp!
            end
        end)
        
        if #targetUnits > 0 and #fodderUnits >= 1 then
            debugLog(string.format("[GARDEN FUSE] Target Units: %d | Fodder Units Available: %d", #targetUnits, #fodderUnits))
            local fodderIndex = 1
            
            for _, target in ipairs(targetUnits) do
                local fodderDict = {}
                local stackCount = 0
                local totalFodderCount = 0
                
                while fodderIndex <= #fodderUnits and stackCount < 25 do
                    local fodder = fodderUnits[fodderIndex]
                    if fodder.uid ~= target.uid and fodder.count > 0 then
                        fodderDict[fodder.uid] = fodder.count
                        totalFodderCount = totalFodderCount + fodder.count
                        stackCount = stackCount + 1
                        fodder.count = 0
                    end
                    fodderIndex = fodderIndex + 1
                end
                
                if totalFodderCount > 0 then
                    local currentLvl = TowerLevelingUtil.XPToLevel(nil, target.xp) or 1
                    debugLog(string.format("[GARDEN FUSE] Fusing %d fodder units into [%s] (Level %d)...", totalFodderCount, target.id, currentLvl))
                    
                    local ok, success, resData = pcall(function()
                        return Network.Invoke("GardenFuse_Activate", target.uid, fodderDict)
                    end)
                    
                    if ok and success then
                        -- Chờ 1.0s để Client đồng bộ Save Data mới nhất từ Server sau khi Fuse
                        task.wait(1.0)
                        local newSave = Save and Save.Get and Save.Get()
                        local newUnitData = newSave and newSave.Inventory and newSave.Inventory.Tower and newSave.Inventory.Tower[target.uid]
                        local newUq = newUnitData and (newUnitData._uq or (newUnitData._data and newUnitData._data._uq))
                        local newXP = (newUq and tonumber(newUq.xp or newUq.XP)) or (type(resData) == "table" and tonumber(resData.xp or resData.XP)) or (newUnitData and tonumber(newUnitData.xp or newUnitData.XP)) or target.xp or 0
                        
                        local newLvl = (TowerLevelingUtil and TowerLevelingUtil.XPToLevel and TowerLevelingUtil.XPToLevel(nil, newXP)) or currentLvl
                        
                        debugLog(string.format("[GARDEN FUSE SUCCESS] Fused %d Units into [%s] (Level %d -> %d | XP: %s)", 
                            totalFodderCount, target.id, currentLvl, newLvl, formatCompactNumber(newXP)))
                    else
                        debugLog(string.format("[GARDEN FUSE FAIL] Failed to Fuse into [%s]: %s", target.id, tostring(success or errReason)))
                    end
                end
                
                if fodderIndex > #fodderUnits then break end
            end
        else
            debugLog(string.format("[GARDEN FUSE STATUS] Targets: %d | Fodders: %d (Need >= 1 fodder unit to fuse)", #targetUnits, #fodderUnits))
        end
    end)
end

