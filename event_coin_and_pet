                                ["Mythic"] = "80349803460908",
                                ["Ultimate Seed"] = "109074321295822",
                                ["Ultimate"] = "109074321295822",
                                ["Divine Seed"] = "128208618928812",
                                ["Divine"] = "128208618928812",
                                ["Exotic Seed"] = "102551878693423",
                                ["Exotic"] = "102551878693423",
                                ["Rare Seed"] = "111757558648944",
                                ["Rare"] = "111757558648944",
                                ["Basic Seed"] = "115826407841293",
                                ["Basic"] = "115826407841293"
                            }
