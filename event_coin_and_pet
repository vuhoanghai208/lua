-- MODULE 8: AUTO CONSUME EVENT POTIONS & XP TOKENS
-- --------------------------------------------------------------------------
function EventP2.UseXPPotions()
    if not Config.AutoConsumeXPPotions then return end
    
    local allowedMap = Config.AllowedPotions or {}
    
    pcall(function()
        local saveData = Save.Get and Save.Get()
        local inv = saveData and saveData.Inventory
        if not inv then return end
        
        local dictsToScan = { inv.Consumable, inv.Potion, inv.XPPotion }
        
        for _, categoryDict in ipairs(dictsToScan) do
            if type(categoryDict) == "table" then
                for uid, itemData in pairs(categoryDict) do
                    if type(itemData) == "table" then
                        local pId = tostring(itemData.id or itemData._id or "")
                        local tier = itemData.tn or itemData.tier or 1
                        
                        local isGardenPotion = false
                        if pId:find("Garden") or pId:find("Growth Cocktail") or pId:find("Cocktail") or pId:find("Fertilizer") then
                            isGardenPotion = true
                        elseif pId:find("Sunlight") or pId:find("Rain") or pId:find("Coin Bloom") then
                            isGardenPotion = true
                        end
                        
                        if pId:find("Mining") or pId:find("Fishing") or pId:find("Backrooms") 
                            or pId:find("Halloween") or pId:find("Dice") or pId:find("Pencil") 
                            or pId:find("Scroll") or pId:find("Booster") or pId:find("Tile") then
                            isGardenPotion = false
                        end
                        
                        if isGardenPotion then
                            local isBlacklisted = false
                            
                            -- Xác định đúng tên gốc để nối với Tier (Romain numeral)
                            local baseConfigKey = pId
                            if pId == "Sunlight" then baseConfigKey = "Garden Sunlight Potion"
                            elseif pId == "Rain" then baseConfigKey = "Garden Rain Potion"
                            elseif pId == "Speed" then baseConfigKey = "Garden Speed Potion"
                            elseif pId == "Luck" then baseConfigKey = "Garden Luck Potion"
                            elseif pId == "Coin Bloom" then baseConfigKey = "Garden Coin Bloom Potion"
                            elseif pId == "Fertilizer" then baseConfigKey = "Fertilizer" -- Mặc định là Fertilizer thường
                            end
                            
                            if pId:find("Cocktail") then
                                baseConfigKey = "Growth Cocktail"
                            end
                            
                            local finalKey = baseConfigKey
                            
                            -- Nối thêm Tier (I, II, III, IV...)
                            if tier == 1 and baseConfigKey == "Growth Cocktail" then
                                finalKey = baseConfigKey .. " I"
                            elseif tier == 2 or pId:find("II") then
                                finalKey = baseConfigKey .. " II"
                            elseif tier == 3 or pId:find("III") then
                                finalKey = baseConfigKey .. " III"
                            elseif tier == 4 or pId:find("IV") then
                                finalKey = baseConfigKey .. " IV"
                            end
                            
                            -- Nếu key có trong config và bị false -> Blacklist
                            if allowedMap[finalKey] == false then
                                isBlacklisted = true
                            elseif allowedMap[pId] == false then
                                -- Check phụ cho chắc ăn
                                isBlacklisted = true
                            end
                            
                            if not isBlacklisted then
                                local cOk, cRes = pcall(function()
                                    return Network.Invoke("Consumables_Consume", tostring(uid), 1)
                                end)
                                if cOk and cRes ~= false then
                                    debugLog("[POTION BUFF] Consumed Event Potion:", pId)
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
    
    local tdLocal = ClientTowerDefense and ClientTowerDefense.GetLocal and ClientTowerDefense.GetLocal()
    if tdLocal and ClientTower then
        local activeTowers = ClientTower.All(tdLocal)
        if activeTowers and #activeTowers > 0 then
            local targetTower = nil
            for _, tower in ipairs(activeTowers) do
                if tower and not tower.Destroyed then
                    targetTower = tower
                    break
                end
            end
            
            if targetTower then
                local towerUID = targetTower.Id or targetTower:GetId()
                local eventPotionIds = { 
                    "Tower Defense I", "Tower Defense II", "Tower Defense III",
                    "Tower Defense XP Potion I", "Tower Defense XP Potion II", "Tower Defense XP Potion III",
                    "Garden XP Token", "Pet XP Token"
                }
                
                for _, potionId in ipairs(eventPotionIds) do
                    if allowedMap[potionId] ~= false then
                        local tokenUID = nil
                        pcall(function()
                            local saveData = Save.Get and Save.Get()
                            local inv = saveData and saveData.Inventory
                            if inv then
                                local dicts = { inv.XPPotion, inv.Consumable, inv.Potion }
                                for _, d in ipairs(dicts) do
                                    if type(d) == "table" then
                                        for u, it in pairs(d) do
                                            if type(it) == "table" then
                                                local pName = tostring(it.id or it._id or "")
                                                if pName == potionId or pName:find(potionId) then
                                                    tokenUID = tostring(u)
                                                    break
                                                end
                                            end
                                        end
                                    end
                                    if tokenUID then break end
                                end
                            end
                        end)
                        
                        if tokenUID then
                            local pOk, pRes = pcall(function()
                                return Network.Invoke("XPPotions: Consume", potionId, tokenUID, towerUID, 1)
                            end)
                            if pOk and pRes and pRes ~= false then
                                debugLog("[XP TOKEN] Consumed XP Token for Unit:", potionId)
                            end
                        end
                    end
                end
            end
        end
    end
end

