-- Helper lấy Cấp Rebirth Event (Garden Event Campaign Rebirth)
local function getRebirthLevel()
    local lvl = 0
    
    -- 1. Ưu tiên 1: Đọc từ Plot Save Data ("PvC_Regrows")
    pcall(function()
        local localPlot = ClientPlot and ClientPlot.GetLocal and ClientPlot.GetLocal("Garden")
        if localPlot and localPlot.Save then
            local r = localPlot:Save("PvC_Regrows")
            if type(r) == "number" then
                lvl = r
            end
        end
    end)
    
    if lvl and lvl > 0 then return lvl end
    
    -- 2. Ưu tiên 2: Đọc trực tiếp từ GUI Event UI (PlayerGui.InstanceQuests.Frame.Top.Rebirth)
    pcall(function()
        local player = game.Players.LocalPlayer
        local playerGui = player and player:FindFirstChild("PlayerGui")
        local instanceQuests = playerGui and playerGui:FindFirstChild("InstanceQuests")
        if instanceQuests and instanceQuests:FindFirstChild("Frame") then
            local top = instanceQuests.Frame:FindFirstChild("Top")
            local rebirthElem = top and top:FindFirstChild("Rebirth")
            if rebirthElem then
                local txt = ""
                if rebirthElem:IsA("TextLabel") or rebirthElem:IsA("TextButton") then
                    txt = rebirthElem.Text
                else
                    local label = rebirthElem:FindFirstChildOfClass("TextLabel")
                    if label then txt = label.Text end
                end
                
                if type(txt) == "string" and txt ~= "" then
                    local numStr = string.match(txt, "Rebirth%s*(%d+)")
                    if numStr then
                        lvl = tonumber(numStr) or 0
                    end
                end
            end
        end
    end)
    
    if lvl and lvl > 0 then return lvl end
    
    -- 3. Ưu tiên 3: Đọc key Event Regrow trong saveData
    pcall(function()
        local saveData = Save and Save.Get and Save.Get()
        if saveData then
            lvl = tonumber(saveData.PvC_Regrow or saveData.PvC_RegrowLevel or saveData.GardenRegrow or saveData.RegrowLevel or 0) or 0
        end
    end)
    
    return lvl or 0
end

