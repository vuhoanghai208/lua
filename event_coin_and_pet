function EventP2.HatchEggs()
    if not Config.AutoHatchEggs then return end
    
    local now = os.clock()
    local isMaxed = EventP2.IsEconomyMaxed()
    local normalDelay = Config.HatchInterval or 180
    local fastDelay = Config.FastHatchInterval or 5
    local requiredCooldown = isMaxed and fastDelay or normalDelay
    
    if now - lastHatchAttemptTime < requiredCooldown then
        return
    end
    
    -- Cập nhật mốc thời gian ngay lập tức để áp dụng Cooldown (180s) đúng chuẩn cho các vòng lặp 1.5s tiếp theo
    lastHatchAttemptTime = now
    
    pcall(function()
        local TabController = require(Client:WaitForChild("TabController"))
        if TabController and TabController.Get and TabController.Get() ~= nil then
            TabController.CloseTab(true)
        end
    end)
    
    -- Quét trực tiếp danh sách Custom Eggs từ Module của game thay vì dò trên Workspace
    local candidates = {}
    local pcallOk, CustomEggsCmds = pcall(require, game.ReplicatedStorage.Library.Client.CustomEggsCmds)
    
    if pcallOk and CustomEggsCmds and CustomEggsCmds.All then
        local allEggs = CustomEggsCmds.All()
        if type(allEggs) == "table" then
            for uid, eggObj in pairs(allEggs) do
                table.insert(candidates, { uid = uid, eggObj = eggObj })
            end
        end
    end
    
    if #candidates == 0 then
        debugLog("[HATCH SEARCH] No active egg candidates found in CustomEggsCmds")
        return
    end
    
    local myEggTarget = nil
    for _, item in ipairs(candidates) do
        local eggObj = item.eggObj
        local isHatchable = false
        pcall(function() isHatchable = eggObj:IsHatchable() end)
        
        -- Ưu tiên 1: ĐÚNG Owner VÀ đang IsHatchable() = true
        if eggObj and eggObj._owner == game.Players.LocalPlayer and isHatchable then
            myEggTarget = item
            break
        end
    end
    
    -- Ưu tiên 2: Lấy trứng IsHatchable() gần Plot / Player HRP nhất (như find_egg.lua)
    if not myEggTarget then
        local localPlot = ClientPlot and ClientPlot.GetLocal and ClientPlot.GetLocal("Garden")
        local plotModel = localPlot and localPlot:GetModel()
        local plotPos = plotModel and plotModel:GetPivot().Position
        if not plotPos and game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            plotPos = game.Players.LocalPlayer.Character.HumanoidRootPart.Position
        end
        
        if plotPos then
            local minDistance = math.huge
            for _, item in ipairs(candidates) do
                local eggObj = item.eggObj
                local isHatchable = false
                pcall(function() isHatchable = eggObj:IsHatchable() end)
                
                if isHatchable then
                    local eggPos = eggObj and eggObj._position
                    if not eggPos and eggObj and eggObj.GetModel then
                        local mod = eggObj:GetModel()
                        if mod then eggPos = mod:GetPivot().Position end
                    end
                    
                    if eggPos then
                        local dist = (eggPos - plotPos).Magnitude
                        if dist < minDistance then
                            minDistance = dist
                            myEggTarget = item
                        end
                    end
                end
            end
        end
    end
    
    if not myEggTarget then
        debugLog("[HATCH SEARCH] Found candidates but none are currently hatchable/unlocked")
        return
    end
    
    -- Reset biến OpeningEgg của game để không bị khóa trạng thái Interact
    pcall(function()
        local Variables = require(Library.Client.Parent.Variables or Library:WaitForChild("Variables"))
        if Variables then
            Variables.OpeningEgg = 0
            Variables.Typing = false
            Variables.MessageOpen = false
        end
    end)
    
    local targetUID = myEggTarget.uid
    local hatchAmount = 1
    local skipEgg = nil
    
    pcall(function()
        local CustomEggsCmds      = require(game.ReplicatedStorage.Library.Client.CustomEggsCmds)
        local EggCmds             = require(game.ReplicatedStorage.Library.Client.EggCmds)
        local okCalc, CalcEggPricePlayer = pcall(require, game.ReplicatedStorage.Library.Balancing.CalcEggPricePlayer)
        local CurrencyCmds        = require(game.ReplicatedStorage.Library.Client.CurrencyCmds)
        local eggObj = CustomEggsCmds and CustomEggsCmds.Get(targetUID)
        if not eggObj then
            error("eggObj is nil for UID: " .. tostring(targetUID))
        end
        
        local _dir = eggObj._dir
        local currency = _dir and _dir.currency or "Sunflowers"
        
        -- 1. LẤY GIÁ 1 QUẢ TRỨNG
        local price = 0
        if okCalc and CalcEggPricePlayer and _dir then
            local ok, pVal = pcall(CalcEggPricePlayer, _dir, nil, not eggObj._allowChargedAndGolden)
            if ok and type(pVal) == "number" and pVal > 0 then
                price = pVal
            end
        end
        if price <= 0 and _dir then
            price = _dir.cost or _dir.overrideCost or _dir.price or 0
        end
        if price <= 0 then
            price = 15000000 -- Default 15M Sunflowers
        end
        
        -- 2. LẤY SỐ SLOT HATCH TỐI ĐA CỦA PLAYER
        local maxHatchSlots = eggObj._maxEggCount
        if not maxHatchSlots and _dir and EggCmds and EggCmds.GetMaxHatch then
            pcall(function() maxHatchSlots = EggCmds.GetMaxHatch(_dir) end)
        end
        maxHatchSlots = maxHatchSlots or 84
        
        -- 3. TÍNH SỐ LƯỢNG MUA ĐƯỢC THEO TÚI TIỀN (AFFORDABLE)
        local balance = CurrencyCmds and CurrencyCmds.Get and (CurrencyCmds.Get(currency) or 0) or 0
        local affordable = math.floor(balance / price)
        
        -- A. KIỂM TRA LỖI KHÔNG ĐỦ TIỀN MUA NỔI 1 QUẢ
        if affordable <= 0 then
            debugLog(string.format("[HATCH SKIP - INSUFFICIENT FUNDS] Required %s Sunflowers (Price: %s/egg), Balance: %s", formatCompactNumber(price), formatCompactNumber(price), formatCompactNumber(balance)))
            skipEgg = "nomoney"
            return
        end
        
        -- B. KIỂM TRA LỖI DƯỚI NGƯỠNG MINHATCHAMOUNT
        local minHatchLimit = Config.MinHatchAmount or 1
        if affordable < minHatchLimit then
            debugLog(string.format("[HATCH SKIP - BELOW MINIMUM] Balance allows %d eggs (Balance: %s, Price: %s/egg) < MinHatchAmount (%d). Accumulating funds...", affordable, formatCompactNumber(balance), formatCompactNumber(price), minHatchLimit))
            skipEgg = "notenoughmin"
            return
        end
        
        -- C. CHỌN HATCH AMOUNT CHUẨN XÁC
        hatchAmount = math.floor(math.min(maxHatchSlots, affordable))
    end)
    hatchAmount = math.max(1, hatchAmount or 1)
    
    if skipEgg then
        if skipEgg == "locked" then
            debugLog(string.format("[HATCH SKIP] UID: %s - Egg locked (Not hatchable / Cooldown)", targetUID))
        end
    else
        debugLog(string.format("[HATCH] UID: %s -> hatchAmount = %d", targetUID, hatchAmount))
        
        -- Tắt Egg Opening Animation TRƯỚC khi hatch
        EventP2.ManageEggAntiLag()
        
        -- Tự động Teleport lại gần trứng nếu đang ở xa (> 15 studs)
        pcall(function()
            local eggPos = nil
            local things = workspace:FindFirstChild("__THINGS") or workspace
            local customEggsFolder = things:FindFirstChild("CustomEggs")
            local modelInWs = customEggsFolder and customEggsFolder:FindFirstChild(targetUID)
            if modelInWs then
                pcall(function() eggPos = modelInWs:GetPivot().Position end)
            end
            if not eggPos then
                eggPos = myEggTarget.eggObj and myEggTarget.eggObj._position
                if not eggPos and myEggTarget.eggObj and myEggTarget.eggObj.GetModel then
                    local mod = myEggTarget.eggObj:GetModel()
                    if mod then eggPos = mod:GetPivot().Position end
                end
            end
            
            local player = game.Players.LocalPlayer
            if eggPos and player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = player.Character.HumanoidRootPart
                if (hrp.Position - eggPos).Magnitude > 15 then
                    hrp.CFrame = CFrame.new(eggPos + Vector3.new(0, 2, 3))
                    task.wait(0.8) -- Đợi Server đồng bộ gói tin Physics Replication vị trí mới của Client!
                end
            end
        end)
        
        -- Gọi thẳng CustomEggs_Hatch(uid, amount)
        local success, result
        local retries = 0
        repeat
            success, result = pcall(function()
                return Network.Invoke("CustomEggs_Hatch", targetUID, hatchAmount)
            end)
            if success and result == true then
                break -- thành công
            end
            -- Nếu Server trả về false, break ngay tránh tốn thời gian retry
            if success and result == false then
                break
            end
            retries = retries + 1
            if retries < 3 then
                task.wait(1.0)
            end
        until (success and result == true) or retries >= 3
        
        if success and result == true then
            debugLog(string.format("🐣 [HATCH SUCCESS] Hatched %d Event Eggs! (UID: %s)", hatchAmount, targetUID))
        else
            debugLog(string.format("⚠️ [HATCH FAIL - GAME ĐANG KHÓA / COOLDOWN] Server từ chối ấp %d quả (Result: %s, UID: %s)! Kiểm tra lại tiến trình diệt Boss ở Stage Rebirth này.", hatchAmount, tostring(result), targetUID))
        end
        
        lastHatchAttemptTime = os.clock()
    end
end

