-- Helper chọn Hạt Giống tốt nhất
local function pickBestSeed(allSeeds, mode)
    if not allSeeds or #allSeeds == 0 then return nil end
    
    local seedsCopy = {}
    for _, s in ipairs(allSeeds) do
        table.insert(seedsCopy, s)
    end
    
    table.sort(seedsCopy, function(a, b)
        local idA = a.GetId and a:GetId() or ""
        local idB = b.GetId and b:GetId() or ""
        local rankA = SEED_RANK[idA] or 0
        local rankB = SEED_RANK[idB] or 0
        if mode == "Lowest" then
            return rankA < rankB
        else
            return rankA > rankB
        end
    end)
    
    return seedsCopy[1]
end

