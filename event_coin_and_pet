                            end)
                        end
                        
                        if (catName == "CropSeed" or catName == "Seed") and not displayName:find("Seed") then
                            displayName = displayName .. " Seed"
                        end
                        
                        if tier > 1 and not displayName:find("II") and not displayName:find("III") and not displayName:find("IV") then
                            local romanTiers = { "I", "II", "III", "IV", "V" }
                            local roman = romanTiers[tier] or tostring(tier)
                            displayName = displayName .. " " .. roman
                        end
                        
                        if isShiny then
                            displayName = "Shiny " .. displayName
                        end
                        
                        -- Tự động tra cứu Icon 3-Layer chuẩn đét 100%
                        local itemIcon = itemData.icon or itemData._icon or itemData.Icon or ""
                        
                        if (not itemIcon or itemIcon == "") and Items and Items.From then
                            pcall(function()
                                local itemObj = Items.From(itemData)
                                if itemObj and itemObj.GetIcon then itemIcon = itemObj:GetIcon() end
                            end)
                        end
                        
                        if (not itemIcon or itemIcon == "") and DirectoryModule then
                            pcall(function()
                                local possibleCategories = {
