function EventP2.ManageDefenders()
    if not Config.AutoUpgradeDefenders and not Config.AutoPlaceDefenders and not Config.AutoReplaceBetterDefenders then return end
    
    local tdLocal = ClientTowerDefense and ClientTowerDefense.GetLocal and ClientTowerDefense.GetLocal()
    if not tdLocal or not ClientTower then return end
    
    pcall(function() Network.Invoke("YB_Latch", "Upgrade") end)
    
    local activeTowers = ClientTower.All(tdLocal) or {}
    local inventoryTowers = getInventoryTowers()
    
    local placedUIDs = {}
    for _, active in ipairs(activeTowers) do
        if active and not active.Destroyed then
            local item = active:GetItem()
            if item then
                local u = (item.GetUID and item:GetUID()) or item._uid or item.uid or item.id
                if u then placedUIDs[tostring(u)] = true end
            end
            if active.State and active.State.Item then
                local rawItem = active.State.Item:Get()
                if rawItem then
                    local u = (rawItem.GetUID and rawItem:GetUID()) or rawItem._uid or rawItem.uid
                    if u then placedUIDs[tostring(u)] = true end
                end
            end
        end
    end
    
    local unplacedInventoryTowers = inventoryTowers
    
    table.sort(unplacedInventoryTowers, function(a, b)
        if a.power ~= b.power then
            return a.power > b.power
        end
        return tostring(a.uid) < tostring(b.uid)
    end)
    
    local freeSlots, combatWorld = getAvailableLaneSlots()
    
    local top1Name = (#unplacedInventoryTowers > 0) and unplacedInventoryTowers[1].id or "None"
    local top1Pwr = (#unplacedInventoryTowers > 0) and unplacedInventoryTowers[1].power or 0
    
    debugLog(string.format("[DEFENDER STATUS] Active: %d | Free Slots: %d | Unplaced: %d (Best: %s - Power: %.1f)",
        #activeTowers, #freeSlots, #unplacedInventoryTowers, tostring(top1Name), top1Pwr
    ))
    
    if Config.AutoPlaceDefenders and #freeSlots > 0 and #unplacedInventoryTowers > 0 then
        local bestUnplaced = unplacedInventoryTowers[1]
        
        for idx, targetSlotPart in ipairs(freeSlots) do
            local slotPos = targetSlotPart.Position
            local targetCFrame = CFrame.new(slotPos) * CFrame.Angles(0, math.pi / 2, 0)
            local relativeCF = combatWorld and combatWorld.CFrame:ToObjectSpace(targetCFrame) or CFrame.new(slotPos)
            
            local ok, pSuccess, pReason, towerId = pcall(function()
                return Network.Invoke("WD_Attach", bestUnplaced.uid, relativeCF)
            end)
            
            if ok and pSuccess == true then
                debugLog(string.format("[DEFENDER] Placed [%s] (DPS: %.1f) into Slot [%s] (TowerID: %s)",
                    bestUnplaced.id, bestUnplaced.power, targetSlotPart.Name, tostring(towerId or pReason)
                ))
                return
            else
                if pReason and type(pReason) == "string" and not pReason:find("occupied") and not pReason:find("close") and not pReason:find("fast") then
                    debugLog(string.format("[DEFENDER ATTACH FAIL] Slot %s: %s", targetSlotPart.Name, tostring(pReason)))
                end
            end
        end
    end
    
    if Config.AutoReplaceBetterDefenders and #freeSlots == 0 and #unplacedInventoryTowers > 0 then
        local bestUnplaced = unplacedInventoryTowers[1]
        
        local weakestActive = nil
        local weakestPower = math.huge
        
        for _, active in ipairs(activeTowers) do
            if active and not active.Destroyed then
                local activeItem = active:GetItem()
                local activeIdName = (activeItem and activeItem.GetId and activeItem:GetId()) or (active.Id or (active.GetId and active:GetId()) or "Unknown")
                local activeLvl = (active.GetUpgrade and active:GetUpgrade()) or (active.State and active.State.Upgrade and active.State.Upgrade.Get and active.State.Upgrade:Get()) or 1
                local pwr = getUnitPower(activeIdName, activeLvl)
                if pwr < weakestPower then
                    weakestPower = pwr
                    weakestActive = active
                end
            end
        end
        
        if weakestActive and bestUnplaced.power > weakestPower then
            local activeItem = weakestActive:GetItem()
            local activeIdName = activeItem and activeItem.GetId and activeItem:GetId() or "Unknown"
            local activeId = weakestActive.Id or weakestActive:GetId()
            local activeCF = (weakestActive.GetCFrame and weakestActive:GetCFrame()) or (weakestActive.Model and weakestActive.Model.GetPivot and weakestActive.Model:GetPivot())
            local relCF = (combatWorld and activeCF) and combatWorld.CFrame:ToObjectSpace(activeCF) or CFrame.new(0, 0, 0)
            
            debugLog(string.format("[DEFENDER] Replacing [%s] (DPS: %.1f) with stronger [%s] (DPS: %.1f)...",
                activeIdName, weakestPower, bestUnplaced.id, bestUnplaced.power
            ))
            
            pcall(function() Network.Invoke("OR_Detach", activeId) end)
            
            for attempt = 1, 5 do
                task.wait(0.2)
                local ok, pSuccess, pReason, newTowerId = pcall(function()
                    return Network.Invoke("WD_Attach", bestUnplaced.uid, relCF)
                end)
                if ok and pSuccess == true then
                    debugLog(string.format("[DEFENDER] Replacement complete! Placed [%s] (TowerID: %s)",
                        bestUnplaced.id, tostring(newTowerId)
                    ))
                    break
                end
            end
        end
    end
    
    -- 4. Kiểm tra Cooldown & Ngân sách dự trữ trước khi Upgrade Level
    local now = os.clock()
    local cooldown = Config.DefenderUpgradeCooldown or 1
    if now - lastDefenderUpgradeTime < cooldown then
        return
    end
    
    local currentSunflowers = getSunflowers()
    local reserveLimit = Config.DefenderMinSunflowersReserve or 10000
    if currentSunflowers < reserveLimit then
        return
    end
    
    -- 5. Nâng cấp Level cho Defender Units
    if Config.AutoUpgradeDefenders then
        local upgradedCount = 0
        for _, tower in ipairs(activeTowers) do
            if tower and not tower.Destroyed then
                local towerId = tower.Id or tower:GetId()
                local item = tower.GetItem and tower:GetItem()
                local currentLvl = (tower.GetUpgrade and tower:GetUpgrade()) or (tower.State and tower.State.Upgrade and tower.State.Upgrade.Get and tower.State.Upgrade:Get()) or 1
                local maxLvl = item and item.GetMaxUpgrade and item:GetMaxUpgrade() or 10
                
                if currentLvl < maxLvl then
                    local upgSuccess, result = pcall(function()
                        return Network.Invoke("EK_Promote", towerId, 1)
                    end)
                    if not upgSuccess or (result ~= true and result ~= nil and result ~= false) then
                        pcall(function() return Network.Invoke("EK_Promote", towerId) end)
                    end
                    
                    if upgSuccess then
                        local unitName = item and (item.GetId and item:GetId()) or "Unit"
                        debugLog(string.format("[UPGRADE UNIT] %s (ID: %s) Level %d -> %d", tostring(unitName), tostring(towerId), currentLvl, currentLvl + 1))
                        upgradedCount = upgradedCount + 1
                        if upgradedCount >= 3 then break end
                    end
                end
            end
        end
        if upgradedCount > 0 then
            lastDefenderUpgradeTime = now
        end
    end
end

