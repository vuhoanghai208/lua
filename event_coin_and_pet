                                    if officialName and officialName ~= "" then
                                        displayName = officialName
                                    end
                                end
                            end)
                        end
                        
                        if displayName == itemId and DirectoryModule then
                            pcall(function()
                                local possibleCategories = { catName .. "s", catName, "Consumables", "Potions", "CropSeeds" }
                                for _, catKey in ipairs(possibleCategories) do
                                    if DirectoryModule[catKey] and DirectoryModule[catKey][itemId] then
