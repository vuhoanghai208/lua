            if TradingPlazaCmds and TradingPlazaCmds.GetAvailable and #TradingPlazaCmds.GetAvailable() > 1 then
                canPro = true
            end
        end)
        if canPro then
            return math.random(1, 2) == 1 and PLAZA_PLACES.Normal or PLAZA_PLACES.Pro
        end
        return PLAZA_PLACES.Normal
    end
    return PLAZA_PLACES.Normal
end

-- Serverhop Utilities
local JoinedJobs = {}
local isTeleporting = false
local lastHopTime = 0

local queue_on_teleport = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport)

local function QueueReexecution()
    if queue_on_teleport then
        local code = [[
            repeat task.wait() until game:IsLoaded() and game:GetService("Players").LocalPlayer
            task.wait(1)
            print("[SNIPER] 🚀 Successfully joined new server!")
        ]]
        if isfile then
            if isfile("sniper.lua") then
                code = code .. "\npcall(function() loadstring(readfile('sniper.lua'))() end)"
            elseif isfile("p99/plaza/sniper/sniper.lua") then
                code = code .. "\npcall(function() loadstring(readfile('p99/plaza/sniper/sniper.lua'))() end)"
            end
        end
        pcall(queue_on_teleport, code)
    end
end

-- Teleport Bypass Helper for Executor Hooks (Delta / Codex)
local function TeleportInstanceBypass(targetPlaceId, targetJobId, teleportData)
    local TS = cloneref and cloneref(game:GetService("TeleportService")) or TeleportService

    -- 1. Try dot-syntax invocation to bypass __namecall hooks
    local ok, err = pcall(function()
        local tpFunc = TS.TeleportToPlaceInstance
        tpFunc(TS, targetPlaceId, targetJobId, LocalPlayer, nil, teleportData)
    end)
    if ok then return true end

    -- 2. Fallback to method invocation
    ok, err = pcall(function()
        TS:TeleportToPlaceInstance(targetPlaceId, targetJobId, LocalPlayer, nil, teleportData)
    end)
    if ok then return true end

    -- 3. Fallback to basic Teleport
    ok, err = pcall(function()
        TS:Teleport(targetPlaceId, LocalPlayer)
    end)
    return ok
end

local function HopServer()
    if isTeleporting then return end
    if os.time() - lastHopTime < 8 then return end

    isTeleporting = true
    lastHopTime = os.time()
    print("[SNIPER] 🚀 Preparing Serverhop...")

    QueueReexecution()

    -- 1. If currently not in Trading Plaza, use PS99 native Travel to Trading Plaza API
    local isPlaza = false
    pcall(function()
        if TradingPlazaCmds and TradingPlazaCmds.IsOnTradingPlaza then
            isPlaza = TradingPlazaCmds.IsOnTradingPlaza()
        end
    end)
    if not isPlaza and (game.PlaceId ~= PLAZA_PLACES.Normal and game.PlaceId ~= PLAZA_PLACES.Pro) then
        local targetPlaceId = GetTargetPlazaId()
        print(string.format("[SNIPER] 🏰 Traveling to Trading Plaza (%d)...", targetPlaceId))
        local travelOk = pcall(function()
            if TradingPlazaCmds and TradingPlazaCmds.RequestTradingPlaza then
                TradingPlazaCmds.RequestTradingPlaza(targetPlaceId)
            else
                Network.Invoke("Travel to Trading Plaza", targetPlaceId)
            end
        end)
        if not travelOk then
            pcall(function()
                TeleportService:Teleport(targetPlaceId, LocalPlayer)
            end)
        end
        task.wait(10)
        isTeleporting = false
        return
    end

    local cfg = getgenv().SniperConfig

    -- 2. Try Targeted Hop via Trading Terminal for FixedPrice items
    if cfg.FixedPrices then
        for itemID, maxPrice in pairs(cfg.FixedPrices) do
            local placeId, jobId = SearchItemOnTerminal("Misc", { id = itemID })
            if not placeId then
                placeId, jobId = SearchItemOnTerminal("Pet", { id = itemID })
            end
            if placeId and jobId and jobId ~= game.JobId and not table.find(JoinedJobs, jobId) then
                table.insert(JoinedJobs, jobId)
                print(string.format("[SNIPER] 🎯 Terminal found server for %s! Teleporting to %s...", itemID, jobId))
                
                local teleportPayload = {
                    IsTerminalTeleport = true,
                    TerminalStackKey = itemID
                }
                
                local tpSuccess = TeleportInstanceBypass(placeId, jobId, teleportPayload)
                if not tpSuccess then
                    warn("[SNIPER ⚠️] Teleport failed! If Delta blocked it, turn off BOTH 'Anti Scam' AND 'Verify Teleports' in Delta Settings & press Save Settings!")
                end
                task.wait(6)
                isTeleporting = false
                return
            end
        end
    end

    -- 3. Fallback Public Server Hop
    local targetPlaceId = GetTargetPlazaId()
    local url = string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Desc&limit=100", tostring(targetPlaceId))
    
    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)

    if ok and body then
        local decodeOk, data = pcall(HttpService.JSONDecode, HttpService, body)
        if decodeOk and data and data.data then
            for _, s in ipairs(data.data) do
                if s.id ~= game.JobId and s.playing < s.maxPlayers and s.playing >= 5 and not table.find(JoinedJobs, s.id) then
                    table.insert(JoinedJobs, s.id)
                    if #JoinedJobs > 15 then table.remove(JoinedJobs, 1) end
                    print(string.format("[SNIPER] 🌐 Teleporting to Public Server %s (%d/%d players)...", s.id, s.playing, s.maxPlayers))
                    
                    local tpSuccess = TeleportInstanceBypass(targetPlaceId, s.id, nil)
                    if not tpSuccess then
                        warn("[SNIPER ⚠️] Teleport failed! If Delta blocked it, turn off BOTH 'Anti Scam' AND 'Verify Teleports' in Delta Settings & press Save Settings!")
                    end
                    task.wait(6)
                    isTeleporting = false
                    return
                end
            end
        end
    end

    -- 4. Last Fallback Teleport
    print(string.format("[SNIPER] 🔄 Fallback Teleporting to Place %d...", targetPlaceId))
    pcall(function()
        TeleportService:Teleport(targetPlaceId, LocalPlayer)
    end)
    task.wait(6)
    isTeleporting = false
end

-- TeleportInitFailed listener to reset state on failure
TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
    if player == LocalPlayer then
        warn(string.format("[SNIPER ⚠️] TeleportInitFailed: %s (Reason: %s)", tostring(teleportResult), tostring(errorMessage)))
        isTeleporting = false
    end
end)

-- Main Loop
task.spawn(function()
    print("=============================================")
    print(" 🚀 PS99 Auto Booth Sniper Started!")
    print("=============================================")

    local startTime = os.time()

    while task.wait(1) do
        -- Auto Teleport to Plaza if executed outside of Trading Plaza
        local isPlaza = false
        pcall(function()
            if TradingPlazaCmds and TradingPlazaCmds.IsOnTradingPlaza then
                isPlaza = TradingPlazaCmds.IsOnTradingPlaza()
            end
        end)

        if not isPlaza and (game.PlaceId ~= PLAZA_PLACES.Normal and game.PlaceId ~= PLAZA_PLACES.Pro) then
            print("[SNIPER] Currently not in Trading Plaza. Teleporting to Plaza...")
            HopServer()
            task.wait(5)
            continue
        end

        local cfg = getgenv().SniperConfig
        if not cfg or not cfg.Enabled then continue end

        -- Scan current server
        local count = ScanServerBooths()

        -- AutoHop timer check
        if cfg.AutoHop and (os.time() - startTime) >= (cfg.HopDelay or 5) then
            if count == 0 and not isTeleporting then
                HopServer()
                startTime = os.time()
            end
        end
    end
end)

