local function CalculatePercent(rap, price)
    if not rap or rap <= 0 or not price then return 0 end
    return ((rap - price) / rap) * 100
end

-- Buy Limit Tracking Helpers
getgenv().SniperBoughtStats = getgenv().SniperBoughtStats or {}

local function GetRemainingBuyLimit(itemName)
    local cfg = getgenv().SniperConfig
    if not cfg.LimitBuyEnabled or not cfg.LimitBuy then
        return math.huge
    end
    local limitVal = cfg.LimitBuy[itemName]
    if limitVal == nil or limitVal == false then
        return math.huge
    end
    local limit = ParseNumber(limitVal)
    if limit <= 0 then
        return math.huge
    end
    local bought = getgenv().SniperBoughtStats[itemName] or 0
    return math.max(0, limit - bought)
end

