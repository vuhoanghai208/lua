local function ParseNumber(val)
    if type(val) == "number" then return val end
    if type(val) ~= "string" or val == "" then return 0 end
    val = val:lower():gsub("%s+", ""):gsub(",", "")
    local mult = 1
    if val:find("k$") then
        mult = 1e3
        val = val:sub(1, -2)
    elseif val:find("m$") then
        mult = 1e6
        val = val:sub(1, -2)
    elseif val:find("b$") then
        mult = 1e9
        val = val:sub(1, -2)
    elseif val:find("t$") then
        mult = 1e12
        val = val:sub(1, -2)
    end
    local num = tonumber(val)
    return num and math.floor(num * mult) or 0
end

local Suffixes = {"k", "m", "b", "t"}
local function FormatNumber(val)
    if not val or type(val) ~= "number" then return "0" end
    if val == 0 then return "0" end
    local absVal = math.abs(val)
    if absVal < 1000 then return tostring(val) end
    local exp = math.floor(math.log(absVal, 1000))
    exp = math.min(exp, #Suffixes)
    local scaled = val / (1000 ^ exp)
    return string.format("%.2f%s", scaled, Suffixes[exp]):gsub("%.00", "")
end

