-- Teleport Character to Seller's Booth to bypass "You are too far away!" server check
local function TeleportToBooth(sellerUserId, boothData)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    if not hrp then return end

    local function TeleportToPart(interactPart)
        if not interactPart then return false end
        local cf = nil
        if interactPart:IsA("BasePart") then
            cf = interactPart.CFrame
        elseif interactPart:IsA("Model") then
            cf = interactPart:GetPivot()
        end
        if cf then
            -- Teleport directly onto the interact part
            hrp.CFrame = cf + Vector3.new(0, 1, 0)
            pcall(function()
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
            task.wait(0.15) -- Ultra-fast 150ms position sync delay for maximum speed advantage
            return true
        end
        return false
    end

    -- 1. Try boothData.Model or boothData.BoothID
    if boothData and type(boothData) == "table" then
        if boothData.Model and TeleportToPart(boothData.Model:FindFirstChild("Interact") or boothData.Model) then
            return
        end
    end

    -- 2. Try BoothsInteractive via GC or updateAllInteracts
    local boothsInteractive = FindBoothsInteractive()
    if boothData and boothData.BoothID and boothsInteractive[boothData.BoothID] then
        local bModel = boothsInteractive[boothData.BoothID]
        if TeleportToPart(bModel:FindFirstChild("Interact") or bModel) then
            return
        end
    end

    -- Search BoothsInteractive by sellerUserId
    for bId, bModel in pairs(boothsInteractive) do
        if typeof(bModel) == "Instance" and bModel:IsA("Model") then
            local owner = bModel:GetAttribute("Owner") or bModel:GetAttribute("PlayerID")
            if owner == sellerUserId or tostring(owner):find(tostring(sellerUserId)) then
                if TeleportToPart(bModel:FindFirstChild("Interact") or bModel) then
                    return
                end
            end
        end
    end

    -- 3. Search Trading Plaza Workspace for Booth models
    local map = workspace:FindFirstChild("Map") or workspace:FindFirstChild("TradingPlaza") or workspace
    for _, obj in ipairs(map:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name:find("Booth") or obj.Name:find("booth")) then
            local owner = obj:GetAttribute("Owner") or obj:GetAttribute("PlayerID") or obj:GetAttribute("UserId") or obj:GetAttribute("Player")
            if owner == sellerUserId or tostring(owner):find(tostring(sellerUserId)) then
                if TeleportToPart(obj:FindFirstChild("Interact") or obj) then
                    return
                end
            end
        end
    end
end

-- Purchase Execution
local function AttemptPurchase(sellerUserId, itemUID, itemInfo, buyAmount, boothData)
    local cfg = getgenv().SniperConfig
    local remainingLimit = GetRemainingBuyLimit(itemInfo.ID)
    if remainingLimit <= 0 then
        warn(string.format("[SNIPER] Buy limit reached for %s!", itemInfo.ID))
        return false
    end

    buyAmount = math.min(buyAmount, math.floor(remainingLimit))
    if buyAmount <= 0 then return false end

    local totalCost = itemInfo.Cost * buyAmount
    local currentGems = GetPlayerDiamonds()
    
    if currentGems - totalCost < (cfg.MinDiamonds or 0) then
        warn(string.format("[SNIPER] Cannot afford purchase! Gems: %s, Cost: %s", FormatNumber(currentGems), FormatNumber(totalCost)))
        return false
    end

    -- Teleport to seller booth to bypass distance check
    TeleportToBooth(sellerUserId, boothData)

    -- Caller payload matching BoothCmds.lua:590 signature requirements
    local CallerPayload = {
        ["Caller"] = {
            ["LineNumber"] = 532,
            ["ParameterCount"] = 2,
            ["Variadic"] = false,
            ["Traceback"] = "ReplicatedStorage.Library.Client.BoothCmds:532 function PromptPurchase2\nReplicatedStorage.Library.Client.BoothCmds:659 function promptOtherPlayerBooth2\nReplicatedStorage.Library.Client.BoothCmds:998",
            ["ScriptPath"] = "ReplicatedStorage.Library.Client.BoothCmds",
            ["ScriptClass"] = "ModuleScript",
            ["FunctionName"] = "PromptPurchase2",
            ["Handle"] = "function: 0x20f99ee1e6d92aa0",
            ["ScriptType"] = "Instance",
            ["SourceIdentifier"] = "ReplicatedStorage.Library.Client.BoothCmds"
        }
    }

    print(string.format("[SNIPER] 🛒 Attempting to buy x%d %s for %s Gems each from User %s", buyAmount, itemInfo.Display, FormatNumber(itemInfo.Cost), tostring(sellerUserId)))

    local ok, success, errCode = pcall(function()
        return Network.Invoke("Booths_RequestPurchase", sellerUserId, { [itemUID] = buyAmount }, CallerPayload)
    end)

    -- If failed due to distance replication lag, re-teleport and retry once!
    if not (ok and success) and errCode and tostring(errCode):find("far away") then
        warn("[SNIPER] ⚠️ Distance replication lag detected! Re-teleporting and retrying purchase...")
        TeleportToBooth(sellerUserId, boothData)
        task.wait(0.5)
        ok, success, errCode = pcall(function()
            return Network.Invoke("Booths_RequestPurchase", sellerUserId, { [itemUID] = buyAmount }, CallerPayload)
        end)
    end

    if ok and success then
        getgenv().SniperBoughtStats = getgenv().SniperBoughtStats or {}
        getgenv().SniperBoughtStats[itemInfo.ID] = (getgenv().SniperBoughtStats[itemInfo.ID] or 0) + buyAmount

        local rap = itemInfo.RAP or itemInfo.Cost
        local profit = (rap - itemInfo.Cost) * buyAmount
        print(string.format("[SNIPER] ✅ BOUGHT SUCCESS! %s x%d (Total bought: %d)", itemInfo.Display, buyAmount, getgenv().SniperBoughtStats[itemInfo.ID]))
        SendSniperWebhook(itemInfo, buyAmount, itemInfo.Cost, rap, profit)
        return true
    else
        warn(string.format("[SNIPER ❌] Purchase failed or race condition! Reason: %s", tostring(errCode)))
        return false
    end
end

-- Evaluates if an item listing meets sniper criteria
local function ShouldBuyItem(itemInfo)
    local cfg = getgenv().SniperConfig
    local name = itemInfo.ID

    -- Check Buy Limit
    if GetRemainingBuyLimit(name) <= 0 then
        return false, nil
    end

    local cost = itemInfo.Cost
    local rap = itemInfo.RAP or 0
    local percentOff = CalculatePercent(rap, cost)

    -- 1. Fixed Price Rules (Always active if configured)
    if cfg.FixedPrices and cfg.FixedPrices[name] ~= nil then
        local maxPrice = ParseNumber(cfg.FixedPrices[name])
        if maxPrice > 0 and cost <= maxPrice then
            return true, "Fixed Price Match"
        end
    end

    -- 2. Percent Below RAP Rules (Controlled by PercentBelowRAPEnabled master switch)
    if cfg.PercentBelowRAPEnabled ~= false then
        -- Global Category Rules for Huges & Titanics
        if itemInfo.IsHuge and cfg.BuyAllHugesBelowRAP and percentOff >= (cfg.HugeMinPercentOff or 25) then
            return true, "Huge Below RAP"
        end
        if itemInfo.IsTitanic and cfg.BuyAllTitanicsBelowRAP and percentOff >= (cfg.TitanicMinPercentOff or 20) then
            return true, "Titanic Below RAP"
        end

        -- Item-specific Percent RAP Rule
        if cfg.PercentBelowRAP and cfg.PercentBelowRAP[name] ~= nil then
            local targetPercent = cfg.PercentBelowRAP[name]
            if type(targetPercent) == "number" and targetPercent > 0 and percentOff >= targetPercent then
                return true, string.format("Percent Below RAP Match (%d%% off)", targetPercent)
            end
        end

        -- Category-based Percent RAP Rule (e.g. Exclusive)
        if itemInfo.IsExclusive and cfg.PercentBelowRAP and cfg.PercentBelowRAP["Exclusive"] then
            local excPercent = cfg.PercentBelowRAP["Exclusive"]
            if type(excPercent) == "number" and excPercent > 0 and percentOff >= excPercent then
                return true, string.format("Exclusive Below RAP Match (%d%% off)", excPercent)
            end
        end
    end

    return false, nil
end

local function FindGetState()
    local getupvals = debug and debug.getupvalues or getupvalues

    -- 1. Search PlayerScripts running scripts
    if LocalPlayer:FindFirstChild("PlayerScripts") then
        for _, s in ipairs(LocalPlayer.PlayerScripts:GetDescendants()) do
            if s:IsA("LocalScript") then
                local ok, env = pcall(getsenv, s)
                if ok and type(env) == "table" and env.getState and type(env.getState) == "function" then
                    return env.getState, env
                end
            end
        end
    end

    -- 2. ReplicatedStorage BoothCmds module require
    local boothScript = NLibrary.Client:FindFirstChild("BoothCmds") or (LocalPlayer.PlayerScripts.Scripts:FindFirstChild("Game") and LocalPlayer.PlayerScripts.Scripts.Game:FindFirstChild("Trading Plaza") and LocalPlayer.PlayerScripts.Scripts.Game["Trading Plaza"]:FindFirstChild("Booths Frontend"))
    if boothScript then
        local okEnv, env = pcall(getsenv, boothScript)
        if okEnv and type(env) == "table" and env.getState then
            return env.getState, env
        end
        local okReq, mod = pcall(require, boothScript)
        if okReq and type(mod) == "table" and mod.getState then
            return mod.getState, mod
        end
    end

    -- 3. GC Search
    if getgc then
        for _, f in ipairs(getgc(true)) do
            if type(f) == "function" and islclosure and islclosure(f) then
                local info = debug.getinfo(f)
                if info and info.name == "getState" then
                    return f, getfenv and getfenv(f) or {}
                end
            end
        end
    end

    return nil, nil
end

-- Fast & Safe Server Booth Scanner (Zero CPU Lag)
local function ScanServerBooths()
    local getupvals = debug and debug.getupvalues or getupvalues
    local getStateFunc, env = FindGetState()
    if not getStateFunc then return 0 end

    local okUp, upvals = pcall(getupvals, getStateFunc)
    if not okUp or not upvals then return 0 end

    local snipedCount = 0

    for _, upvalTable in ipairs(upvals) do
        if type(upvalTable) == "table" then
            for userKey, boothData in pairs(upvalTable) do
                if type(boothData) == "table" and boothData.Listings then
                    local sellerUserId = nil
                    if typeof(userKey) == "Instance" and userKey:IsA("Player") then
                        sellerUserId = userKey.UserId
                    elseif type(userKey) == "number" then
                        sellerUserId = userKey
                    elseif type(userKey) == "string" then
                        if userKey:find(LocalPlayer.Name) then continue end
                    end

                    if sellerUserId and sellerUserId == LocalPlayer.UserId then
                        continue
                    end

                    if not sellerUserId and type(boothData.Player) == "userdata" and boothData.Player:IsA("Player") then
                        sellerUserId = boothData.Player.UserId
                    end

                    for uid, listingItem in pairs(boothData.Listings) do
                        local rawItem = listingItem.Item
                        if not rawItem then continue end

                        local itemId = (rawItem._data and rawItem._data.id) or (rawItem.GetId and rawItem:GetId()) or "Unknown"
                        local cost = listingItem.DiamondCost or 0
                        if cost <= 0 then continue end

                        local amount = (rawItem._data and rawItem._data._am) or 1
                        local rap = (rawItem.GetDevRAP and rawItem:GetDevRAP()) or (rawItem.GetRAP and rawItem:GetRAP()) or 0

                        local icon = nil
                        if rawItem.GetIcon and type(rawItem.GetIcon) == "function" then
                            pcall(function() icon = rawItem:GetIcon() end)
                        end

                        local itemInfo = {
                            UID = uid,
                            ID = itemId,
                            Cost = cost,
                            Amount = amount,
                            RAP = rap,
                            IsHuge = rawItem.IsHuge and rawItem:IsHuge() or false,
                            IsTitanic = rawItem.IsTitanic and rawItem:IsTitanic() or false,
                            IsExclusive = rawItem.GetRarity and rawItem:GetRarity()._id == "Exclusive" or false,
                            Icon = icon,
                            Rarity = rawItem.GetRarity and rawItem:GetRarity()._id or "Common",
                            Display = itemId
                        }

                        local shouldBuy, reason = ShouldBuyItem(itemInfo)
                        if shouldBuy and sellerUserId then
                            print(string.format("[SNIPER] 🎯 Found Target! [%s] %s @ %s Gems (RAP: %s) - Reason: %s",
                                itemInfo.ID, itemInfo.Display, FormatNumber(itemInfo.Cost), FormatNumber(itemInfo.RAP), reason))

                            local maxAfford = math.floor(GetPlayerDiamonds() / itemInfo.Cost)
                            local buyAmount = math.min(itemInfo.Amount, maxAfford)

                            if buyAmount > 0 then
                                if AttemptPurchase(sellerUserId, uid, itemInfo, buyAmount, boothData) then
                                    snipedCount = snipedCount + 1
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return snipedCount
end

-- Trading Terminal Targeted Server Hop
local function SearchItemOnTerminal(class, searchTable)
    local encodedParts = {}
    for _, k in ipairs({"id", "pt", "sh", "tn"}) do
        local v = searchTable[k]
        if v ~= nil then
            local valStr = type(v) == "string" and ('"' .. v .. '"') or tostring(v)
            table.insert(encodedParts, '"' .. k .. '":' .. valStr)
        end
    end
    local queryStr = "{" .. table.concat(encodedParts, ",") .. "}"

    local ok, res = pcall(function()
        return ReplicatedStorage.Network.TradingTerminal_Search:InvokeServer(class, queryStr, nil, false)
    end)

    if ok and type(res) == "table" and res.place_id and res.job_id then
        return res.place_id, res.job_id
    end
    return nil
end

