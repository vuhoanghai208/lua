-- Key Combine Execution Loop
local function RunCombineLoop()
    while Config.CombineEnabled do
        local counts = GetInventoryKeyCounts()
        local anyCombined = false

        for _, kt in ipairs(KEY_TYPES) do
            if not Config.CombineEnabled then break end
            -- Combine ALL key types có halves, không filter theo SelectedKeys
            local c = counts[kt.name]
            local canCombine = math.min(c.upper, c.lower, Config.CombineBatch)
            if canCombine > 0 then
                for i = 1, canCombine do
                    if not Config.CombineEnabled then break end
                    task.spawn(function()
                        local ok, res = pcall(function()
                            return Network.Invoke(kt.remote, 1)
                        end)
                        if ok and res then
                            Stats.Combined = Stats.Combined + 1
                        else
                            Stats.CombineErrors = Stats.CombineErrors + 1
                        end
                    end)
                end
                anyCombined = true
            end
        end

        local totalFullKeys = 0
        for _, kt in ipairs(KEY_TYPES) do
            local c = counts[kt.name]
            local canCombine = math.min(c.upper, c.lower)
            if keyCombineRows[kt.name] then
                keyCombineRows[kt.name].Text = string.format("Upper: %d | Lower: %d (Can: %d)", c.upper, c.lower, canCombine)
            end
            totalFullKeys = totalFullKeys + c.full
        end

        dashCombine.Text = string.format("%d Keys Combined", Stats.Combined)
        dashInventory.Text = string.format("%d Full Keys Available", totalFullKeys)

        task.wait(Config.CombineDelay)
    end
end

-- Multi-Thread Wheel Burst Loop (uses active key from Config.SelectedKeys)
local function RunFarmLoop()
    Stats.HopStartTime = os.clock()
    Stats.FarmStartTime = os.clock()
    Stats.Spins = 0
    Stats.ConfirmedSpins = 0

    -- Detect active key at farm start
    local initialCounts = GetInventoryKeyCounts()
    local activeKt = GetActiveFarmKey(initialCounts)
    if not activeKt then
        warn("[KEY] RunFarmLoop ABORT — no key available")
        farmStatusLbl.Text = "⛔ No keys available!"
        farmStatusLbl.TextColor3 = C_RED
        Config.FarmEnabled = false
        startFarmBtn.Text = "▶ START BURST FARM"
        startFarmBtn.BackgroundColor3 = Color3.fromRGB(35, 80, 50)
        return
    end
    print(string.format("[KEY] Farm START → %s | wheel=%s | room=%s", activeKt.name, activeKt.wheel, activeKt.room))

    -- Disable 3D Rendering to eliminate GPU load
    pcall(function() RunService:Set3dRenderingEnabled(false) end)

    -- Auto Server Hop / Rejoin Timer Thread
    task.spawn(function()
        while Config.FarmEnabled do
            if Config.AutoHopEnabled then
                local elapsed = os.clock() - Stats.HopStartTime
                local remaining = math.max(0, math.floor(Config.HopInterval - elapsed))
                local actionName = (Config.HopMode == "ServerHop") and "Hop" or "Rejoin"
                farmHopTimerLbl.Text = string.format("%s (%s Active)", FormatTimeDisplay(remaining), actionName)

                if remaining <= 0 then
                    farmHopTimerLbl.Text = string.format("🚀 EXECUTING %s...", string.upper(actionName))
                    farmHopTimerLbl.TextColor3 = C_YELLOW
                    FastServerHop()
                    break
                end
            else
                farmHopTimerLbl.Text = "Disabled"
                farmHopTimerLbl.TextColor3 = C_DIM
            end
            task.wait(1)
        end
    end)

    -- activeKt là upvalue shared giữa worker threads và stats monitor
    -- Chỉ stats monitor (0.5s) mới update, worker chỉ đọc → không scan inventory mỗi burst
    local currentSession = (Stats.FarmSessionId or 0) + 1
    Stats.FarmSessionId = currentSession
    local sharedKt = activeKt  -- khởi tạo từ key đã detect ở đầu

    for threadIdx = 1, Config.ThreadCount do
        task.spawn(function()
            while Config.FarmEnabled and Stats.FarmSessionId == currentSession do
                local kt = sharedKt
                if not kt then
                    task.wait(0.1)
                    continue
                end

                -- High-Speed Parallel RPC Burst Engine (~2.0/s - 2.5/s+)
                task.spawn(function()
                    pcall(function() Network.Invoke("SecretRoom_Unlock", kt.room) end)
                end)

                task.spawn(function()
                    local ok, r = pcall(function()
                        return Network.Invoke("Spinny Wheel: Request Spin", kt.wheel)
                    end)
                    Stats.Spins = Stats.Spins + 1
                    if ok and r then
                        Stats.ConfirmedSpins = Stats.ConfirmedSpins + 1
                    else
                        Stats.FarmErrors = (Stats.FarmErrors or 0) + 1
                    end
                end)

                -- Continuous Instance Reset cho Zero-Delay Burst
                pcall(function() Network.Fire("Instancing_PlayerLeaveInstance", kt.room) end)

                task.wait(Config.BurstDelay)
            end
        end)
    end

    -- Realtime Stats Monitor Loop (0.5s) — chỉ nơi này scan inventory & update sharedKt
    while Config.FarmEnabled and Stats.FarmSessionId == currentSession do
        local countsNow = GetInventoryKeyCounts()

        local currentKt = GetActiveFarmKey(countsNow)
        sharedKt = currentKt  -- update cho worker threads đọc

        local activeKeyCount = 0
        if currentKt then
            local c = countsNow[currentKt.name]
            if c and c.full > 0 then
                activeKeyCount = c.full
            elseif currentKt.ticket then
                for _, tkt in ipairs(KEY_TYPES) do
                    if tkt.full == currentKt.ticket then
                        activeKeyCount = countsNow[tkt.name] and countsNow[tkt.name].full or 0
                        break
                    end
                end
            end
        end
        local activeKeyName  = currentKt and currentKt.name or "None"

        local crystalKeys = countsNow["Crystal"] and countsNow["Crystal"].full or 0
        local secretKeys  = countsNow["Secret"]  and countsNow["Secret"].full  or 0

        local elapsed = os.clock() - Stats.FarmStartTime
        local confirmedPerSec = elapsed > 0 and (Stats.ConfirmedSpins / elapsed) or 0
        local estDay = confirmedPerSec * 86400

        farmStatusLbl.Text = string.format("Farming (%s Wheel)", activeKeyName)
        farmStatusLbl.TextColor3 = C_GREEN

        farmSpinsLbl.Text      = string.format("%d Confirmed | %d Attempts", Stats.ConfirmedSpins, Stats.Spins)
        farmRateLbl.Text       = string.format("%.1f/s | %.0f/min | ~%.0fk/day (real)", confirmedPerSec, confirmedPerSec * 60, estDay / 1000)
        farmKeysLbl.Text       = string.format("%d Crystal Keys", crystalKeys)
        farmSecretKeysLbl.Text = string.format("%d Secret Keys", secretKeys)
        farmUsedLbl.Text       = string.format("Real: %d | Fired: %d | Active: %d %s", Stats.ConfirmedSpins, Stats.Spins, activeKeyCount, activeKeyName)
        farmTimeLbl.Text       = string.format("%dm %ds", math.floor(elapsed / 60), math.floor(elapsed % 60))
        dashSpins.Text         = string.format("%d Confirmed / %d Fired", Stats.ConfirmedSpins, Stats.Spins)

        -- Hết key (hoặc hết ticket) → thử AutoCombine trước khi stop
        if not currentKt then
            if Config.AutoCombineAfterFarm then
                -- Xây danh sách cần combine: ticket key TRƯỚC, rồi mới selected keys
                -- (CKC farm: ticket = Secret Key → cần combine Secret Key halves)
                local combineQueue = {}
                local seen = {}

                -- Bước 1: tìm ticket key của từng selected key có halves
                for _, farmKt in ipairs(KEY_TYPES) do
                    if Config.SelectedKeys[farmKt.name] ~= false and farmKt.ticket then
                        for _, tkt in ipairs(KEY_TYPES) do
                            if tkt.full == farmKt.ticket and not seen[tkt.name] then
                                local c = countsNow[tkt.name]
                                if c and math.min(c.upper, c.lower) > 0 then
                                    table.insert(combineQueue, tkt)
                                    seen[tkt.name] = true
                                end
                            end
                        end
                    end
                end

                -- Bước 2: selected keys có halves (nếu chưa có trong queue)
                for _, kt in ipairs(KEY_TYPES) do
                    if Config.SelectedKeys[kt.name] ~= false and not seen[kt.name] then
                        local c = countsNow[kt.name]
                        if c and math.min(c.upper, c.lower) > 0 then
                            table.insert(combineQueue, kt)
                            seen[kt.name] = true
                        end
                    end
                end

                local combinedAny = #combineQueue > 0
                for _, kt in ipairs(combineQueue) do
                    local c = countsNow[kt.name]
                    local canCombine = math.min(c.upper, c.lower)
                    farmStatusLbl.Text = string.format("Combining %s x%d...", kt.name, canCombine)
                    farmStatusLbl.TextColor3 = C_CYAN
                    print(string.format("[KEY] AutoCombine %s: %d pairs | burst=%d threads", kt.name, canCombine, Config.ThreadCount))

                    -- Bắn ThreadCount luồng song song, mỗi luồng combine 1
                    local i = 0
                    while i < canCombine do
                        local batch = math.min(Config.ThreadCount, canCombine - i)
                        for _ = 1, batch do
                            task.spawn(function()
                                pcall(function() Network.Invoke(kt.remote, 1) end)
                            end)
                        end
                        i = i + batch
                        task.wait(Config.BurstDelay)
                    end
                end

                if combinedAny then
                    task.wait(1.5)  -- đợi server xử lý
                    countsNow = GetInventoryKeyCounts()
                    currentKt = GetActiveFarmKey(countsNow)
                    sharedKt = currentKt
                end
            end

            if not currentKt then
                Config.FarmEnabled = false
                Stats.FarmSessionId = (Stats.FarmSessionId or 0) + 1
                sharedKt = nil
                farmStatusLbl.Text = "⛔ Stopped: No Keys Left!"
                farmStatusLbl.TextColor3 = C_YELLOW
                startFarmBtn.Text = "▶ START BURST FARM"
                startFarmBtn.BackgroundColor3 = Color3.fromRGB(35, 80, 50)
                pcall(function() RunService:Set3dRenderingEnabled(true) end)
                break
            end
        end

        task.wait(0.5)
    end

    pcall(function() RunService:Set3dRenderingEnabled(true) end)
end


