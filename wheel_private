-- Server Hop / Rejoin Function
local isTeleporting = false
local function FastServerHop()
    if isTeleporting then return end
    isTeleporting = true
    Config.FarmEnabled = false
    Config.CombineEnabled = false

    local targetPlace = game.PlaceId -- Use active game PlaceId to prevent Unauthorized errors
    local modeStr = (Config.HopMode == "ServerHop") and "SERVER HOP (NEW SERVER)" or "REJOIN (SAME PLACE)"
    print("🚀 [TOTAL-KEY] EXECUTING " .. modeStr .. " FOR PLACE: " .. tostring(targetPlace))

    pcall(function() RunService:Set3dRenderingEnabled(true) end)
    task.wait(0.5)

    if Config.HopMode == "ServerHop" then
        local ok, _ = pcall(function()
            local req = (syn and syn.request) or (http and http.request) or http_request or request
            if req then
                local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", targetPlace)
                local res = req({ Url = url, Method = "GET" })
                if res and res.Body then
                    local data = HttpService:JSONDecode(res.Body)
                    if data and data.data then
                        local validServers = {}
                        for _, srv in ipairs(data.data) do
                            if srv.playing < srv.maxPlayers and srv.id ~= game.JobId then
                                table.insert(validServers, srv.id)
                            end
                        end
                        if #validServers > 0 then
                            local selectedJobId = validServers[math.random(1, #validServers)]
                            TeleportService:TeleportToPlaceInstance(targetPlace, selectedJobId, lp)
                        end
                    end
                end
            end
            TeleportService:Teleport(targetPlace, lp)
        end)
        if not ok then
            pcall(function() TeleportService:Teleport(targetPlace, lp) end)
        end
    else
        pcall(function() TeleportService:Teleport(targetPlace, lp) end)
    end

    task.delay(5, function()
        isTeleporting = false
        pcall(function() TeleportService:Teleport(targetPlace, lp) end)
    end)
end

