    -- 4. Create Single Smooth Dark Baseplate directly under Player for zero-lag standing
    pcall(function()
        local char = lp.Character or lp.CharacterAdded:Wait()
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
