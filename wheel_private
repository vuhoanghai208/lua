-- Time Helper Functions (Seconds / Minutes / Hours Parsing)
local function ParseTimeToSeconds(str)
    if type(str) == "number" then return math.clamp(math.floor(str), 5, 86400) end
    if type(str) ~= "string" then return 70 end
    local clean = str:lower():gsub("%s+", "")
    local num, unit = clean:match("^([%d%.]+)([smh]?)$")
    if num then
        local val = tonumber(num) or 70
        if unit == "m" then
            val = val * 60
        elseif unit == "h" then
            val = val * 3600
        end
        return math.clamp(math.floor(val), 5, 86400)
    end
    return math.clamp(math.floor(tonumber(clean) or 70), 5, 86400)
end

local function FormatTimeDisplay(seconds)
    seconds = math.max(0, seconds or 0)
    if seconds >= 3600 then
        local h = seconds / 3600
        return (h % 1 == 0) and string.format("%dh", h) or string.format("%.1fh", h)
    elseif seconds >= 60 then
        local m = seconds / 60
        return (m % 1 == 0) and string.format("%dm", m) or string.format("%.1fm", m)
    else
        return string.format("%ds", seconds)
    end
end

