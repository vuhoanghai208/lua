-- Scanner Helper for Inventory Key Counts
local function GetInventoryKeyCounts()
    local counts = {}
    for _, kt in ipairs(KEY_TYPES) do
        counts[kt.name] = { upper = 0, lower = 0, full = 0 }
    end

    local ok, err = pcall(function()
        if not reqSave then reqSave = require(ReplicatedStorage.Library.Client.Save) end
        local data = reqSave.Get(lp) or reqSave.Get()
        if not data then
            warn("[KEY] reqSave.Get() = nil — save not ready")
            return
        end
        if not data.Inventory then
            warn("[KEY] data.Inventory = nil")
            return
        end
        local function scan(obj)
            if type(obj) ~= "table" then return end
            for _, v in pairs(obj) do
                if type(v) == "table" then
                    local id = v.id
                    local amount = v.am or v._am or 1
                    if id then
                        for _, kt in ipairs(KEY_TYPES) do
                            if id == kt.upper then
                                counts[kt.name].upper = counts[kt.name].upper + amount
                            elseif id == kt.lower then
                                counts[kt.name].lower = counts[kt.name].lower + amount
                            elseif id == kt.full then
                                counts[kt.name].full = counts[kt.name].full + amount
                            end
                        end
                    end
                    scan(v)
                end
            end
        end
        scan(data.Inventory)
    end)
    if not ok then
        warn("[KEY] GetInventoryKeyCounts error: " .. tostring(err))
    end
    return counts
end

-- Dynamic Active Key Finder
-- Nếu kt có `ticket`, phải có ticket đó trong inventory mới được chọn
local _lastActiveName = nil
local function GetActiveFarmKey(counts)
    if not counts then counts = GetInventoryKeyCounts() end
    for _, kt in ipairs(KEY_TYPES) do
        if Config.SelectedKeys[kt.name] ~= false then
            local c = counts[kt.name] or { upper = 0, lower = 0, full = 0 }
            
            -- Check ticket count if wheel uses a ticket (e.g. Secret Key for Crystal Wheel)
            local ticketCount = 0
            if kt.ticket then
                for _, tkt in ipairs(KEY_TYPES) do
                    if tkt.full == kt.ticket then
                        local tc = counts[tkt.name]
                        ticketCount = tc and tc.full or 0
                        break
                    end
                end
            end

            -- Có thể farm nếu có Full Key, hoặc có Halves ghép được, hoặc có Ticket Key (Secret Key)
            local hasKey = (c.full > 0) or (math.min(c.upper, c.lower) > 0) or (ticketCount > 0)

            if hasKey then
                if _lastActiveName ~= kt.name then
                    _lastActiveName = kt.name
                    local ticketInfo = kt.ticket and string.format(" | ticket=%s(%d)", kt.ticket, ticketCount) or ""
                    print(string.format("[KEY] Active → %s (F:%d U:%d L:%d%s)",
                        kt.name, c.full, c.upper, c.lower, ticketInfo))
                end
                return kt
            end
        end
    end
    if _lastActiveName ~= nil then
        warn("[KEY] No usable key found — all selected keys exhausted")
        _lastActiveName = nil
    end
    return nil
end

