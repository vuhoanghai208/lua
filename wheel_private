                plate.Parent = workspace
            else
                plate.Position = hrp.Position - Vector3.new(0, 3, 0)
            end
        end
    end)

    pcall(function() collectgarbage("collect") end)
    print("🚀 [SAFE VOID MODE] Successfully wiped " .. tostring(count) .. " map objects! Clean console & zero 3D lag.")
