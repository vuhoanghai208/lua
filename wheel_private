    pcall(function()
        local Lighting = game:GetService("Lighting")
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 0
        for _, child in ipairs(Lighting:GetChildren()) do
            if child:IsA("PostEffect") or child:IsA("Atmosphere") or child:IsA("Sky") or child:IsA("BloomEffect") or child:IsA("BlurEffect") then
                pcall(function() child:Destroy(); count = count + 1 end)
            end
        end
    end)

    -- 3. Wipe Map 3D Mesh Clutter (Safely protects Pets, __THINGS, Debris from PetRendering errors)
    pcall(function()
        local safeBlacklist = {
            ["Camera"] = true,
            ["Terrain"] = true,
            ["Pets"] = true,
            ["__THINGS"] = true,
            ["__DEBRIS"] = true,
            ["Debris"] = true,
            ["VHH_VoidPlate"] = true
        }

        for _, item in ipairs(workspace:GetChildren()) do
            if not safeBlacklist[item.Name] and item ~= workspace.CurrentCamera and not Players:GetPlayerFromCharacter(item) and item ~= lp.Character then
                pcall(function()
                    item:Destroy()
                    count = count + 1
                end)
            end
        end
    end)

    -- 3.5. Potato Mode (Xóa Textures, Decals, Particles & Tắt Shadows cho các Object còn lại)
    pcall(function()
        for _, desc in ipairs(workspace:GetDescendants()) do
            if desc:IsA("BasePart") then
                desc.CastShadow = false
                desc.Material = Enum.Material.SmoothPlastic
            elseif desc:IsA("Decal") or desc:IsA("Texture") then
                desc:Destroy()
            elseif desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Beam") or desc:IsA("Fire") or desc:IsA("Smoke") or desc:IsA("Sparkles") then
                desc.Enabled = false
